+            .unwrap()
+            .unwrap();
+    restore(&b, &keys).await.unwrap();
+    assert!(a.encryption().try_lock_store_once().await.unwrap().is_none());
+    drop(guard_b);
+    // The old A machine's store is stale here. Maintenance must use a new
+    // bound machine before any write to the persisted generation counter.
+    let guard_a2 =
+        tokio::time::timeout(Duration::from_secs(5), a.encryption().spin_lock_store(Some(1000)))
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+    let reentrant = a.encryption().try_lock_store_once().await.unwrap().unwrap();
+    assert!(surviving_keys(temp.path()).await == Some(keys));
+    assert_eq!(server.received_requests().await.unwrap().len(), 0);
+    drop(reentrant);
+    drop(guard_a2);
+    a.pause().await.unwrap();
+    b.pause().await.unwrap();
+}
diff --git a/crates/matrix-sdk/tests/atum_live_lease.rs b/crates/matrix-sdk/tests/atum_live_lease.rs
new file mode 100644
--- /dev/null
+++ b/crates/matrix-sdk/tests/atum_live_lease.rs
@@ -0,0 +1,146 @@
+// Atum live BaseClient lease regressions. Disposable encrypted stores only.
+// SPDX-License-Identifier: Apache-2.0
+#![cfg(all(feature = "e2e-encryption", feature = "sqlite"))]
+
+use matrix_sdk_base::{
+    BaseClient, DmRoomDefinition, SessionMeta, ThreadingSupport,
+    cross_process_lock::{CrossProcessLock, CrossProcessLockConfig},
+    crypto::{
+        DecryptionSettings, EncryptionSyncChanges, OlmMachine, TrustRequirement,
+        store::{CryptoStore, LockableCryptoStore},
+    },
+    store::{RoomLoadSettings, StoreConfig},
+};
+use matrix_sdk_sqlite::SqliteCryptoStore;
+use ruma::{device_id, user_id};
+use std::time::Duration;
+use tempfile::TempDir;
+
+fn meta() -> SessionMeta {
+    SessionMeta {
+        user_id: user_id!("@synthetic:atum.invalid").to_owned(),
+        device_id: device_id!("LIVE").to_owned(),
+    }
+}
+
+fn base(
+    store: &SqliteCryptoStore,
+    holder: &str,
+) -> (BaseClient, CrossProcessLock<LockableCryptoStore>) {
+    let config = CrossProcessLockConfig::multi_process(holder);
+    let base = BaseClient::new(
+        StoreConfig::new(config.clone()).crypto_store(store.clone()),
+        ThreadingSupport::Disabled,
+        DmRoomDefinition::default(),
+    );
+    let lock = base.create_crypto_store_lock(config).unwrap();
+    (base, lock)
+}
+
+async fn machine(base: &BaseClient) -> OlmMachine {
+    base.olm_machine().await.as_ref().unwrap().clone()
+}
+
+async fn sync(machine: &OlmMachine, batch: &str) -> Result<(), matrix_sdk_base::crypto::OlmError> {
+    machine
+        .receive_sync_changes(
+            EncryptionSyncChanges {
+                to_device_events: vec![],
+                changed_devices: &Default::default(),
+                one_time_keys_counts: &Default::default(),
+                unused_fallback_keys: None,
+                next_batch_token: Some(batch.into()),
+            },
+            &DecryptionSettings { sender_device_trust_requirement: TrustRequirement::Untrusted },
+        )
+        .await
+        .map(|_| ())
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn activation_and_live_a_b_a_keep_retained_machines_fenced() {
+    let dir = TempDir::new().unwrap();
+    let store_a = SqliteCryptoStore::open(dir.path(), Some("synthetic-live-lease")).await.unwrap();
+    let (a, lock_a) = base(&store_a, "A");
+    let guard_a = lock_a.try_lock_once().await.unwrap().unwrap().into_guard();
+    a.activate(meta(), RoomLoadSettings::All, None).await.unwrap();
+    let original = machine(&a).await;
+    let keys = original.identity_keys();
+    sync(&original, "A").await.unwrap();
+    assert!(
+        !a.bind_olm_to_lease(&guard_a).await.unwrap(),
+        "reentrant acquisition must preserve current machine"
+    );
+    let child = a
+        .clone_with_in_memory_state_store(CrossProcessLockConfig::SingleProcess, false)
+        .await
+        .unwrap();
+    assert!(!child.bind_olm_to_lease(&guard_a).await.unwrap());
+    assert!(
+        a.create_crypto_store_lock(CrossProcessLockConfig::multi_process("different-holder"))
+            .is_err()
+    );
+    drop(guard_a);
+
+    let store_b = SqliteCryptoStore::open(dir.path(), Some("synthetic-live-lease")).await.unwrap();
+    let (b, lock_b) = base(&store_b, "B");
+    let guard_b = tokio::time::timeout(Duration::from_secs(5), lock_b.spin_lock(Some(1000)))
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap()
+        .into_guard();
+    b.activate(meta(), RoomLoadSettings::All, None).await.unwrap();
+    let middle = machine(&b).await;
+    assert_eq!(middle.identity_keys(), keys);
+    sync(&middle, "B").await.unwrap();
+    assert!(
+        sync(&original, "stale-A").await.is_err(),
+        "retained live machine must reject after handoff"
+    );
+    assert!(original.store().set_custom_value("stale", vec![1]).await.is_err());
+    assert!(a.bind_olm_to_lease(&guard_b).await.is_err());
+    assert!(
+        a.regenerate_olm(None).await.is_err(),
+        "busy regeneration must not write through raw store"
+    );
+    assert_eq!(store_a.next_batch_token().await.unwrap().as_deref(), Some("B"));
+    drop(guard_b);
+
+    let guard_a2 = tokio::time::timeout(Duration::from_secs(5), lock_a.spin_lock(Some(1000)))
+        .await
+        .unwrap()
+        .unwrap()
+        .unwrap()
+        .into_guard();
+    assert!(a.bind_olm_to_lease(&guard_a2).await.unwrap());
+    assert!(
+        !child.bind_olm_to_lease(&guard_a2).await.unwrap(),
+        "in-process child shares the replacement"
+    );
+    let current = machine(&a).await;
+    assert_eq!(current.identity_keys(), keys);
+    assert!(sync(&original, "old-A-even-after-A-returns").await.is_err());
+    assert!(sync(&middle, "old-B").await.is_err());
+    sync(&current, "A2").await.unwrap();
+    assert_eq!(store_b.next_batch_token().await.unwrap().as_deref(), Some("A2"));
+    assert!(store_a.get_custom_value("stale").await.unwrap().is_none());
+    assert_eq!(store_a.load_account().await.unwrap().unwrap().identity_keys(), keys);
+    drop(guard_a2);
+}
+
+#[tokio::test]
+async fn activated_raw_sqlite_client_cannot_upgrade_and_leave_raw_clones() {
+    let dir = TempDir::new().unwrap();
+    let store = SqliteCryptoStore::open(dir.path(), Some("synthetic-live-lease")).await.unwrap();
+    let client = BaseClient::new(
+        StoreConfig::new(CrossProcessLockConfig::SingleProcess).crypto_store(store),
+        ThreadingSupport::Disabled,
+        DmRoomDefinition::default(),
+    );
+    client.activate(meta(), RoomLoadSettings::All, None).await.unwrap();
+    assert!(
+        client.create_crypto_store_lock(CrossProcessLockConfig::multi_process("late")).is_err(),
+        "existing raw machines cannot be retroactively fenced"
+    );
+}
