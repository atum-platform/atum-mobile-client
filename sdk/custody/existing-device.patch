@@ -0,0 +1,385 @@
+// Atum existing-device restoration regression tests. Synthetic data only.
+// SPDX-License-Identifier: Apache-2.0
+#![cfg(all(feature = "e2e-encryption", feature = "sqlite"))]
+
+use std::{
+    path::Path,
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::Duration,
+};
+
+use matrix_sdk::{
+    Client, Error, SessionMeta, SessionTokens,
+    authentication::oauth::{OAuthError, OAuthSession, UserSession},
+    config::RequestConfig,
+    cross_process_lock::CrossProcessLockConfig,
+    encryption::CryptoStoreError,
+    store::RoomLoadSettings,
+};
+use matrix_sdk_base::{
+    BaseClient, DmRoomDefinition, ThreadingSupport,
+    crypto::{OlmMachineBuilder, store::CryptoStore},
+    store::StoreConfig,
+};
+use matrix_sdk_sqlite::SqliteCryptoStore;
+use oauth2::ClientId;
+use ruma::{api::MatrixVersion, device_id, user_id};
+use tempfile::TempDir;
+use wiremock::MockServer;
+
+const PASSPHRASE: &str = "atum-disposable-test-store-passphrase";
+
+fn session() -> OAuthSession {
+    OAuthSession {
+        client_id: ClientId::new("atum-disposable-test-client".into()),
+        user: UserSession {
+            meta: SessionMeta {
+                user_id: user_id!("@synthetic:atum.invalid").to_owned(),
+                device_id: device_id!("SYNTHETIC").to_owned(),
+            },
+            tokens: SessionTokens {
+                access_token: "not-an-access-token".into(),
+                refresh_token: Some("not-a-refresh-token".into()),
+            },
+        },
+    }
+}
+
+async fn seed(path: &Path) -> (String, String) {
+    let store = SqliteCryptoStore::open(path, Some(PASSPHRASE)).await.unwrap();
+    let meta = session().user.meta;
+    let machine = OlmMachineBuilder::new(&meta.user_id, &meta.device_id)
+        .with_crypto_store(store.clone())
+        .build()
+        .await
+        .unwrap();
+    let keys = machine.identity_keys();
+    let expected = (keys.curve25519.to_base64(), keys.ed25519.to_base64());
+    drop(machine);
+    store.close().await.unwrap();
+    expected
+}
+
+async fn client(path: &Path, server: &MockServer, holder: &str) -> Client {
+    Client::builder()
+        .homeserver_url(server.uri())
+        .disable_well_known_lookup(true)
+        .server_versions([MatrixVersion::V1_12])
+        .request_config(RequestConfig::new().disable_retry())
+        .sqlite_store(path, Some(PASSPHRASE))
+        .cross_process_store_config(CrossProcessLockConfig::multi_process(holder))
+        .build()
+        .await
+        .unwrap()
+}
+
+async fn surviving_keys(path: &Path) -> Option<(String, String)> {
+    let store = SqliteCryptoStore::open(path, Some(PASSPHRASE)).await.unwrap();
+    let account = store.load_account().await.unwrap();
+    let keys = account
+        .map(|a| (a.identity_keys().curve25519.to_base64(), a.identity_keys().ed25519.to_base64()));
+    store.close().await.unwrap();
+    keys
+}
+
+async fn restore(client: &Client, keys: &(String, String)) -> matrix_sdk::Result<()> {
+    client
+        .restore_session_existing(session(), RoomLoadSettings::All, keys.0.clone(), keys.1.clone())
+        .await
+}
+
+fn remove_synthetic_account(path: &Path) {
+    // Only the fresh TempDir owned by this test reaches here. Product code
+    // does not inspect SQL, remove rows, or repair a surviving database.
+    let database = path.join("matrix-sdk-crypto.sqlite3");
+    assert!(database.metadata().unwrap().len() > 0);
+    let connection = rusqlite::Connection::open(database).unwrap();
+    assert_eq!(connection.execute("DELETE FROM kv WHERE key = 'account'", []).unwrap(), 1);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn existing_identity_reopens_without_initialization_traffic() {
+    let temp = TempDir::new().unwrap();
+    let server = MockServer::start().await;
+    let keys = seed(temp.path()).await;
+    for holder in ["first", "relaunch"] {
+        let client = client(temp.path(), &server, holder).await;
+        restore(&client, &keys).await.unwrap();
+        assert!(client.user_id() == Some(&session().user.meta.user_id));
+        assert!(client.device_id() == Some(&session().user.meta.device_id));
+        assert!(client.session_tokens() == Some(session().user.tokens));
+        // Initialization schedules HTTP requests even with auto-* false on
+        // the original API. This deferred API must schedule none.
+        tokio::time::sleep(Duration::from_millis(200)).await;
+        assert_eq!(server.received_requests().await.unwrap().len(), 0);
+        client.pause().await.unwrap();
+        assert!(surviving_keys(temp.path()).await == Some(keys.clone()));
+        // The SDK lease expires naturally after its guard is released.
+        tokio::time::sleep(Duration::from_millis(750)).await;
+    }
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn missing_internal_account_is_refused_without_replacement() {
+    let temp = TempDir::new().unwrap();
+    let server = MockServer::start().await;
+    let keys = seed(temp.path()).await;
+    remove_synthetic_account(temp.path());
+    for holder in ["missing-first", "missing-retry"] {
+        let client = client(temp.path(), &server, holder).await;
+        assert!(matches!(restore(&client, &keys).await,
+            Err(Error::CryptoStoreError(e)) if matches!(*e, CryptoStoreError::AccountUnset)));
+        assert!(client.session_tokens().is_none());
+        assert!(client.user_id().is_none());
+        client.pause().await.unwrap();
+        assert!(surviving_keys(temp.path()).await.is_none());
+        assert!(temp.path().join("matrix-sdk-crypto.sqlite3").metadata().unwrap().len() > 0);
+        tokio::time::sleep(Duration::from_millis(750)).await;
+    }
+    assert_eq!(server.received_requests().await.unwrap().len(), 0);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn wrong_keys_user_or_device_preserve_original_identity() {
+    let temp = TempDir::new().unwrap();
+    let server = MockServer::start().await;
+    let keys = seed(temp.path()).await;
+    for (index, wrong) in [0, 1, 2, 3].into_iter().enumerate() {
+        let client = client(temp.path(), &server, &format!("mismatch-{index}")).await;
+        let mut candidate = session();
+        let mut candidate_keys = keys.clone();
+        match wrong {
+            0 => candidate_keys.0 = "wrong-curve-key".into(),
+            1 => candidate_keys.1 = "wrong-ed-key".into(),
+            2 => candidate.user.meta.user_id = user_id!("@other:atum.invalid").to_owned(),
+            _ => candidate.user.meta.device_id = device_id!("OTHER").to_owned(),
+        }
+        let result = client
+            .restore_session_existing(
+                candidate,
+                RoomLoadSettings::All,
+                candidate_keys.0,
+                candidate_keys.1,
+            )
+            .await;
+        assert!(matches!(result, Err(Error::CryptoStoreError(e)) if matches!(*e,
+            CryptoStoreError::StoredIdentityMismatch | CryptoStoreError::MismatchedAccount { .. })));
+        assert!(client.session_tokens().is_none());
+        client.pause().await.unwrap();
+        assert!(surviving_keys(temp.path()).await == Some(keys.clone()));
+        tokio::time::sleep(Duration::from_millis(750)).await;
+    }
+    assert_eq!(server.received_requests().await.unwrap().len(), 0);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn wrong_passphrase_refuses_open_and_preserves_identity() {
+    let temp = TempDir::new().unwrap();
+    let server = MockServer::start().await;
+    let keys = seed(temp.path()).await;
+    let result = Client::builder()
+        .homeserver_url(server.uri())
+        .sqlite_store(temp.path(), Some("wrong-synthetic-passphrase"))
+        .build()
+        .await;
+    assert!(result.is_err());
+    assert!(surviving_keys(temp.path()).await == Some(keys));
+    assert_eq!(server.received_requests().await.unwrap().len(), 0);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn existing_restore_obeys_the_same_sdk_crypto_store_lease() {
+    let temp = TempDir::new().unwrap();
+    let server = MockServer::start().await;
+    let keys = seed(temp.path()).await;
+    let first = client(temp.path(), &server, "lease-holder").await;
+    // Construct the independent reader before holding the 500 ms SDK lease.
+    // Client construction is outside this test's assertion and can take more
+    // than one lease interval on a contended hosted runner.
+    let second = client(temp.path(), &server, "lease-contender").await;
+    first.encryption().enable_cross_process_store_lock("lease-holder".into()).await.unwrap();
+    let guard = first.encryption().try_lock_store_once().await.unwrap().unwrap();
+    assert!(matches!(restore(&second, &keys).await, Err(Error::CrossProcessLockError(_))));
+    assert!(second.session_tokens().is_none());
+    second.pause().await.unwrap();
+    assert!(surviving_keys(temp.path()).await == Some(keys.clone()));
+    drop(guard);
+    first.pause().await.unwrap();
+    tokio::time::sleep(Duration::from_millis(750)).await;
+    let fresh = client(temp.path(), &server, "after-release").await;
+    restore(&fresh, &keys).await.unwrap();
+    fresh.pause().await.unwrap();
+    assert!(surviving_keys(temp.path()).await == Some(keys));
+    assert_eq!(server.received_requests().await.unwrap().len(), 0);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn later_regeneration_cannot_recreate_a_missing_identity() {
+    let temp = TempDir::new().unwrap();
+    let server = MockServer::start().await;
+    let keys = seed(temp.path()).await;
+    let store = SqliteCryptoStore::open(temp.path(), Some(PASSPHRASE)).await.unwrap();
+    let meta = session().user.meta;
+    let config = CrossProcessLockConfig::multi_process("regeneration-holder");
+    let base = BaseClient::new(
+        StoreConfig::new(config.clone()).crypto_store(store.clone()),
+        ThreadingSupport::Disabled,
+        DmRoomDefinition::default(),
+    );
+    let lock = base.create_crypto_store_lock(config);
+    let guard = lock.try_lock_once().await.unwrap().unwrap();
+    base.require_existing_identity(&meta, keys.0, keys.1).await.unwrap();
+    base.activate(meta, RoomLoadSettings::All, None).await.unwrap();
+    drop(guard);
+    base.close_stores().await.unwrap();
+    remove_synthetic_account(temp.path());
+    base.reopen_stores().await.unwrap();
+    let guard = lock.try_lock_once().await.unwrap().unwrap();
+    assert!(base.regenerate_olm(None).await.is_err());
+    assert!(store.load_account().await.unwrap().is_none());
+    drop(guard);
+    base.close_stores().await.unwrap();
+    assert_eq!(server.received_requests().await.unwrap().len(), 0);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn corrupt_store_is_refused_without_repair() {
+    let temp = TempDir::new().unwrap();
+    let server = MockServer::start().await;
+    seed(temp.path()).await;
+    let database = temp.path().join("matrix-sdk-crypto.sqlite3");
+    let corrupted = b"synthetic-corrupt-store";
+    std::fs::write(&database, corrupted).unwrap();
+    let result = Client::builder()
+        .homeserver_url(server.uri())
+        .sqlite_store(temp.path(), Some(PASSPHRASE))
+        .build()
+        .await;
+    assert!(result.is_err());
+    assert_eq!(std::fs::read(database).unwrap(), corrupted);
+    assert_eq!(server.received_requests().await.unwrap().len(), 0);
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn automatic_refresh_and_authenticated_client_are_refused() {
+    let temp = TempDir::new().unwrap();
+    let server = MockServer::start().await;
+    let keys = seed(temp.path()).await;
+    let automatic = Client::builder()
+        .homeserver_url(server.uri())
+        .sqlite_store(temp.path(), Some(PASSPHRASE))
+        .handle_refresh_tokens()
+        .cross_process_store_config(CrossProcessLockConfig::multi_process("automatic"))
+        .build()
+        .await
+        .unwrap();
+    assert!(matches!(restore(&automatic, &keys).await, Err(Error::BadCryptoStoreState)));
+    assert!(automatic.session_tokens().is_none());
+    automatic.pause().await.unwrap();
+    let fresh = client(temp.path(), &server, "fresh").await;
+    restore(&fresh, &keys).await.unwrap();
+    assert!(matches!(restore(&fresh, &keys).await, Err(Error::BadCryptoStoreState)));
+    fresh.pause().await.unwrap();
+    assert!(surviving_keys(temp.path()).await == Some(keys));
+    assert_eq!(server.received_requests().await.unwrap().len(), 0);
+}
+
+async fn token_reader(
+    path: &Path,
+    server: &MockServer,
+    holder: &str,
+    current: SessionTokens,
+    unavailable: bool,
+) -> (Client, Arc<AtomicUsize>, Arc<AtomicUsize>) {
+    let client = client(path, server, holder).await;
+    client.oauth().enable_cross_process_refresh_lock(holder.to_owned()).await.unwrap();
+    let reads = Arc::new(AtomicUsize::new(0));
+    let saves = Arc::new(AtomicUsize::new(0));
+    let read_count = reads.clone();
+    let save_count = saves.clone();
+    client
+        .set_session_callbacks(
+            Box::new(move |_| {
+                read_count.fetch_add(1, Ordering::SeqCst);
+                if unavailable {
+                    Err(std::io::Error::other("synthetic-private-callback-error-detail").into())
+                } else {
+                    Ok(current.clone())
+                }
+            }),
+            Box::new(move |_| {
+                save_count.fetch_add(1, Ordering::SeqCst);
+                Ok(())
+            }),
+        )
+        .unwrap();
+    (client, reads, saves)
+}
+
+#[tokio::test(flavor = "multi_thread")]
+async fn unavailable_authoritative_tokens_refuse_strict_restore_and_preserve_latest() {
+    let temp = TempDir::new().unwrap();
+    let server = MockServer::start().await;
+    let keys = seed(temp.path()).await;
+    let original = session();
+    let mut latest = original.clone();
+    latest.user.tokens.access_token = "not-a-new-access-token".into();
+    latest.user.tokens.refresh_token = Some("not-a-new-refresh-token".into());
+
+    let (first, reads, saves) =
+        token_reader(temp.path(), &server, "token-first", original.user.tokens.clone(), false)
+            .await;
+    restore(&first, &keys).await.unwrap();
+    assert_eq!(reads.load(Ordering::SeqCst), 0);
+    assert_eq!(saves.load(Ordering::SeqCst), 0);
+    first.pause().await.unwrap();
+    tokio::time::sleep(Duration::from_millis(750)).await;
+
+    let (replacement, reads, saves) =
+        token_reader(temp.path(), &server, "token-replacement", latest.user.tokens.clone(), false)
+            .await;
+    replacement
+        .restore_session_existing(
+            latest.clone(),
+            RoomLoadSettings::All,
+            keys.0.clone(),
+            keys.1.clone(),
+        )
+        .await
+        .unwrap();
+    assert!(replacement.session_tokens() == Some(latest.user.tokens.clone()));
+    assert_eq!(reads.load(Ordering::SeqCst), 1);
+    assert_eq!(saves.load(Ordering::SeqCst), 0);
+    replacement.pause().await.unwrap();
+    tokio::time::sleep(Duration::from_millis(750)).await;
+
+    let (unavailable, reads, saves) =
+        token_reader(temp.path(), &server, "token-unavailable", latest.user.tokens.clone(), true)
+            .await;
+    let error = restore(&unavailable, &keys)
+        .await
+        .expect_err("Unavailable authority must refuse strict restore");
+    assert!(!error.to_string().contains("synthetic-private-callback-error-detail"));
+    assert!(error.to_string().contains("authoritative current session is unavailable"));
+    assert!(matches!(error, Error::OAuth(error) if matches!(*error, OAuthError::LockError(_))));
+    assert_eq!(reads.load(Ordering::SeqCst), 1);
+    assert_eq!(saves.load(Ordering::SeqCst), 0);
+    unavailable.pause().await.unwrap();
+    assert!(surviving_keys(temp.path()).await == Some(keys.clone()));
+    tokio::time::sleep(Duration::from_millis(750)).await;
+
+    // A failed stale read must not clobber the stored latest-token hash: a new
+    // reader starting from the original input still reloads the latest tokens.
+    let (fresh, reads, saves) =
+        token_reader(temp.path(), &server, "token-fresh", latest.user.tokens.clone(), false).await;
+    restore(&fresh, &keys).await.unwrap();
+    assert!(fresh.session_tokens() == Some(latest.user.tokens));
+    assert_eq!(reads.load(Ordering::SeqCst), 1);
+    assert_eq!(saves.load(Ordering::SeqCst), 0);
+    fresh.pause().await.unwrap();
+    assert!(surviving_keys(temp.path()).await == Some(keys));
+    assert_eq!(server.received_requests().await.unwrap().len(), 0);
+}
