+/// Atum's offline first-use input. This record contains a private root key.
+/// Persist/read back in main-private device-only Keychain before remote writes.
+/// It supplies no authority to publish, replace a default, or create a backup.
+/// Do not log it; the caller owns all exported string copies.
+#[derive(Clone, uniffi::Record)]
+pub struct PreparedRecoveryKey {
+    pub recovery_key: String,
+    pub key_id: String,
+    pub metadata_json: String,
+}
+
+#[derive(Debug, Error, uniffi::Error)]
+pub enum PreparedRecoveryKeyError {
+    #[error("Invalid prepared recovery input")]
+    InvalidInput,
+}
+
+/// No client, store, runtime, lease or network is used by this function.
+#[uniffi::export]
+pub fn prepare_recovery_key() -> Result<PreparedRecoveryKey, PreparedRecoveryKeyError> {
+    use matrix_sdk_base::crypto::secret_storage::SecretStorageKey;
+    let key = SecretStorageKey::new();
+    let metadata_json = serde_json::to_value(key.event_content())
+        .map_err(|_| PreparedRecoveryKeyError::InvalidInput)?
+        .to_string();
+    Ok(PreparedRecoveryKey {
+        recovery_key: key.to_base58(),
+        key_id: key.key_id().to_owned(),
+        metadata_json,
+    })
+}
+
+/// Checks only a locally prepared triple. Does not inspect published state.
+#[uniffi::export]
+pub fn validate_prepared_recovery_key(
+    mut input: PreparedRecoveryKey,
+) -> Result<(), PreparedRecoveryKeyError> {
+    let result = validate_prepared_recovery_key_inner(&input);
+    input.recovery_key.zeroize();
+    result
+}
+
+fn validate_prepared_recovery_key_inner(
+    input: &PreparedRecoveryKey,
+) -> Result<(), PreparedRecoveryKeyError> {
+    use matrix_sdk_base::crypto::secret_storage::SecretStorageKey;
+    use ruma::{
+        events::secret_storage::key::{
+            SecretStorageEncryptionAlgorithm, SecretStorageKeyEventContent,
+            SecretStorageV1AesHmacSha2Properties,
+        },
+        serde::Base64,
+    };
+
+    #[derive(serde::Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Metadata {
+        algorithm: String,
+        iv: Base64,
+        mac: Base64,
+    }
+
+    let invalid = || PreparedRecoveryKeyError::InvalidInput;
+    if input.key_id.len() != 32 || !input.key_id.bytes().all(|b| b.is_ascii_alphanumeric())
+        || input.recovery_key.len() > 128 || input.metadata_json.len() > 1024
+    {
+        return Err(invalid());
+    }
+    // Upstream accepts absent IV/MAC by design. Prepared first-use input must
+    // require both so from_account_data actually checks possession of this key.
+    let metadata: Metadata = serde_json::from_str(&input.metadata_json).map_err(|_| invalid())?;
+    if metadata.algorithm != "m.secret_storage.v1.aes-hmac-sha2"
+        || metadata.iv.as_bytes().len() != 16 || metadata.mac.as_bytes().len() != 32
+    {
+        return Err(invalid());
+    }
+    // Ruma omits key_id from content JSON: it belongs in the event-type suffix.
+    let content = SecretStorageKeyEventContent::new(
+        input.key_id.clone(),
+        SecretStorageEncryptionAlgorithm::V1AesHmacSha2(
+            SecretStorageV1AesHmacSha2Properties::new(Some(metadata.iv), Some(metadata.mac)),
+        ),
+    );
+    let canonical = serde_json::to_value(&content).map_err(|_| invalid())?.to_string();
+    if canonical != input.metadata_json { return Err(invalid()); }
+    let key = SecretStorageKey::from_account_data(&input.recovery_key, content)
+        .map_err(|_| invalid())?;
+    let mut encoded = key.to_base58();
+    let matches = encoded == input.recovery_key && key.key_id() == input.key_id;
+    encoded.zeroize();
+    if matches { Ok(()) } else { Err(invalid()) }
+}
+
+#[cfg(test)]
+mod atum_recovery_prepared_tests {
+    use super::{prepare_recovery_key, validate_prepared_recovery_key};
+
+    #[test]
+    fn exact_offline_input_roundtrips_and_foreign_keys_refuse() {
+        let original = prepare_recovery_key().unwrap();
+        assert!(validate_prepared_recovery_key(original.clone()).is_ok());
+        let mut foreign = original.clone();
+        foreign.recovery_key = prepare_recovery_key().unwrap().recovery_key;
+        assert!(validate_prepared_recovery_key(foreign).is_err());
+        let mut corrupt = original;
+        corrupt.recovery_key = "not-a-recovery-key".to_owned();
+        assert!(validate_prepared_recovery_key(corrupt).is_err());
+    }
+
+    #[test]
+    fn incomplete_or_altered_metadata_never_skips_the_mac_check() {
+        let original = prepare_recovery_key().unwrap();
+        for field in ["iv", "mac"] {
+            let mut changed = original.clone();
+            let mut metadata: serde_json::Value = serde_json::from_str(&changed.metadata_json).unwrap();
+            metadata.as_object_mut().unwrap().remove(field);
+            changed.metadata_json = metadata.to_string();
+            assert!(validate_prepared_recovery_key(changed).is_err());
+        }
+        for field in ["passphrase", "name", "key_id", "unexpected"] {
+            let mut changed = original.clone();
+            let mut metadata: serde_json::Value = serde_json::from_str(&changed.metadata_json).unwrap();
+            metadata[field] = serde_json::Value::String("unexpected".to_owned());
+            changed.metadata_json = metadata.to_string();
+            assert!(validate_prepared_recovery_key(changed).is_err());
+        }
+        let mut changed = original;
+        changed.key_id = "m.secret_storage.key.foreign".to_owned();
+        assert!(validate_prepared_recovery_key(changed).is_err());
+    }
+}
