diff --git a/crates/matrix-sdk-sqlite/src/atum_lease_binding_tests.rs b/crates/matrix-sdk-sqlite/src/atum_lease_binding_tests.rs
new file mode 100644
--- /dev/null
+++ b/crates/matrix-sdk-sqlite/src/atum_lease_binding_tests.rs
@@ -0,0 +1,159 @@
+// Atum immutable store binding regressions. Disposable synthetic stores only.
+// SPDX-License-Identifier: Apache-2.0
+
+use matrix_sdk_common::cross_process_lock::{CrossProcessLock, CrossProcessLockConfig};
+use matrix_sdk_crypto::{
+    Account, DecryptionSettings, EncryptionSyncChanges, OlmMachine, OlmMachineBuilder,
+    store::{
+        CRYPTO_STORE_LOCK_KEY, CryptoStore, CryptoStoreError, IntoCryptoStore, LockableCryptoStore,
+        MemoryStore, types::PendingChanges,
+    },
+};
+use ruma::{device_id, user_id};
+use tempfile::TempDir;
+
+use super::{Error, SqliteCryptoStore};
+
+fn lock(store: &SqliteCryptoStore, holder: &str) -> CrossProcessLock<LockableCryptoStore> {
+    CrossProcessLock::new(
+        LockableCryptoStore::new(store.clone()),
+        CRYPTO_STORE_LOCK_KEY.into(),
+        CrossProcessLockConfig::multi_process(holder),
+    )
+}
+
+#[tokio::test]
+async fn foreign_guard_with_identical_lease_tuple_is_refused() {
+    let a_dir = TempDir::new().unwrap();
+    let b_dir = TempDir::new().unwrap();
+    let a = SqliteCryptoStore::open(a_dir.path(), Some("synthetic-binding-test")).await.unwrap();
+    let b = SqliteCryptoStore::open(b_dir.path(), Some("synthetic-binding-test")).await.unwrap();
+    let control_a = lock(&a, "same-holder");
+    let control_b = lock(&b, "same-holder");
+    let guard_a = control_a.try_lock_once().await.unwrap().unwrap().into_guard();
+    let guard_b = control_b.try_lock_once().await.unwrap().unwrap().into_guard();
+    assert_eq!(guard_a.lease_identity(), guard_b.lease_identity());
+    let result = b.with_lease(&guard_a);
+    assert!(
+        result.is_err(),
+        "guard from another opened store must not bind despite an identical lease tuple"
+    );
+    b.with_lease(&guard_b).unwrap().set_custom_value("owner", b"B".to_vec()).await.unwrap();
+    assert!(a.get_custom_value("owner").await.unwrap().is_none());
+}
+
+#[tokio::test]
+async fn independently_reopened_same_database_requires_its_own_guard() {
+    let dir = TempDir::new().unwrap();
+    let a = SqliteCryptoStore::open(dir.path(), Some("synthetic-binding-test")).await.unwrap();
+    let reopened =
+        SqliteCryptoStore::open(dir.path(), Some("synthetic-binding-test")).await.unwrap();
+    let control = lock(&a, "A");
+    let guard = control.try_lock_once().await.unwrap().unwrap().into_guard();
+    assert!(matches!(reopened.with_lease(&guard), Err(Error::InvalidCryptoStoreLeaseBinding)));
+    a.clone().with_lease(&guard).unwrap().set_custom_value("clone", vec![1]).await.unwrap();
+    assert_eq!(reopened.get_custom_value("clone").await.unwrap(), Some(vec![1]));
+}
+
+#[tokio::test]
+async fn both_error_erasure_paths_preserve_scope_and_immutable_epoch() {
+    let dir = TempDir::new().unwrap();
+    let raw = SqliteCryptoStore::open(dir.path(), Some("synthetic-binding-test")).await.unwrap();
+    let erased = raw.clone().into_crypto_store();
+    // Concrete value and Arc<T> use the two existing error-erasure adapters.
+    let arc_erased = std::sync::Arc::new(raw.clone()).into_crypto_store();
+    let control = CrossProcessLock::new(
+        LockableCryptoStore::new(erased.clone()),
+        CRYPTO_STORE_LOCK_KEY.into(),
+        CrossProcessLockConfig::multi_process("A"),
+    );
+    let guard = control.try_lock_once().await.unwrap().unwrap().into_guard();
+    let bound = arc_erased.bind_lease(&guard).unwrap();
+    bound.set_custom_value("erased", vec![2]).await.unwrap();
+    assert!(bound.bind_lease(&guard).is_err());
+    assert!(bound.try_take_leased_lock(500, CRYPTO_STORE_LOCK_KEY, "A").await.is_err());
+    assert_eq!(raw.get_custom_value("erased").await.unwrap(), Some(vec![2]));
+}
+
+#[tokio::test]
+async fn unsupported_memory_backend_refuses_explicit_binding() {
+    let dir = TempDir::new().unwrap();
+    let raw = SqliteCryptoStore::open(dir.path(), Some("synthetic-binding-test")).await.unwrap();
+    let control = lock(&raw, "A");
+    let guard = control.try_lock_once().await.unwrap().unwrap().into_guard();
+    assert!(matches!(
+        MemoryStore::new().into_crypto_store().bind_lease(&guard),
+        Err(CryptoStoreError::LeaseBindingUnsupported)
+    ));
+}
+
+async fn sync(machine: &OlmMachine, batch: &str) -> Result<(), matrix_sdk_crypto::OlmError> {
+    machine
+        .receive_sync_changes(
+            EncryptionSyncChanges {
+                to_device_events: vec![],
+                changed_devices: &Default::default(),
+                one_time_keys_counts: &Default::default(),
+                unused_fallback_keys: None,
+                next_batch_token: Some(batch.into()),
+            },
+            &DecryptionSettings {
+                sender_device_trust_requirement: matrix_sdk_crypto::TrustRequirement::Untrusted,
+            },
+        )
+        .await
+        .map(|_| ())
+}
+
+#[tokio::test]
+async fn old_olm_and_deref_remain_fenced_across_a_b_a() {
+    let dir = TempDir::new().unwrap();
+    let raw_a = SqliteCryptoStore::open(dir.path(), Some("synthetic-binding-test")).await.unwrap();
+    let account =
+        Account::with_device_id(user_id!("@synthetic:atum.invalid"), device_id!("BINDING"));
+    let original = account.identity_keys();
+    let required = (original.curve25519.to_base64(), original.ed25519.to_base64());
+    raw_a.save_pending_changes(PendingChanges { account: Some(account) }).await.unwrap();
+    let raw_b = SqliteCryptoStore::open(dir.path(), Some("synthetic-binding-test")).await.unwrap();
+    let control_a = lock(&raw_a, "A");
+    let guard_a = control_a.try_lock_once().await.unwrap().unwrap().into_guard();
+    let old = OlmMachineBuilder::new(user_id!("@synthetic:atum.invalid"), device_id!("BINDING"))
+        .with_crypto_store(raw_a.bind_lease(&guard_a).unwrap())
+        .with_required_identity_keys(Some(required.clone()))
+        .build()
+        .await
+        .unwrap();
+    let old_clone = old.clone();
+    sync(&old, "A").await.unwrap();
+    old.store().set_custom_value("owner", b"A".to_vec()).await.unwrap();
+    drop(guard_a);
+    let control_b = lock(&raw_b, "B");
+    let guard_b = control_b.spin_lock(None).await.unwrap().unwrap().into_guard();
+    let current_b =
+        OlmMachineBuilder::new(user_id!("@synthetic:atum.invalid"), device_id!("BINDING"))
+            .with_crypto_store(raw_b.bind_lease(&guard_b).unwrap())
+            .with_required_identity_keys(Some(required.clone()))
+            .build()
+            .await
+            .unwrap();
+    sync(&current_b, "B").await.unwrap();
+    current_b.store().set_custom_value("owner", b"B".to_vec()).await.unwrap();
+    assert!(sync(&old, "STALE-A").await.is_err());
+    assert!(old_clone.store().set_custom_value("owner", b"STALE".to_vec()).await.is_err());
+    assert_eq!(raw_b.next_batch_token().await.unwrap().as_deref(), Some("B"));
+    assert_eq!(raw_b.get_custom_value("owner").await.unwrap(), Some(b"B".to_vec()));
+    drop(guard_b);
+    let new_guard_a = control_a.spin_lock(None).await.unwrap().unwrap().into_guard();
+    let new_a = OlmMachineBuilder::new(user_id!("@synthetic:atum.invalid"), device_id!("BINDING"))
+        .with_crypto_store(raw_a.bind_lease(&new_guard_a).unwrap())
+        .with_required_identity_keys(Some(required))
+        .build()
+        .await
+        .unwrap();
+    sync(&new_a, "A2").await.unwrap();
+    assert!(old.store().bind_lease(&new_guard_a).is_err());
+    assert!(sync(&old_clone, "STALE-A2").await.is_err());
+    assert_eq!(raw_a.next_batch_token().await.unwrap().as_deref(), Some("A2"));
+    assert_eq!(raw_a.load_account().await.unwrap().unwrap().identity_keys(), original);
+    assert_eq!(new_a.identity_keys(), original);
+}
