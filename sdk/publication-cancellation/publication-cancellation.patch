+/// Synchronous cancellation signal: never take a cache lock or spawn work in Drop.
+struct PublicationGuard<'a> {
+    wrapper: &'a CryptoStoreWrapper,
+    completed: bool,
+}
+
+impl PublicationGuard<'_> {
+    fn complete(&mut self) {
+        self.completed = true;
+    }
+}
+
+impl Drop for PublicationGuard<'_> {
+    fn drop(&mut self) {
+        if !self.completed {
+            self.wrapper.invalidated.store(true, Ordering::SeqCst);
+            self.wrapper.store.invalidate();
+        }
+    }
+}
