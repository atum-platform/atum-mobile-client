+    /// Fixed-interval retries within a time budget. An admitted acquisition
+    /// finishes its backend transaction and heartbeat installation; the budget
+    /// never cancels that critical section. Backend latency can exceed it.
+    pub async fn spin_lock_for(
+        &self,
+        budget: Duration,
+    ) -> AcquireCrossProcessLockResult<L::LockError> {
+        let deadline = Instant::now() + budget;
+        loop {
+            if Instant::now() >= deadline {
+                return Ok(Err(CrossProcessLockUnobtained::TimedOut));
+            }
+            let result = self.try_lock_once().await?;
+            if result.is_ok() {
+                return Ok(result);
+            }
+            let Some(remaining) = deadline.checked_duration_since(Instant::now()) else {
+                return Ok(Err(CrossProcessLockUnobtained::TimedOut));
+            };
+            sleep(remaining.min(Duration::from_millis(INITIAL_BACKOFF_MS.into()))).await;
+        }
     }
 
