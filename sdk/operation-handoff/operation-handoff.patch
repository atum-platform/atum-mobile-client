+#[tokio::test(flavor = "multi_thread")]
+async fn notification_child_shares_parent_guard_and_original_identity() {
+    let temp = TempDir::new().unwrap();
+    let server = MockServer::start().await;
+    let keys = seed(temp.path()).await;
+    let parent = client(temp.path(), &server, "parent-notification").await;
+    restore(&parent, &keys).await.unwrap();
+    let parent_guard =
+        parent.encryption().spin_lock_store_for(Duration::from_secs(1)).await.unwrap().unwrap();
+    let child = parent.notification_client(CrossProcessLockConfig::SingleProcess).await.unwrap();
+    assert_eq!(
+        child.cross_process_lock_config().holder_name(),
+        parent.cross_process_lock_config().holder_name()
+    );
+    assert!(
+        child.encryption().curve25519_key().await.map(|key| key.to_base64())
+            == Some(keys.0.clone())
+    );
+    assert!(child.encryption().ed25519_key().await == Some(keys.1.clone()));
+    let contender = client(temp.path(), &server, "independent-notification").await;
+    contender
+        .encryption()
+        .enable_cross_process_store_lock("independent-notification".into())
+        .await
+        .unwrap();
+    assert!(
+        contender.encryption().try_lock_store_once().await.unwrap().is_none(),
+        "helper construction must not release the live parent guard"
+    );
+    let child_guard =
+        child.encryption().spin_lock_store_for(Duration::from_secs(1)).await.unwrap().unwrap();
+    drop(parent_guard);
+    assert!(
+        contender.encryption().try_lock_store_once().await.unwrap().is_none(),
+        "child must retain the parent's actual controller guard"
+    );
+    drop(child_guard);
+    assert!(child.encryption().release_store_if_unused().await.unwrap());
+    restore(&contender, &keys).await.unwrap();
+    assert!(surviving_keys(temp.path()).await == Some(keys));
+    parent.pause().await.unwrap();
+    child.pause().await.unwrap();
+    contender.pause().await.unwrap();
