+    /// Promptly release at an operation boundary, only when all local guards
+    /// have dropped. Cancellation of the caller does not abandon a queued
+    /// release while allowing a new local acquisition to overtake it.
+    pub async fn release_if_unused(&self) -> Result<bool, CrossProcessLockError> {
+        let CrossProcessLockConfig::MultiProcess { holder_name } = &self.config else {
+            return Ok(false);
+        };
+        let attempt = self.locking_attempt.clone().lock_owned().await;
+        if Self::count_holders(&self.inner) != 0 {
+            return Ok(false);
+        }
+        // Renewal holds the same attempt mutex through its backend call, so
+        // at this point it can only be sleeping or waiting for this mutex.
+        drop(self.inner.renew_task.lock().await.take());
+        let locker = self.locker.clone();
+        let key = self.lock_key.clone();
+        let holder = holder_name.clone();
+        let generation = self.inner.generation.load(Ordering::SeqCst);
+        // A bare JoinHandle continues if this awaiting future is cancelled.
+        // The task retains attempt until SQLite's queued transaction ends.
+        spawn(async move {
+            let _attempt = attempt;
+            locker
+                .expire_lease(&key, &holder, generation)
+                .await
+                .map_err(|e| CrossProcessLockError::TryLock(Arc::new(e)))
+        })
+        .await
+        .map_err(|_| {
+            CrossProcessLockError::TryLock(Arc::new(std::io::Error::other(
+                "Lease release task failed",
+            )))
+        })?
+    }
