+    let second = client(temp.path(), &server, "notification-contender").await;
+    let release = tokio::spawn({
+        let first = first.clone();
+        async move {
+            tokio::time::sleep(Duration::from_millis(100)).await;
+            assert!(!first.encryption().release_store_if_unused().await.unwrap());
+            drop(guard);
+            first.encryption().release_store_if_unused().await.unwrap();
