+    /// Wait with fixed polling within a total operation budget, rebinding the
+    /// original machine under the acquired lease before returning its guard.
+    pub async fn spin_lock_store_for(
+        &self,
+        budget: Duration,
+    ) -> Result<Option<CrossProcessLockGuard>, Error> {
+        self.lock_store(async move |lock| lock.spin_lock_for(budget).await).await
+    }
