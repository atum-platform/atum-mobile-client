+    #[async_test]
+    async fn test_default_backup_operation_waits_then_owns_http_and_ack() {
+        let (directory, server, background, keys) = pending_backup_fixture().await;
+        let (store_b, lock_b) = backup_contender(directory.path()).await;
+        let holder_b = backup_acquire(&lock_b).await;
+        let entered = Arc::new(Notify::new());
+        backup_response(&server, entered.clone(), Duration::from_millis(1800)).await;
+        background.encryption().backups().maybe_trigger_backup();
+        assert!(
+            tokio::time::timeout(Duration::from_millis(300), entered.notified()).await.is_err(),
+            "uploader must not send while foreground B owns the epoch"
+        );
+        assert_eq!(server.received_requests().await.unwrap().len(), 0);
+        drop(holder_b);
+        tokio::time::timeout(Duration::from_secs(8), entered.notified())
+            .await
+            .expect("uploader must resume after B releases");
+        tokio::time::sleep(Duration::from_millis(1200)).await;
+        assert!(
+            lock_b.try_lock_once().await.unwrap().is_err(),
+            "uploader must renew and own HTTP through acknowledgement"
+        );
+        tokio::time::timeout(Duration::from_secs(5), async {
+            while store_b.inbound_group_session_counts(Some("1")).await.unwrap().backed_up != 1 {
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .expect("owned acknowledgement must persist");
+        let holder_b = backup_acquire(&lock_b).await;
+        let counts = store_b.inbound_group_session_counts(Some("1")).await.unwrap();
+        assert_eq!((counts.total, counts.backed_up), (1, 1));
+        let current = background.olm_machine().await.as_ref().unwrap().clone();
+        assert!(current.store().is_usable());
+        assert_eq!(
+            (
+                current.identity_keys().curve25519.to_base64(),
+                current.identity_keys().ed25519.to_base64()
+            ),
+            keys
+        );
+        server.verify().await;
+        drop(holder_b);
+    }
