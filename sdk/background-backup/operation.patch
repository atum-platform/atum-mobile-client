+        let store = SqliteCryptoStore::open(path, Some(BACKUP_BASELINE_PASSPHRASE)).await.unwrap();
+        let lock = CrossProcessLock::new(
+            LockableCryptoStore::new(store.clone()),
+            CRYPTO_STORE_LOCK_KEY.into(),
+            CrossProcessLockConfig::multi_process("foreground-B"),
+        );
+        (store, lock)
+    }
