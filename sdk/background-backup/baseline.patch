+    /// Characterizes the default upload listener under a real replacement
+    /// epoch. The background client prepared the pending key while it owned
+    /// generation A; a foreground holder then owns generation B before the
+    /// listener is notified. The listener still reaches the backup endpoint,
+    /// and its stale acknowledgement is rejected by the encrypted SQLite
+    /// fence. No production behavior is changed by this baseline.
+    #[cfg(feature = "sqlite")]
+    #[async_test]
+    async fn test_default_backup_upload_task_reaches_http_then_refuses_stale_ack() {
+        let directory = TempDir::new().unwrap();
+        let server = MockServer::start().await;
+        let keys = seed_backup_baseline_store(directory.path()).await;
+        let background = backup_baseline_client(directory.path(), &server, keys).await;
+
+        let owner = background.encryption().spin_lock_store(None).await.unwrap().unwrap();
+        let machine = background.olm_machine().await.as_ref().unwrap().clone();
+
+        let decryption_key = BackupDecryptionKey::new();
+        let backup_key = decryption_key.megolm_v1_public_key();
+        backup_key.set_version("1".to_owned());
+        machine
+            .backup_machine()
+            .save_decryption_key(Some(decryption_key), Some("1".to_owned()))
+            .await
+            .unwrap();
+        machine.backup_machine().enable_backup_v1(backup_key).await.unwrap();
+        machine
+            .store()
+            .import_exported_room_keys(vec![backup_baseline_room_key()], |_, _| {})
+            .await
+            .unwrap();
+
+        assert!(
+            background.inner.e2ee.tasks.lock().upload_room_keys.is_some(),
+            "Client construction must install the default BackupUploadingTask"
+        );
+
+        drop(owner);
+
+        let foreground_store =
+            SqliteCryptoStore::open(directory.path(), Some(BACKUP_BASELINE_PASSPHRASE))
+                .await
+                .unwrap();
+        let foreground_lock = CrossProcessLock::new(
+            LockableCryptoStore::new(foreground_store.clone()),
+            CRYPTO_STORE_LOCK_KEY.into(),
+            CrossProcessLockConfig::multi_process("foreground-B"),
+        );
+        let foreground =
+            tokio::time::timeout(Duration::from_secs(5), foreground_lock.spin_lock(Some(100)))
+                .await
+                .expect("background epoch must expire")
+                .unwrap()
+                .unwrap()
+                .into_guard();
+
+        let request_entered = Arc::new(Notify::new());
+        Mock::given(method("PUT"))
+            .and(path_regex(r"^/_matrix/client/(v3|r0)/room_keys/keys$"))
+            .respond_with({
+                let request_entered = request_entered.clone();
+                move |_: &Request| {
+                    request_entered.notify_one();
+                    ResponseTemplate::new(200)
+                        .set_body_json(json!({"count": 1, "etag": "synthetic"}))
+                        .set_delay(Duration::from_millis(100))
+                }
+            })
+            .expect(1)
+            .mount(&server)
+            .await;
+
+        background.encryption().backups().maybe_trigger_backup();
+        tokio::time::timeout(Duration::from_secs(2), request_entered.notified())
+            .await
+            .expect("stale default uploader unexpectedly reached the backup HTTP endpoint");
+
+        tokio::time::timeout(Duration::from_secs(2), async {
+            while machine.store().is_usable() {
+                tokio::time::sleep(Duration::from_millis(10)).await;
+            }
+        })
+        .await
+        .expect("stale backup acknowledgement must refuse and invalidate A's bound writer");
+
+        let counts = foreground_store.inbound_group_session_counts(Some("1")).await.unwrap();
+        assert_eq!(counts.total, 1, "the synthetic pending key remains durable");
+        assert_eq!(counts.backed_up, 0, "the stale acknowledgement must not persist");
+        assert!(
+            background.inner.e2ee.tasks.lock().upload_room_keys.is_some(),
+            "the stale listener remains installed after its acknowledgement refusal"
+        );
+        eprintln!(
+            "backup ownership baseline: default task made one HTTP request under foreground B; stale ack refused with {}/{} keys backed up",
+            counts.backed_up, counts.total
+        );
+        server.verify().await;
+        drop(foreground);
+    }
 
