+#[tokio::test]
+async fn guard_clone_and_same_holder_renewal_keep_the_writer_valid() {
+    let temp = TempDir::new().unwrap();
+    let store = SqliteCryptoStore::open(temp.path(), Some("synthetic-fence-test")).await.unwrap();
+    let control = lock(&store, "synthetic-A");
+    let guard = control.try_lock_once().await.unwrap().unwrap().into_guard();
+    let cloned = guard.clone();
+    let bound = writer(&store, &guard);
+    assert_eq!(guard.lease_identity(), cloned.lease_identity());
+    drop(guard);
+    // More than one normal SDK lease lifetime; real renewal must sustain it.
+    tokio::time::sleep(Duration::from_millis(650)).await;
+    bound.set_custom_value("renewed", vec![7]).await.unwrap();
+    let reentrant = control.try_lock_once().await.unwrap().unwrap().into_guard();
+    assert_eq!(cloned.lease_identity(), reentrant.lease_identity());
+    assert_eq!(store.get_custom_value("renewed").await.unwrap(), Some(vec![7]));
+    assert!(matches!(bound.with_lease(&reentrant), Err(Error::InvalidCryptoStoreLeaseBinding)));
+}
