+    let b = SqliteCryptoStore::open(temp.path(), Some("synthetic-fence-test")).await.unwrap();
+    let sender = Account::with_device_id(user_id!("@synthetic:atum.invalid"), device_id!("FENCE"));
+    let keys = sender.identity_keys();
+    a.save_pending_changes(PendingChanges { account: Some(sender) }).await.unwrap();
+    let room = room_id!("!synthetic:atum.invalid");
+    let make_session = || {
+        InboundGroupSession::new(
+            keys.curve25519,
+            keys.ed25519,
+            room,
+            &GroupSession::new(SessionConfig::default()).session_key(),
+            SenderData::UnknownDevice { legacy_session: false, owner_check_failed: false },
+            None,
+            EventEncryptionAlgorithm::MegolmV1AesSha2,
+            None,
+            false,
+        )
+        .unwrap()
+    };
+    let control_a = lock(&a, "synthetic-A");
+    let guard_a = control_a.try_lock_once().await.unwrap().unwrap().into_guard();
+    let stale = writer(&a, &guard_a);
+    drop(guard_a);
+    let control_b = lock(&b, "synthetic-B");
+    let guard_b = control_b.spin_lock(None).await.unwrap().unwrap().into_guard();
+    let current = writer(&b, &guard_b);
+    let kept = make_session();
+    current.save_inbound_group_sessions(vec![kept.clone()], None).await.unwrap();
+    let refused = make_session();
+    assert!(matches!(
+        stale.save_inbound_group_sessions(vec![refused.clone()], None).await,
+        Err(Error::StaleCryptoStoreLease)
+    ));
+    assert!(matches!(
+        stale
+            .mark_inbound_group_sessions_as_backed_up(
+                "synthetic-version",
+                &[(room, kept.session_id())]
+            )
+            .await,
+        Err(Error::StaleCryptoStoreLease)
+    ));
+    assert!(
+        !b.get_inbound_group_session(room, kept.session_id()).await.unwrap().unwrap().backed_up()
+    );
+    current
+        .mark_inbound_group_sessions_as_backed_up("synthetic-version", &[(room, kept.session_id())])
+        .await
+        .unwrap();
+    assert!(matches!(stale.reset_backup_state().await, Err(Error::StaleCryptoStoreLease)));
+    assert!(matches!(
+        stale
+            .save_changes(Changes {
+                inbound_group_sessions: vec![refused.clone()],
+                next_batch_token: Some("stale-batch".into()),
+                backup_version: Some("stale-backup".into()),
+                ..Default::default()
+            })
+            .await,
+        Err(Error::StaleCryptoStoreLease)
+    ));
+    assert!(b.get_inbound_group_session(room, refused.session_id()).await.unwrap().is_none());
+    assert!(
+        b.get_inbound_group_session(room, kept.session_id()).await.unwrap().unwrap().backed_up()
+    );
+    assert_eq!(b.get_inbound_group_sessions().await.unwrap().len(), 1);
+    assert!(b.next_batch_token().await.unwrap().is_none());
+    assert!(b.load_backup_keys().await.unwrap().backup_version.is_none());
+    assert_eq!(b.load_account().await.unwrap().unwrap().identity_keys(), keys);
+}
+
+#[tokio::test]
+async fn interrupted_database_worker_returns_error_and_rolls_back() {
+    let temp = TempDir::new().unwrap();
+    let a = SqliteCryptoStore::open(temp.path(), Some("synthetic-fence-test")).await.unwrap();
+    let control = lock(&a, "synthetic-A");
+    let guard = control.try_lock_once().await.unwrap().unwrap().into_guard();
+    let bound = writer(&a, &guard);
+    let encrypted = bound.store_cipher.as_ref().unwrap().encrypt_value_data(vec![1]).unwrap();
+    let serialized = rmp_serde::to_vec_named(&encrypted).unwrap();
+    let result: Result<(), Error> = bound
+        .with_crypto_write(move |txn| {
+            txn.set_kv("interrupted", &serialized)?;
+            panic!("synthetic database worker interruption");
+        })
+        .await;
+    assert!(matches!(result, Err(Error::CryptoStoreInteractionFailed)));
+    // Discard the failed store/client. An independently reopened real store
+    // proves that transaction unwind did not publish the interrupted write.
+    let reopened =
+        SqliteCryptoStore::open(temp.path(), Some("synthetic-fence-test")).await.unwrap();
+    assert!(reopened.get_custom_value("interrupted").await.unwrap().is_none());
+}
