+// Atum SQLite lease-fence regression. Disposable synthetic stores only.
+// SPDX-License-Identifier: Apache-2.0
+
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::Duration,
+};
+
+use matrix_sdk_common::cross_process_lock::{
+    CrossProcessLock, CrossProcessLockConfig, CrossProcessLockGuard, TryLock,
+};
+use matrix_sdk_crypto::{
+    Account,
+    store::{
+        CryptoStore, LockableCryptoStore,
+        types::{Changes, PendingChanges},
+    },
+};
+use ruma::{device_id, user_id};
+use tempfile::TempDir;
+
+use super::{Error, SqliteCryptoStore, SqliteKeyValueStoreConnExt};
+
+const LOCK_KEY: &str = matrix_sdk_crypto::store::CRYPTO_STORE_LOCK_KEY;
+type Lock = CrossProcessLock<LockableCryptoStore>;
+
+fn lock(store: &SqliteCryptoStore, holder: &str) -> Lock {
+    CrossProcessLock::new(
+        LockableCryptoStore::new(store.clone()),
+        LOCK_KEY.to_owned(),
+        CrossProcessLockConfig::multi_process(holder),
+    )
+}
+
+fn writer(store: &SqliteCryptoStore, guard: &CrossProcessLockGuard) -> SqliteCryptoStore {
+    store.with_lease(guard).unwrap()
+}
