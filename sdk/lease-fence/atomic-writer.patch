+#[tokio::test]
+async fn retained_guard_and_writer_stay_stale_across_owner_a_b_a() {
+    let temp = TempDir::new().unwrap();
+    let a = SqliteCryptoStore::open(temp.path(), Some("synthetic-fence-test")).await.unwrap();
+    let b = SqliteCryptoStore::open(temp.path(), Some("synthetic-fence-test")).await.unwrap();
+    let renew = Arc::new(AtomicBool::new(true));
+    let old_control = CrossProcessLock::new(
+        StoppableRenewal { store: a.clone(), renew: renew.clone() },
+        LOCK_KEY.into(),
+        CrossProcessLockConfig::multi_process("synthetic-A"),
+    );
+    let old_guard = old_control.try_lock_once().await.unwrap().unwrap().into_guard();
+    let old_identity = old_guard.lease_identity().unwrap().2;
+    let stale = writer(&a, &old_guard);
+    renew.store(false, Ordering::SeqCst);
+    tokio::time::sleep(Duration::from_millis(650)).await;
+    let peer_control = lock(&b, "synthetic-B");
+    let peer_guard = peer_control.spin_lock(None).await.unwrap().unwrap().into_guard();
+    assert!(peer_guard.lease_identity().unwrap().2 > old_identity);
+    writer(&b, &peer_guard).set_custom_value("epoch", b"B".to_vec()).await.unwrap();
+    assert!(matches!(
+        stale.set_custom_value("epoch", vec![0]).await,
+        Err(Error::StaleCryptoStoreLease)
+    ));
+    drop(peer_guard);
+    let new_control = lock(&a, "synthetic-A");
+    let new_guard = new_control.spin_lock(None).await.unwrap().unwrap().into_guard();
+    assert!(new_guard.lease_identity().unwrap().2 > old_identity);
+    writer(&a, &new_guard).set_custom_value("epoch", b"NEW-A".to_vec()).await.unwrap();
+    assert_eq!(old_guard.lease_identity().unwrap().2, old_identity);
+    assert!(matches!(
+        stale.set_custom_value("epoch", vec![0]).await,
+        Err(Error::StaleCryptoStoreLease)
+    ));
+    // Existing local guard shortcut must not grant the old writer a new epoch.
+    let old_reentrant = old_control.try_lock_once().await.unwrap().unwrap().into_guard();
+    assert_eq!(old_reentrant.lease_identity().unwrap().2, old_identity);
+    assert!(matches!(
+        writer(&a, &old_reentrant).remove_custom_value("epoch").await,
+        Err(Error::StaleCryptoStoreLease)
+    ));
+    assert_eq!(a.get_custom_value("epoch").await.unwrap(), Some(b"NEW-A".to_vec()));
+}
