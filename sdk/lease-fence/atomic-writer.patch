+#[tokio::test]
+async fn every_mutation_refuses_a_stale_epoch_and_account_cache_stays_original() {
+    let temp = TempDir::new().unwrap();
+    let a = SqliteCryptoStore::open(temp.path(), Some("synthetic-fence-test")).await.unwrap();
+    let original =
+        Account::with_device_id(user_id!("@synthetic:atum.invalid"), device_id!("FENCE"));
+    let expected = original.identity_keys();
+    a.save_pending_changes(PendingChanges { account: Some(original) }).await.unwrap();
+    let b = SqliteCryptoStore::open(temp.path(), Some("synthetic-fence-test")).await.unwrap();
+    let lock_a = lock(&a, "synthetic-A");
+    let guard = lock_a.try_lock_once().await.unwrap().unwrap().into_guard();
+    let stale = writer(&a, &guard);
+    drop(guard);
+    let lock_b = lock(&b, "synthetic-B");
+    let guard_b = lock_b.spin_lock(None).await.unwrap().unwrap().into_guard();
+    let current = writer(&b, &guard_b);
+    current
+        .save_changes(Changes {
+            next_batch_token: Some("current-batch".into()),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    current.save_tracked_users(&[(user_id!("@peer:atum.invalid"), false)]).await.unwrap();
+
+    macro_rules! stale {
+        ($future:expr) => {
+            assert!(matches!($future.await, Err(Error::StaleCryptoStoreLease)));
+        };
+    }
+    let replacement =
+        Account::with_device_id(user_id!("@synthetic:atum.invalid"), device_id!("REPLACEMENT"));
+    stale!(stale.save_pending_changes(PendingChanges { account: Some(replacement) }));
+    assert_eq!(*stale.get_static_account().unwrap().identity_keys, expected);
+    stale!(stale.save_pending_changes(PendingChanges { account: None }));
+    stale!(stale.save_changes(Changes {
+        next_batch_token: Some("stale-batch".into()),
+        ..Default::default()
+    }));
+    stale!(stale.save_inbound_group_sessions(Vec::new(), None));
+    stale!(stale.mark_inbound_group_sessions_as_backed_up("synthetic-version", &[]));
+    stale!(stale.reset_backup_state());
+    stale!(stale.delete_dehydrated_device_pickle_key());
+    stale!(stale.save_tracked_users(&[(user_id!("@peer:atum.invalid"), true)]));
+    stale!(stale.save_tracked_users(&[]));
+    let request_id = ruma::TransactionId::new();
+    stale!(stale.delete_outgoing_secret_requests(&request_id));
+    stale!(
+        stale.delete_secrets_from_inbox(&ruma::events::secret::request::SecretName::RecoveryKey)
+    );
+    stale!(stale.set_custom_value("synthetic-value", vec![1]));
+    stale!(stale.remove_custom_value("synthetic-value"));
+    assert!(matches!(
+        stale.try_take_leased_lock(500, LOCK_KEY, "synthetic-A").await,
+        Err(Error::InvalidCryptoStoreLeaseBinding)
+    ));
+    assert_eq!(b.next_batch_token().await.unwrap().as_deref(), Some("current-batch"));
+    assert!(!b.load_tracked_users().await.unwrap()[0].dirty);
+    assert_eq!(b.load_account().await.unwrap().unwrap().identity_keys(), expected);
+}
