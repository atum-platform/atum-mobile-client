+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn successor_cannot_take_an_expired_lease_between_fence_check_and_commit() {
+    let temp = TempDir::new().unwrap();
+    let a = SqliteCryptoStore::open(temp.path(), Some("synthetic-fence-test")).await.unwrap();
+    let b = SqliteCryptoStore::open(temp.path(), Some("synthetic-fence-test")).await.unwrap();
+    b.write()
+        .await
+        .unwrap()
+        .interact(|conn| conn.busy_timeout(Duration::from_millis(25)))
+        .await
+        .unwrap()
+        .unwrap();
+    let control = lock(&a, "synthetic-A");
+    let guard = control.try_lock_once().await.unwrap().unwrap().into_guard();
+    let bound = writer(&a, &guard);
+    let encrypted =
+        bound.store_cipher.as_ref().unwrap().encrypt_value_data(b"A-committed".to_vec()).unwrap();
+    let serialized = rmp_serde::to_vec_named(&encrypted).unwrap();
+    let (started_tx, started_rx) = tokio::sync::oneshot::channel();
+    let (release_tx, release_rx) = std::sync::mpsc::channel();
+    let pending = tokio::spawn(async move {
+        bound
+            .with_crypto_write(move |txn| {
+                started_tx.send(()).unwrap();
+                release_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+                txn.set_kv("atomic-result", &serialized)?;
+                Ok(())
+            })
+            .await
+    });
+    started_rx.await.unwrap();
+    drop(guard);
+    // The renewal task cannot update the lease because this transaction holds
+    // the real write connection. Let the existing lease expire without edits.
+    tokio::time::sleep(Duration::from_millis(650)).await;
+    let denied = b.try_take_leased_lock(500, LOCK_KEY, "synthetic-B").await;
+    // Always release the transaction before any assertion, including failures.
+    release_tx.send(()).unwrap();
+    pending.await.unwrap().unwrap();
+    assert!(matches!(denied, Err(Error::Sqlite(rusqlite::Error::SqliteFailure(e, _)))
+        if e.code == rusqlite::ErrorCode::DatabaseBusy));
+    let peer = lock(&b, "synthetic-B");
+    let peer_guard = peer.spin_lock(None).await.unwrap().unwrap().into_guard();
+    let current = writer(&b, &peer_guard);
+    assert_eq!(b.get_custom_value("atomic-result").await.unwrap(), Some(b"A-committed".to_vec()));
+    current.set_custom_value("atomic-result", b"B-after-commit".to_vec()).await.unwrap();
+    assert_eq!(
+        b.get_custom_value("atomic-result").await.unwrap(),
+        Some(b"B-after-commit".to_vec())
+    );
+}
