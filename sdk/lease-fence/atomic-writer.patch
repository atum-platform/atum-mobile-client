+// Test instrumentation stops renewal, while acquisition/generations/mutations
+// still use the actual encrypted SQLite backend. No lease row is fabricated.
+#[derive(Clone)]
+struct StoppableRenewal {
+    store: SqliteCryptoStore,
+    renew: Arc<AtomicBool>,
+}
+
+impl TryLock for StoppableRenewal {
+    type LockError = Error;
+
+    async fn try_lock(&self, duration: u32, key: &str, holder: &str) -> Result<Option<u64>, Error> {
+        if !self.renew.load(Ordering::SeqCst) {
+            return Ok(None);
+        }
+        self.store.try_take_leased_lock(duration, key, holder).await
+    }
+}
