+    /// Create an explicitly lease-bound crypto writer for this operation.
+    ///
+    /// The caller must obtain the guard through this store's SDK crypto lock
+    /// and retain it throughout the operation. This clone deliberately does
+    /// not extend the lease. On refusal, discard the owning Olm client and its
+    /// caches. Raw handles remain for bootstrap and lease acquisition only.
+    /// A bound clone cannot rebind or acquire/renew a lease.
+    pub fn with_lease(&self, guard: &CrossProcessLockGuard) -> Result<Self> {
+        if self.lease_fence.is_some() {
+            return Err(Error::InvalidCryptoStoreLeaseBinding);
+        }
+        let (key, holder, generation) = guard
+            .lease_identity()
+            .filter(|(key, _, generation)| {
+                *key == CRYPTO_STORE_LOCK_KEY && *generation >= FIRST_CROSS_PROCESS_LOCK_GENERATION
+            })
+            .ok_or(Error::InvalidCryptoStoreLeaseBinding)?;
+        let mut writer = self.clone();
+        writer.lease_fence = Some((key.to_owned(), holder.to_owned(), generation));
+        Ok(writer)
+    }
+
+    /// Reserve the SQLite writer before testing ownership. A competing lease
+    /// acquisition cannot interleave between this check and the mutation's
+    /// commit. Each check uses database-execution time, not time before await.
+    async fn with_crypto_write<T, F>(&self, f: F) -> Result<T>
+    where
+        T: Send + 'static,
+        F: FnOnce(&Transaction<'_>) -> Result<T> + Send + 'static,
+    {
+        let fence = self.lease_fence.clone();
+        self.write()
+            .await?
+            .interact(move |conn| {
+                let txn = conn.transaction_with_behavior(TransactionBehavior::Immediate)?;
+                if let Some((key, holder, generation)) = fence {
+                    let now: u64 = MilliSecondsSinceUnixEpoch::now().get().into();
+                    let current: bool = txn.query_row(
+                        "SELECT EXISTS(SELECT 1 FROM lease_locks WHERE key = ?1
+                         AND holder = ?2 AND generation = ?3 AND expiration > ?4)",
+                        (key, holder, generation, now),
+                        |row| row.get(0),
+                    )?;
+                    if !current {
+                        return Err(Error::StaleCryptoStoreLease);
+                    }
+                }
+                let result = f(&txn)?;
+                txn.commit()?;
+                Ok(result)
+            })
+            .await
+            .map_err(|_| Error::CryptoStoreInteractionFailed)?
     }
 }
 
