      "violation": "const"
    },
    {
      "file": "fixtures/pusher-set-chosen-device-name.request.json",
      "message": "pusher.set.request",
      "expect": "reject",
      "violation": "enum"
    },
    {
      "file": "fixtures/pusher-set-alert-with-text.request.json",
      "message": "pusher.set.request",
      "expect": "reject",
      "violation": "unknown_field"
    },
    {
      "file": "fixtures/pusher-delete.request.json",
      "message": "pusher.delete.request",
      "expect": "accept"
    },
    {
      "file": "fixtures/gateway-notification.request.json",
      "message": "gateway.notification",
      "expect": "accept"
    },
    {
      "file": "fixtures/gateway-notification-with-content.request.json",
      "message": "gateway.notification",
      "expect": "reject",
      "violation": "forbidden_field"
    },
    {
      "file": "fixtures/apns.payload.json",
      "message": "apns.payload",
      "expect": "accept"
    },
    {
      "file": "fixtures/apns-payload-with-body.payload.json",
      "message": "apns.payload",
      "expect": "reject",
      "violation": "forbidden_field"
    },
    {
      "file": "fixtures/apns-payload-with-sender.payload.json",
      "message": "apns.payload",
      "expect": "reject",
      "violation": "forbidden_field"
    },
    {
      "file": "fixtures/sygnal-apps.config.json",
      "message": "sygnal.apps",
      "expect": "accept"
    },
    {
      "file": "fixtures/sygnal-apps-inline-key.config.json",
      "message": "sygnal.apps",
      "expect": "reject",
      "violation": "forbidden_field"
    },
    {
      "file": "fixtures/sygnal-apps-wrong-team.config.json",
      "message": "sygnal.apps",
      "expect": "reject",
      "violation": "const"
    },
    {
      "file": "fixtures/pusher-lifecycle.sequence.json",
      "machine": "pusher",
      "expect": "accept"
    },
    {
      "file": "fixtures/pusher-token-rotation.sequence.json",
      "machine": "pusher",
      "expect": "accept"
    },
    {
      "file": "fixtures/pusher-revived-after-removal.sequence.json",
      "machine": "pusher",
      "expect": "reject",
      "violation": "transition"
    }
  ]
}
