{
  "steps": [
    {
      "from": "signed_out",
      "to": "authorizing",
      "event": "start"
    },
    {
      "from": "authorizing",
      "to": "active",
      "event": "granted_and_bound"
    },
    {
      "from": "active",
      "to": "reauth_required",
      "event": "revoked_elsewhere"
    },
    {
      "from": "reauth_required",
      "to": "authorizing",
      "event": "person_retries"
    },
    {
      "from": "authorizing",
      "to": "active",
      "event": "granted_and_bound"
    }
  ]
}
