    "src.matrix.chat-copy.copies.replyHandover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the last hour, %1$@ couldn’t finish several replies on this Mac, so this Mac stepped back from answering for a few minutes each time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この1時間に、%1$@ はこのMacで何度か返信を完了できなかったため、このMacはそのたびに数分間、返信を控えました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong một giờ qua, %1$@ nhiều lần không trả lời xong trên máy Mac này, nên máy này đã tạm nhường việc trả lời vài phút mỗi lần."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "过去一小时内，%1$@ 在这台 Mac 上多次未能完成回复，因此这台 Mac 每次都暂停回复几分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去一小時內，%1$@ 在這台 Mac 上多次未能完成回覆，因此這台 Mac 每次都暫停回覆幾分鐘。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.replyHere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
