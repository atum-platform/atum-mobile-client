        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sẽ không thấy tin bạn đang trả lời."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不会看到您正在回复的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
