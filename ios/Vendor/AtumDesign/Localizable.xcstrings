    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.notReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ isn’t ready yet. Try again, or check later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はまだ準備ができていません。再試行するか、後で確認してください。"
