    "shared.matrix-app-chat-copy.matrixAppChatCopy.disclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a private chat with this app? It only sees what you send it, not your other chats or memories."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリとプライベートチャットを始めますか？アプリが見られるのはあなたが送った内容だけで、ほかのチャットや記憶は見られません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu trò chuyện riêng với ứng dụng này? Ứng dụng chỉ thấy những gì bạn gửi cho nó, không thấy các cuộc trò chuyện hay ký ức khác của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "与此应用开始私聊？它只能看到你发给它的内容，看不到你的其他聊天或记忆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與此應用程式開始私人聊天？它只能看到你傳給它的內容，看不到你的其他聊天或記憶。"
          }
        }
      }
    },
    "shared.matrix-app-chat-copy.matrixAppChatCopy.groupDisclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you can ask the app for help. Everyone in the group, including people added later, can read its replies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに頼めるのはあなただけです。後から追加された人を含め、グループの全員がアプリの返信を読めます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bạn mới có thể nhờ ứng dụng. Mọi người trong nhóm, kể cả người được thêm sau, đều đọc được câu trả lời của ứng dụng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你可以请应用帮忙。群组中的所有人（包括之后加入的人）都能看到应用的回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你可以請應用程式幫忙。群組中的所有人（包括之後加入的人）都能看到應用程式的回覆。"
          }
        }
      }
    },
    "shared.matrix-app-chat-copy.matrixAppChatCopy.groupInvite": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone in the group can invite others."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループのメンバーは誰でも他の人を招待できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người trong nhóm đều có thể mời thêm người khác."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "群组中的任何人都可以邀请其他人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組中的任何人都可以邀請其他人。"
          }
        }
      }
    },
