        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn của bạn đã được lưu. Lựa chọn sẽ được áp dụng khi thiết bị đồng hành kết nối."
          }
        },
        "zh": {
