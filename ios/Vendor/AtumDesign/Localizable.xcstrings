    "src.matrix.mobile-copy.copy.downloadHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan with your phone’s camera, or open the download page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンのカメラでスキャンするか、ダウンロードページを開いてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
