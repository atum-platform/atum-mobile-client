    "src.matrix.mobile-copy.mobilePhoneCopy.aiConsentHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum sends the messages and files you choose to third-party AI providers to answer and carry out your task."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum は選択したメッセージとファイルを第三者の AI プロバイダーに送り、回答やタスクの実行に使用します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum gửi các tin nhắn và tệp bạn chọn đến nhà cung cấp AI bên thứ ba để trả lời và thực hiện tác vụ của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 会将你选择的消息和文件发送给第三方 AI 提供商，用于回答和执行你的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 會將你選擇的訊息和檔案傳送給第三方 AI 供應商，用於回答和執行你的任務。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobilePhoneCopy.aiConsentTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow AI providers to process your task?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI プロバイダーによるタスク処理を許可しますか？"
          }
