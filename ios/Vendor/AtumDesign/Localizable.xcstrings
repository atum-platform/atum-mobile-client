    "src.matrix.mobile-copy.mobilePhoneCopy.deletionHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and personal content will be deleted. Required billing records may be retained."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントと個人コンテンツは削除されます。必要な請求記録は保持される場合があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản và nội dung cá nhân sẽ bị xóa. Hồ sơ thanh toán bắt buộc có thể được giữ lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账号和个人内容将被删除。法律要求的账单记录可能会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帳號和個人內容將被刪除。法律要求的帳單記錄可能會保留。"
          }
        }
      }
    },
