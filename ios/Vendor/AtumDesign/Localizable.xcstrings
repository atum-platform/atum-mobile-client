        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改 iCloud 钥匙串。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法變更 iCloud 鑰匙圈。請再試一次。"
          }
        }
      }
    },
    "src.matrix.security-copy.copies.icloudHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new Mac on the same Apple ID unlocks by itself. iCloud Keychain is end-to-end encrypted: neither Apple nor Atum can read your key. Anyone sharing this Apple ID gets it too, but still needs your Atum account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ Apple ID の新しい Mac は自動でロックが解除されます。iCloud キーチェーンはエンドツーエンドで暗号化されており、Apple も Atum もキーを読めません。この Apple ID を共有している人にもキーが届きますが、あなたの Atum アカウントが必要です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac mới dùng cùng Apple ID sẽ tự mở khóa. iCloud Keychain được mã hóa đầu cuối: Apple và Atum đều không đọc được khóa. Ai dùng chung Apple ID này cũng nhận được khóa, nhưng vẫn cần tài khoản Atum của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "使用同一 Apple ID 的新 Mac 会自动解锁。iCloud 钥匙串采用端到端加密：Apple 和 Atum 都无法读取你的密钥。共用此 Apple ID 的人也会收到它，但仍需要你的 Atum 账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用同一 Apple ID 的新 Mac 會自動解鎖。iCloud 鑰匙圈採用端對端加密：Apple 和 Atum 都無法讀取你的金鑰。共用此 Apple ID 的人也會收到它，但仍需要你的 Atum 帳號。"
          }
        }
      }
    },
    "src.matrix.security-copy.copies.icloudOffConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the key from iCloud Keychain on all your devices? This Mac keeps its own copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての端末の iCloud キーチェーンからキーを削除しますか？この Mac は自分のコピーを保持します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa khóa khỏi iCloud Keychain trên mọi thiết bị của bạn? Mac này vẫn giữ bản của nó."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "要从你所有设备的 iCloud 钥匙串中删除密钥吗？这台 Mac 会保留自己的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要從你所有裝置的 iCloud 鑰匙圈中刪除金鑰嗎？這台 Mac 會保留自己的副本。"
          }
        }
      }
    },
