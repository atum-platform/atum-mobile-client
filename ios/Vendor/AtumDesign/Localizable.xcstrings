    "src.matrix.mobile-copy.copy.qrFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The QR could not load. Use the download link instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QR を読み込めませんでした。ダウンロードリンクをご利用ください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa tải được QR. Hãy dùng liên kết tải ứng dụng."
          }
        },
        "zh": {
