    "desktop.dm.group.sharedContextDisclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reply uses recent group history and an approved shared identity. It does not use private history or tools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この返信は最近のグループ履歴と承認済みの共有アイデンティティを使います。非公開の履歴やツールは使いません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời này dùng lịch sử nhóm gần đây và danh tính chia sẻ đã được phê duyệt. Câu trả lời không dùng lịch sử hay công cụ riêng tư."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此回复使用近期的群组记录和已批准的共享身份，不使用私人记录或工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這則回覆會使用近期的群組紀錄和已核准的共用身分，不會使用私人紀錄或工具。"
          }
        }
      }
    },
