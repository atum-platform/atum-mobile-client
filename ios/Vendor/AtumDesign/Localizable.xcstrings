    "shared.matrix-first-run-copy.copies.greeting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi %1$@, I’m %2$@. Name me anything—what can I do?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さん、こんにちは。%2$@です。好きな名前で、何をしましょう？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào %1$@, mình là %2$@. Đặt tên gì cũng được—mình giúp gì nhé?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，你好，我是 %2$@。随你命名，想做什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，你好，我是 %2$@。隨你命名，想做什麼？"
          }
        }
      }
    },
