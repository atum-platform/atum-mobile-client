    "shared.matrix-settings-revamp-copy.phoneSettingsCopy.macAccessHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistants work on your Mac. What they may do there is set on that Mac."
