    "shared.matrix-pages-copy.archiveCopy.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this skill from %1$@ on this Mac. Its files and installation record will be kept in the local archive. Existing conversations may keep using their saved instructions until a new session.\n\n%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の %1$@ からスキルを取り除きます。ファイルとインストール記録はローカルのアーカイブに保持されます。既存の会話は新しいセッションまで保存済みの指示を使い続ける場合があります。\n\n%2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ kỹ năng này khỏi %1$@ trên máy Mac này. Tệp và bản ghi cài đặt sẽ được giữ trong kho lưu trữ cục bộ. Cuộc trò chuyện hiện tại có thể tiếp tục dùng hướng dẫn đã lưu cho đến phiên mới.\n\n%2$@"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "从此 Mac 上的 %1$@ 移除此技能。文件和安装记录将保留在本地归档中。现有对话可能会继续使用已保存的指令，直到开始新会话。\n\n%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此 Mac 上的 %1$@ 移除此技能。檔案和安裝記錄會保留在本機封存中。現有對話可能會繼續使用已儲存的指示，直到開始新工作階段。\n\n%2$@"
          }
        }
      }
    },
    "shared.matrix-pages-copy.archiveCopy.title": {
      "localizations": {
