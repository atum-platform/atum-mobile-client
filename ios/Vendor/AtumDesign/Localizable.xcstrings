    "src.matrix.sign-in-copy.copies.accountMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac was signed in with a different Atum account. Sign in with that account to continue, or sign out of it first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac は別の Atum アカウントで使われていました。そのアカウントでログインして続けるか、先にそのアカウントからログアウトしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này đang dùng một tài khoản Atum khác. Hãy đăng nhập bằng tài khoản đó để tiếp tục, hoặc đăng xuất tài khoản đó trước."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 之前登录的是另一个 Atum 账号。请用那个账号登录以继续，或先退出那个账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 之前登入的是另一個 Atum 帳號。請用那個帳號登入以繼續，或先登出那個帳號。"
          }
        }
      }
    },
