    "desktop.atum.workspace.capability.setupRequest": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help me set up the installed {name} skill for this assistant. Check its required tools and visual review support, then explain any installation or configuration needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアシスタントにインストール済みの {name} スキルの設定を手伝ってください。必要なツールと画像による確認機能を調べ、必要なインストールや設定を説明してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giúp tôi thiết lập kỹ năng {name} đã cài cho trợ lý này. Kiểm tra các công cụ cần thiết và khả năng kiểm tra bố cục bằng hình ảnh, rồi giải thích những gì cần cài đặt hoặc cấu hình."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请帮助我为此助手设置已安装的 {name} 技能。检查所需工具和图像检查功能，然后说明需要安装或配置的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請幫助我為此助理設定已安裝的 {name} 技能。檢查所需工具與圖像檢查功能，再說明需要安裝或設定的內容。"
          }
        }
      }
    },
