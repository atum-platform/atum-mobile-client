    "src.matrix.chat-copy.copies.memberRemoveBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They won’t get new messages here. Messages they already received stay with them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットの新しいメッセージは相手に届かなくなります。すでに受け取ったメッセージは相手の手元に残ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Họ sẽ không nhận tin nhắn mới ở đây nữa. Tin nhắn họ đã nhận vẫn còn ở phía họ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "对方将不再收到此对话的新消息。对方已收到的消息仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方將不再收到此對話的新訊息。對方已收到的訊息仍會保留。"
          }
        }
      }
