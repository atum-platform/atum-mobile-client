    "src.matrix.group-picker-copy.copies.appGroupNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A group with this app is just you and the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリとのグループは、あなたとアプリだけです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm với ứng dụng này chỉ gồm bạn và ứng dụng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "与这个应用的群组只有你和这个应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與這個應用程式的群組只有你和這個應用程式。"
          }
        }
      }
    },
    "src.matrix.group-picker-copy.copies.assistantsNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only you can ask your assistants here, and everyone can read their answers. In a group with only your assistants, relevant ones may join without being named. Your message, their work descriptions, a quoted message, and recent group messages may go to AI services to choose and prepare replies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループでアシスタントに頼めるのはあなただけで、返信は全員が読めます。あなたとアシスタントだけのグループでは、名前を呼ばなくても関連するアシスタントが参加することがあります。返信するアシスタントを選んで回答を作るため、あなたのメッセージ、仕事の説明、引用したメッセージ、最近のグループメッセージが AI サービスに送られることがあります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bạn nhờ được trợ lý của mình trong nhóm, và mọi người đều đọc được câu trả lời. Trong nhóm chỉ có bạn và các trợ lý, trợ lý phù hợp có thể tham gia dù không được gọi tên. Tin nhắn của bạn, mô tả công việc của trợ lý, một tin được trích dẫn và các tin gần đây có thể được gửi tới dịch vụ AI để chọn và soạn câu trả lời."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你能请自己的助理帮忙，群组里的所有人都能看到回复。在只有你和助理的群组中，即使没有点名，相关助理也可能参与。为了选择助理并准备回复，你的消息、助理的工作说明、一条引用消息和最近的群聊消息可能会发送给 AI 服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你能請自己的助理幫忙，群組裡的所有人都能看到回覆。在只有你和助理的群組中，即使沒有點名，相關助理也可能參與。為了選擇助理並準備回覆，你的訊息、助理的工作說明、一則引用訊息和最近的群組訊息可能會傳送給 AI 服務。"
          }
        }
      }
    },
    "src.matrix.group-picker-copy.copies.block.agentsFull": {
