{
  "sourceLanguage": "vi",
  "strings": {
    "desktop.atum.account.approvalsOff": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approvals are off: Atum acts without asking. Turn them on from the status bar if you want to be asked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認はオフです。Atum は確認せずに動作します。確認が必要な場合はステータスバーからオンにしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tắt hỏi quyền: Atum tự hành động mà không hỏi. Bật lại từ thanh trạng thái nếu bạn muốn được hỏi."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "审批已关闭：Atum 会直接执行而不询问。如需询问，请在状态栏中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准已關閉：Atum 會直接執行而不詢問。如需詢問，請在狀態列中開啟。"
          }
        }
      }
    },
    "desktop.atum.account.changePhoto": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change photo"
