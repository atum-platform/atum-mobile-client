    "shared.matrix-action-copy.matrixActionCopy.promptDeadlineEnded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time’s up. Waiting for your assistant to finish."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間切れです。アシスタントの完了を待っています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hết giờ. Đang chờ trợ lý hoàn tất."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "时间到了。正在等待助手完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間到了。正在等待助理完成。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.promptTurnExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time ran out while waiting for your answer. This request won’t run again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答を待つ間に時間切れになりました。この要求は再実行されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hết thời gian chờ bạn trả lời. Yêu cầu này sẽ không chạy lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "等待你回答时已超时。此请求不会再次运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待你回答時已逾時。此要求不會再次執行。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.replyQuoteUnreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn’t read the message you replied to — could you say it again?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信先のメッセージを読み取れませんでした。もう一度送ってもらえますか？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình chưa đọc được tin nhắn bạn đang trả lời — bạn nhắn lại giúp mình nhé?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "我没能读到你回复的那条消息，能再说一遍吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我沒能讀到你回覆的那則訊息，能再說一遍嗎？"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.runHermes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your assistant"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントに頼む"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi trợ lý"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "询问助手"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詢問助理"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.attachmentUnsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can’t open attachments in chat yet. Paste the text, or save the file to Atum Drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットの添付ファイルはまだ開けません。内容を貼り付けるか、Atum Drive に保存してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình chưa mở được tệp đính kèm trong chat. Bạn dán nội dung hoặc lưu vào Atum Drive nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时还不能打开聊天里的附件。请粘贴文字内容，或把文件存到 Atum Drive。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時還不能開啟聊天裡的附件。請貼上文字內容，或把檔案存到 Atum Drive。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.couldntConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This was cut off partway, so only part of it may be done. I won’t redo it on my own, so it doesn’t happen twice. Say “check again” and I’ll look at how far it got."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "途中で中断されたため、一部しか終わっていない可能性があります。二重に実行しないよう、自動ではやり直しません。「もう一度確認して」と送っていただければ、どこまで進んだか確認します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này bị ngắt giữa chừng nên có thể mới làm được một phần. Mình không tự làm lại để khỏi làm hai lần. Bạn nhắn “kiểm tra lại” để mình xem đã xong đến đâu nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这件事中途被打断，可能只完成了一部分。为避免重复执行，我不会自动重做。发送“再检查一下”，我会看看做到哪一步了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這件事中途被打斷，可能只完成了一部分。為避免重複執行，我不會自動重做。傳送「再檢查一下」，我會看看做到哪一步了。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.couldntVerifyMac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn’t verify which Mac sent this, so I didn’t do anything."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この依頼を送った Mac を確認できなかったため、何も実行していません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình không xác minh được máy Mac đã gửi tin này nên chưa làm gì cả."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认是哪台 Mac 发送了这条消息，所以没有执行任何操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認是哪台 Mac 傳送了這則訊息，所以沒有執行任何操作。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.deadline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This took too long, so I stopped. Try asking for a smaller piece."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間がかかりすぎたため停止しました。依頼を小さく分けてお試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này mất quá lâu nên mình đã dừng. Bạn thử chia nhỏ yêu cầu nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这件事用时太长，我已停止。可以把请求拆小一些再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這件事花太久了，我已停止。可以把請求拆小一些再試。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong, so I couldn’t finish this. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラーが発生したため完了できませんでした。もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có lỗi nên mình chưa làm xong việc này. Bạn thử lại nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题，没能完成。请再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出了點問題，沒能完成。請再試一次。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.mayHaveRun": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " What was done may be on %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行済みの分は %1$@ にある可能性があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": " Phần đã làm có thể nằm trên %1$@."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的部分可能在 %1$@ 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的部分可能在 %1$@ 上。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.memoryNotSaved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(I couldn’t save what I learned this time.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（今回覚えたことは保存できませんでした。）"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "(Mình chưa lưu được điều vừa học từ lần này.)"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "（这次学到的内容没能保存。）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（這次學到的內容沒能儲存。）"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.queueFull": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests are waiting, so I didn’t take this one. Try again in a few minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中の依頼が多すぎるため、受け付けませんでした。数分後にもう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang có quá nhiều yêu cầu chờ nên mình chưa nhận thêm. Bạn thử lại sau ít phút nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "等待中的请求太多，这次没有接收。请几分钟后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待中的請求太多，這次沒有接收。請幾分鐘後再試。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.replyUnreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can’t read the message you replied to. Please send its text again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信先のメッセージを読めません。内容をもう一度送ってください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình không đọc được tin nhắn bạn đang trả lời. Bạn gửi lại nội dung đó nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "回复的消息无法读取。请重新发送消息内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆的訊息無法讀取。請重新傳送訊息內容。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.resumingOnDevice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is back online. Doing it now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ がオンラインに戻りました。今から実行します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã trực tuyến trở lại. Mình làm ngay đây."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已重新上线，现在就开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已重新上線，現在就開始。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.saveUnconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The save was interrupted, so it’s unclear whether the file reached Atum Drive. I won’t save it again so there’s no duplicate; please take a look in Atum Drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存が中断されたため、ファイルが Atum Drive に入ったかどうか分かりません。重複しないよう再保存はしないので、Atum Drive をご確認ください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc lưu tệp bị gián đoạn nên chưa rõ tệp đã vào Atum Drive chưa. Mình không lưu lại lần nữa để khỏi trùng; bạn mở Atum Drive xem giúp mình nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "保存被中断了，不清楚文件是否已进入 Atum Drive。为避免重复，我不会再保存一次，请到 Atum Drive 里看看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存被中斷了，不清楚檔案是否已進入 Atum Drive。為避免重複，我不會再儲存一次，請到 Atum Drive 裡看看。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.savedAsCopy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file changed while I worked, so I saved a copy next to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中にファイルが変更されたため、隣にコピーを保存しました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp đã thay đổi trong lúc mình làm, nên mình lưu thêm một bản bên cạnh."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "我处理期间文件有变动，所以在旁边另存了一份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我處理期間檔案有變動，所以在旁邊另存了一份。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.savedToDrive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved to Atum Drive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum Drive に保存しました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu vào Atum Drive."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存到 Atum Drive。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存到 Atum Drive。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.stopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止しました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dừng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.threadUnsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don’t answer inside threads. Send it as a new message."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スレッド内には返信しません。新しいメッセージとして送ってください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình không trả lời trong chuỗi tin nhắn. Bạn gửi thành tin nhắn mới nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "我不在话题串里回复。请作为新消息发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我不在討論串裡回覆。請以新訊息傳送。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.trialExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can’t answer because your Atum trial has ended. Scheduled tasks are paused too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum の無料体験が終了したため、返信できません。定期タスクも停止しています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình chưa trả lời được vì thời gian dùng thử Atum đã hết. Các việc định kỳ cũng tạm dừng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Atum 试用已结束，我暂时无法回复，定时任务也已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Atum 試用已結束，我暫時無法回覆，排程工作也已暫停。"
          }
        }
      }
    },
    "shared.matrix-agent-status-copy.matrixAgentStatusCopy.unfunded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can’t answer because your account has no Atum allowance left right now. Scheduled tasks are paused too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントには現在 Atum の利用枠が残っていないため、返信できません。定期タスクも停止しています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình chưa trả lời được vì tài khoản hiện không còn lượt dùng Atum. Các việc định kỳ cũng tạm dừng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户目前没有可用的 Atum 额度，我暂时无法回复，定时任务也已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帳號目前沒有可用的 Atum 額度，我暫時無法回覆，排程工作也已暫停。"
          }
        }
      }
    },
