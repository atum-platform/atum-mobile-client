    "shared.matrix-debug-share-copy.matrixDebugShareCopy.pasteRetention": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "paste.rs: deletion is attempted after six hours by a future cleanup run. It is best effort and may never run."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "paste.rs：将来のクリーンアップで六時間後の削除を試みます。実行や削除は保証されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "paste.rs: lần dọn dẹp sau sẽ thử xóa sau sáu giờ. Không bảo đảm lần đó sẽ chạy hoặc xóa thành công."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "paste.rs：未来的清理任务会尝试在六小时后删除。不保证任务执行或删除成功。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "paste.rs：未來的清理工作會嘗試在六小時後刪除。不保證工作執行或刪除成功。"
          }
        }
      }
    },
    "shared.matrix-debug-share-copy.matrixDebugShareCopy.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture local preview"
          }
        },
        "ja": {
