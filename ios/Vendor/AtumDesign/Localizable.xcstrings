    "desktop.atum.awareness.settings.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistants read your chats to help you, and you can turn this off for any chat in this list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントはあなたを手伝うために会話を読みますが、この一覧で会話ごとにオフにできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý của bạn đọc các cuộc trò chuyện để giúp bạn, và bạn có thể tắt việc này cho từng cuộc trò chuyện trong danh sách này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "您的助手会阅读您的对话来帮助您，您可以在此列表中为任意对话关闭此功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的助理會閱讀您的對話來協助您，您可以在此列表中為任一對話關閉此功能。"
          }
        }
