                      "state": "translated",
                      "value": "1 left."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%1$lld left."
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り%1$lld文字。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn %1$lld ký tự."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "还剩 %1$lld 个字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還剩 %1$lld 個字。"
          }
        }
