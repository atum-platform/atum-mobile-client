        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、無料のペットデザインは利用できません。1日の回数は%1$@にリセットされます。料金は発生していません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa thể thiết kế thú cưng miễn phí. Lượt thiết kế mỗi ngày được làm mới lúc %1$@. Bạn chưa bị trừ Proton nào."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
