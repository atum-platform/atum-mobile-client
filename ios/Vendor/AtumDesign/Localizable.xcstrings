    "shared.matrix-app-chat-copy.matrixAppChatCopy.botStarting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is starting up. Messages will be answered when %1$@ is ready."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は起動中です。準備ができるとメッセージに返信します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang khởi động. Tin nhắn sẽ được trả lời khi %1$@ sẵn sàng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 正在启动。准备就绪后会回复消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 正在啟動。準備就緒後會回覆訊息。"
          }
        }
      }
    },
    "shared.matrix-app-chat-copy.matrixAppChatCopy.botUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is resting. When %1$@ is back, it answers messages sent up to 30 minutes earlier; please resend anything older."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は一時的に利用できません。戻ったときは過去30分のメッセージに返信します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang tạm nghỉ. Khi %1$@ quay lại, tin nhắn gửi trong vòng 30 phút trước đó sẽ được trả lời; tin cũ hơn thì bạn gửi lại nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 暂时不可用。恢复后会回复过去30分钟内发送的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 暫時無法使用。恢復後會回覆過去30分鐘內傳送的訊息。"
          }
        }
      }
    },
    "shared.matrix-app-chat-copy.matrixAppChatCopy.botUntrusted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ can't be reached safely right now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在 %1$@ と安全に会話できません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể trò chuyện an toàn với %1$@ lúc này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
