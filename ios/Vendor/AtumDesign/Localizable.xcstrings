    },
    "shared.matrix-approval-copy.copies.noOtherDevice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don’t have another device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの端末がない"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi không còn máy nào khác"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "我没有其他设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我沒有其他裝置"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.noOtherDeviceHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the recovery key you saved, usually in a password manager or your notes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した復旧キーを使ってください。多くの場合、パスワード管理アプリやメモにあります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng khóa khôi phục bạn đã lưu, thường trong trình quản lý mật khẩu hoặc ghi chú."
          }
        },
        "zh": {
