    },
    "src.matrix.assistant-card.copy.assistantCardCopies.problems.checkMark": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name can’t include a check mark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前にチェックマークは使えません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên không được có dấu tích."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "名字里不能有勾号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名字裡不能有勾號。"
          }
        }
      }
    },
    "src.matrix.assistant-card.copy.assistantCardCopies.problems.duplicate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have an assistant named %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@という名前のアシスタントがすでにいます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
