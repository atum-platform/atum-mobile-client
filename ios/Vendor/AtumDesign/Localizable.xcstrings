    "desktop.dm.group.create.privateDisclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps and agents use private context only in this owner-only meeting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この所有者だけのミーティングでのみ、アプリとエージェントは非公開のコンテキストを使います。"
