    "shared.matrix-curator-copy.matrixCuratorCopy.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No run receipt is available. After a restart, this does not prove no changes were made."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行記録はありません。再起動後は、変更がなかったことの証明にはなりません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có biên nhận lần chạy. Sau khi khởi động lại, điều này không chứng minh chưa có thay đổi."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有运行记录。重启后，这不代表未发生任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有執行記錄。重新啟動後，這不代表未發生任何變更。"
          }
        }
      }
    },
    "shared.matrix-curator-copy.matrixCuratorCopy.warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenance may archive some of this agent’s skills and can cost extra with your model provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンテナンスでは、このアシスタントのスキルの一部がアーカイブされることがあり、モデル提供元の追加料金がかかる場合があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảo trì có thể lưu trữ một số kỹ năng của trợ lý này và có thể phát sinh thêm phí với nhà cung cấp mô hình."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "维护可能会归档此助理的部分技能，并可能产生模型服务商的额外费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "維護可能會封存此助理的部分技能，並可能產生模型供應商的額外費用。"
          }
        }
      }
    },
