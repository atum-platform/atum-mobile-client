    "shared.matrix-action-copy.matrixActionCopy.actionSetupRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was run. Finish setting up your model first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も実行していません。先にモデルの設定を完了してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa chạy gì. Hãy thiết lập mô hình trước."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "未运行任何内容。请先完成模型设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未執行任何內容。請先完成模型設定。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.actionUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This was cut off partway, so only part of it may be done. I won’t redo it on my own, so it doesn’t happen twice. Look at what’s already done, then tell me if you want me to carry on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "途中で中断されたため、一部しか終わっていない可能性があります。二重に実行しないよう、自動ではやり直しません。済んだ内容をご確認のうえ、続けたいときはお知らせください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này bị ngắt giữa chừng nên có thể mới làm được một phần. Mình không tự làm lại để khỏi làm hai lần. Bạn xem phần đã xong, rồi nhắn mình nếu muốn làm tiếp nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这件事中途被打断，可能只完成了一部分。为避免重复执行，我不会自动重做。请先看看已完成的内容，需要继续时告诉我。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這件事中途被打斷，可能只完成了一部分。為避免重複執行，我不會自動重做。請先看看已完成的內容，需要繼續時告訴我。"
          }
        }
      }
    },
