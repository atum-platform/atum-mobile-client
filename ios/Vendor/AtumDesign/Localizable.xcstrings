        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý làm việc trên máy Mac của bạn. Những gì trợ lý được làm ở đó được đặt trên chính máy Mac ấy."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手在你的 Mac 上工作。它们在那里可以做什么，由那台 Mac 来设置。"
