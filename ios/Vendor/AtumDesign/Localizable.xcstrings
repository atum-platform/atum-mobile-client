    "desktop.atum.account.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The information currently connected to Atum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在 Atum に接続されている情報です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin hiện đang được kết nối với Atum."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "当前连接到 Atum 的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前連接至 Atum 的資訊。"
          }
        }
      }
    },
    "desktop.atum.account.disconnect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連携を解除"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngắt kết nối"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "断开连接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷連結"
          }
        }
      }
    },
    "desktop.atum.account.disconnectComplete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected from Atum. App sign-out is complete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum との接続を解除し、アプリのセッションからサインアウトしました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ngắt kết nối với Atum và đăng xuất phiên ứng dụng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已断开 Atum 连接并退出应用会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已中斷 Atum 連線並登出應用程式工作階段。"
          }
        }
      }
    },
    "desktop.atum.account.disconnectConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect %1$@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ との連携を解除しますか？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngắt kết nối %1$@?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "要断开与 %1$@ 的连接吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要中斷與 %1$@ 的連結嗎？"
          }
        }
      }
    },
    "desktop.atum.account.disconnectFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't disconnect. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連携を解除できませんでした。もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa ngắt được kết nối. Vui lòng thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法断开连接。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法中斷連結，請再試一次。"
          }
        }
      }
    },
    "desktop.atum.account.disconnectHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chat history will be kept. If you only access this app through Atum, add a sign-in method in the app’s profile first so you can return later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット履歴は残ります。このアプリに Atum 経由でしか入っていない場合は、あとで戻れるように、先にアプリのプロフィールでログイン方法を追加してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử trò chuyện vẫn được giữ lại. Nếu chỉ vào ứng dụng qua Atum, hãy thêm cách đăng nhập trong hồ sơ của ứng dụng trước để có thể quay lại sau."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天记录会保留。如果你只通过 Atum 访问此应用，请先在应用的个人资料中添加登录方式，以便日后返回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天紀錄會保留。如果你只透過 Atum 使用這個應用程式，請先在應用程式的個人檔案中新增登入方式，之後才能再回來。"
          }
        }
      }
    },
    "desktop.atum.account.disconnectLocalPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected from Atum. Local app data could not be cleared. The app view remains closed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum との接続を解除しました。この端末のアプリデータを削除できませんでした。アプリ画面は閉じたままです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ngắt kết nối với Atum. Chưa thể xóa dữ liệu ứng dụng trên máy này. Cửa sổ ứng dụng vẫn đóng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已断开 Atum 连接。无法清除此设备上的应用数据，应用视图将保持关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已中斷 Atum 連線。無法清除此裝置上的應用程式資料，應用程式畫面將保持關閉。"
          }
        }
      }
    },
    "desktop.atum.account.disconnectPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected from Atum. App sign-out is still unconfirmed; check the app’s connection status again shortly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum との接続を解除しました。アプリのサインアウトは未確認です。しばらくしてから接続状態を確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ngắt kết nối với Atum. Chưa xác nhận đăng xuất phiên ứng dụng; hãy kiểm tra lại trạng thái kết nối sau ít phút."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已断开 Atum 连接。应用退出尚未确认，请稍后再次检查连接状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已中斷 Atum 連線。應用程式登出尚未確認，請稍後再次檢查連線狀態。"
          }
        }
      }
    },
