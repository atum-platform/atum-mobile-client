    "src.matrix.copy.copies.enrollmentUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting didn’t finish. Try Disconnect again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続の解除が完了しませんでした。もう一度「接続を解除」をお試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngắt kết nối chưa hoàn tất. Hãy thử Ngắt kết nối lần nữa."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "断开连接未完成。请再次点击“断开连接”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷連線未完成。請再次點選「中斷連線」。"
          }
        }
      }
    },
    "src.matrix.copy.copies.enrollmentUnresolved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting didn’t finish. Connect again, or disconnect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が完了しませんでした。もう一度接続するか、接続を解除してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối chưa hoàn tất. Hãy kết nối lại hoặc ngắt kết nối."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "连接未完成。请重新连接，或断开连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線未完成。請重新連線，或中斷連線。"
          }
        }
      }
    },
    "src.matrix.copy.copies.enrollmentWithdrawn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac can no longer run this assistant. Your chats and saved setup are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでは、このアシスタントを実行する権限がありません。チャットと保存済みの設定は保持されています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac này không còn được phép chạy trợ lý này. Các cuộc trò chuyện và thiết lập đã lưu vẫn được giữ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已无权运行此助手。聊天和已保存的设置仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 已無權執行此助理。聊天和已儲存的設定仍會保留。"
          }
        }
      }
    },
    "src.matrix.copy.copies.enrollmentWorking": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating… continue in your browser if asked."
          }
