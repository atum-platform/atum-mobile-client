    "shared.matrix-command-center-ops-copy.matrixMaintenanceCopy.doctorHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check this agent’s setup. May check configured services and network connectivity. Does not apply automatic fixes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアシスタントの設定を確認します。設定済みサービスやネットワーク接続を確認する場合があります。自動修正は行いません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra thiết lập của trợ lý này. Có thể kiểm tra dịch vụ đã cấu hình và kết nối mạng. Không tự động sửa lỗi."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "检查此助手的设置。可能检查已配置的服务和网络连接。不会自动修复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查此助理的設定。可能檢查已設定的服務和網路連線。不會自動修復。"
          }
        }
      }
    },
