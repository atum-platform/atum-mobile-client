    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.timedOut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That took too long. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間がかかりすぎました。もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chờ quá lâu. Bạn thử lại nhé."
          }
        },
        "zh": {
          "stringUnit": {
