    "shared.matrix-pages-copy.copy.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install for %1$@ on this Mac. Skills can include instructions and executable files. Only install sources you trust.\n\n%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の %1$@ にインストールします。スキルには指示や実行可能ファイルが含まれる場合があります。信頼できるソースのみをインストールしてください。\n\n%2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt cho %1$@ trên máy Mac này. Kỹ năng có thể chứa hướng dẫn và tệp thực thi. Chỉ cài đặt từ nguồn bạn tin cậy.\n\n%2$@"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "为此 Mac 上的 %1$@ 安装。技能可能包含指令和可执行文件。请仅安装您信任的来源。\n\n%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為此 Mac 上的 %1$@ 安裝。技能可能包含指令及可執行檔案。請只安裝您信任的來源。\n\n%2$@"
          }
        }
      }
    },
