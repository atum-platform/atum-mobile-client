    "desktop.dm.signInLocal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum couldn't complete sign-in on this device. Restart Atum and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでサインインを完了できませんでした。Atum を再起動して、もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum không thể hoàn tất đăng nhập trên thiết bị này. Khởi động lại Atum rồi thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 无法在此设备上完成登录。请重启 Atum 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 無法在此裝置上完成登入。請重新啟動 Atum 後重試。"
          }
        }
      }
    },
    "desktop.dm.signInNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum couldn't connect to verify your saved sign-in. Check your connection and retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたログインを確認するために接続できませんでした。ネットワークを確認して再試行してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum chưa kết nối được để xác minh phiên đăng nhập đã lưu. Kiểm tra kết nối mạng rồi thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 无法连接以验证已保存的登录。请检查网络后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 無法連線以驗證已儲存的登入。請檢查網路後重試。"
          }
        }
      }
    },
    "desktop.dm.signInOffline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't connect. Check your network and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できません。ネットワークを確認して、もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không kết nối được. Kiểm tra mạng rồi thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接，请检查网络后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連線，請檢查網路後再試一次。"
          }
        }
      }
    },
    "desktop.dm.signInPlatform": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum couldn't open your account safely on this device. Restart Atum and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでアカウントを安全に開けませんでした。Atum を再起動して、もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum không thể mở tài khoản an toàn trên thiết bị này. Khởi động lại Atum rồi thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 无法在此设备上安全打开你的账户。请重启 Atum 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 無法在此裝置上安全開啟你的帳戶。請重新啟動 Atum 後重試。"
          }
        }
      }
    },
    "desktop.dm.signInProviderDown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in is temporarily unavailable. Try again in a few minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインは一時的に利用できません。数分後にもう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập tạm thời không khả dụng. Thử lại sau ít phút."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "登录暂时不可用，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入暫時無法使用，請稍後再試。"
          }
        }
      }
    },
    "desktop.dm.signInRetry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試す"
