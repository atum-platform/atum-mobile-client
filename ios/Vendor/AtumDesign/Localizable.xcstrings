        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối đã hết hạn. Hãy kết nối lại để gia hạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "连接已过期。请重新连接以续期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線已過期。請重新連線以續期。"
          }
        }
      }
    },
    "src.matrix.copy.copies.enrollmentHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets your assistant read the chats it’s in. Connecting doesn’t run anything or give it new permissions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントが参加しているチャットを読めるようにします。接続しても何も実行されず、新しい権限も与えません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép trợ lý đọc các cuộc trò chuyện mà trợ lý tham gia. Kết nối không chạy gì và không cấp thêm quyền."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "让助手可以读取它所在的聊天。连接不会运行任何操作，也不会授予新权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓助理可以讀取它所在的聊天。連線不會執行任何操作，也不會授予新權限。"
          }
        }
      }
    },
    "src.matrix.copy.copies.enrollmentLoadError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check the connection on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacの接続状態を確認できませんでした。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa kiểm tra được kết nối trên Mac này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查这台 Mac 上的连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查這台 Mac 上的連線。"
          }
        }
      }
    },
    "src.matrix.copy.copies.enrollmentOrphaned": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An earlier assistant setup needs cleaning up by Atum support. Nothing is lost, and you can keep using Atum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のアシスタント設定の後片付けがAtumサポートで必要です。データは失われておらず、Atumはそのまま使えます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần thiết lập trợ lý trước đây cần bộ phận hỗ trợ của Atum dọn dẹp. Không có gì bị mất, và bạn vẫn dùng Atum bình thường."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的一次助手设置需要 Atum 支持团队清理。没有任何内容丢失，你可以继续使用 Atum。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先前的一次助理設定需要 Atum 支援團隊清理。沒有任何內容遺失，你可以繼續使用 Atum。"
          }
        }
      }
    },
    "src.matrix.copy.copies.enrollmentReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected on this Mac"
