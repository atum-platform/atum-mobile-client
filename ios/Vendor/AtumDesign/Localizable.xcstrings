    "desktop.atum.account.handleFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not check. Check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認できませんでした。接続を確認して、もう一度お試しください。"
