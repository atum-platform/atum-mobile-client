    "src.matrix.mobile-device-copy.mobileDeviceCopy.revokeCloudBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cloud assistant will stop receiving new work. Your conversations and recovery key stay on this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドアシスタントは新しい作業を受け取らなくなります。会話と復旧キーはこのiPhoneに残ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý trên đám mây sẽ không nhận công việc mới. Các cuộc trò chuyện và khóa khôi phục vẫn ở trên iPhone này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "云端助理将不再接收新工作。你的对话和恢复密钥仍保留在此 iPhone 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端助理將不再接收新工作。你的對話和復原金鑰仍保留在這部 iPhone 上。"
          }
        }
      }
    },
