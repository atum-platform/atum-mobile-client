    "shared.matrix-device-isolation-copy.matrixDeviceIsolationCopy.changedAgain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The identity changed again. Review the current identity before continuing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ID が再び変わりました。続行前に現在の ID を確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh tính lại thay đổi. Hãy kiểm tra danh tính hiện tại trước khi tiếp tục."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "身份再次更改。请先核对当前身份再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "身分再次變更。請先核對目前身分再繼續。"
          }
        }
      }
    },
    "shared.matrix-device-isolation-copy.matrixDeviceIsolationCopy.compareHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the symbols with this person in the verification prompt. Confirm only when they match."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認画面の記号を相手と比較し、一致する場合のみ承認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đối chiếu các biểu tượng với người đó trong yêu cầu xác minh. Chỉ xác nhận khi khớp."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在验证提示中与本人比较符号，仅在一致时确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在驗證提示中與本人比較符號，僅在一致時確認。"
          }
        }
      }
    },
    "shared.matrix-device-isolation-copy.matrixDeviceIsolationCopy.confirmIdentity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I compared this identity"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この ID を比較しました"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã đối chiếu danh tính này"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "我已比较此身份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我已比較此身分"
          }
        }
      }
    },
    "shared.matrix-device-isolation-copy.matrixDeviceIsolationCopy.continueHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the previous verification requirement for this person. Their devices still need to be signed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この相手への以前の確認要件を解除します。デバイスには引き続き ID の署名が必要です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ yêu cầu xác minh trước đây cho người này. Thiết bị của họ vẫn phải được danh tính ký."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此人先前的验证要求，其设备仍须由身份签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除此人先前的驗證要求，其裝置仍須由身分簽署。"
          }
        }
      }
    },
    "shared.matrix-device-isolation-copy.matrixDeviceIsolationCopy.continueWithoutVerification": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue without previous verification"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の確認を要求せず続ける"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục không dùng xác minh trước đây"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "不要求先前验证并继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要求先前驗證並繼續"
          }
        }
      }
    },
    "shared.matrix-device-isolation-copy.matrixDeviceIsolationCopy.group": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other people’s unverified devices cannot read new messages while strict device trust is on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳格な信頼がオンの間、相手の未確認デバイスは新しいメッセージを読めません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị chưa được xác minh của người khác không đọc được tin mới khi bật chế độ tin cậy nghiêm ngặt."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "开启严格设备信任时，其他人的未验证设备无法读取新消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟嚴格裝置信任時，其他人的未驗證裝置無法讀取新訊息。"
          }
        }
      }
    },
    "shared.matrix-device-isolation-copy.matrixDeviceIsolationCopy.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only devices signed by their identity can send or receive new messages. Off by default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の ID で署名されたデバイスだけが新しいメッセージを送受信できます。初期設定はオフです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ thiết bị được danh tính của mình ký mới gửi hoặc nhận được tin mới. Mặc định tắt."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "只有被其身份签名的设备才能收发新消息。默认关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有經其身分簽署的裝置才能收發新訊息。預設關閉。"
          }
        }
      }
    },
    "shared.matrix-device-isolation-copy.matrixDeviceIsolationCopy.identityChanged": {
