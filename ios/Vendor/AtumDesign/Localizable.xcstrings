    "desktop.atum.awareness.settings.forgottenDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgotten. Earlier indexed content stays forgotten even if you include this conversation later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "忘れました。この会話を後で再び含めても、以前にインデックス化された内容は忘れたままです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã quên. Nội dung đã được lập chỉ mục trước đó vẫn bị quên, ngay cả khi bạn đưa cuộc trò chuyện này vào lại sau này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已忘记。即使您之后再次包括这段对话，先前已建立索引的内容仍会保持忘记状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已忘記。即使您之後再次納入這段對話，先前已建立索引的內容仍會保持忘記狀態。"
          }
        }
      }
    },
