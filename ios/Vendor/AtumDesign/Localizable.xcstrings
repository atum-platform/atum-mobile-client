    "src.matrix.conversation-copy.copies.historyNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving or removal stops future participation. Messages already received cannot be taken back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "退出や削除で今後の参加は停止します。受信済みのメッセージは取り消せません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rời hoặc bị xóa sẽ ngừng tham gia về sau. Không thể thu hồi tin nhắn đã nhận."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "离开或移除会停止今后的参与。已收到的消息无法收回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離開或移除會停止今後的參與。已收到的訊息無法收回。"
          }
        }
      }
    },
