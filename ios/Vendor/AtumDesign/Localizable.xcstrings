          "stringUnit": {
            "state": "translated",
            "value": "公司檔案正在準備中。請稍後再試。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.companyFileUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum Drive is unavailable for this company file right now. Try again; Atum will resume the same file instead of creating a duplicate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、この会社ファイルでは Atum Drive を利用できません。もう一度試すと、重複を作らず同じファイルから再開します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum Drive hiện chưa dùng được cho tệp công ty này. Hãy thử lại; Atum sẽ tiếp tục đúng tệp đó thay vì tạo bản trùng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum Drive 暂时无法处理此公司文件。请重试；Atum 会继续处理同一文件，不会创建重复文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum Drive 暫時無法處理此公司檔案。請再試一次；Atum 會繼續處理同一檔案，不會建立重複檔案。"
          }
        }
      }
    },
