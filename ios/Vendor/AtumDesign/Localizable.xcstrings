          "stringUnit": {
            "state": "translated",
            "value": "購買未完成，未扣款。"
          }
        }
      }
    },
    "desktop.atum.discover.purchaseUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The store isn't taking purchases right now. Nothing was charged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアは現在購入を受け付けていません。請求は発生していません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa hàng hiện chưa nhận thanh toán. Bạn chưa bị trừ Proton nào."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "商店当前暂不接受购买。未产生任何扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商店目前暫不接受購買。未產生任何扣費。"
          }
        }
      }
    },
    "desktop.atum.discover.purchaseUncertain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Store hasn’t answered yet, so we don’t know if your Protons were used. Press Check status before paying again: if it went through you’ll see it; if not, you aren’t charged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアからまだ応答がなく、Proton が使われたかどうかは分かりません。再度購入する前に「状態を確認」を押してください。購入できていれば反映され、できていなければ請求されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa hàng chưa trả lời nên chưa biết Proton của bạn đã bị trừ hay chưa. Bấm Kiểm tra trạng thái trước khi mua lại: nếu đã thành công bạn sẽ thấy ngay, nếu chưa thì bạn không bị trừ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "商店暂时没有回应，目前还不知道你的 Proton 是否已被扣除。再次购买前请点“检查状态”：成功了会显示出来，没成功则不会扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商店暫時沒有回應，目前還不知道你的 Proton 是否已被扣除。再次購買前請點「檢查狀態」：成功了會顯示出來，沒成功則不會扣費。"
          }
        }
      }
    },
    "desktop.atum.discover.rateLimited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@seconds@"
          },
          "substitutions": {
            "seconds": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "You're searching a bit fast. Try again in 1 seconds."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "You're searching a bit fast. Try again in %1$lld seconds."
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索が少し速すぎます。%1$lld 秒後にもう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn tìm hơi nhanh. Thử lại sau %1$lld giây."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索太快了，请在 %1$lld 秒后重试。"
          }
