    "shared.matrix-company-copy.copy.projectSourcesDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one ready project channel and one published company file. The shared brief comes later; sources stay pending until the hosted reader is connected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備済みのプロジェクトチャンネル 1 件と公開済みの会社ファイル 1 件を選択します。共有ブリーフは後で追加され、ホスト型リーダーが接続されるまで保留になります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một kênh dự án đã sẵn sàng và một tệp công ty đã xuất bản. Bản tóm tắt chung sẽ có sau; nguồn ở trạng thái chờ đến khi trình đọc đám mây được kết nối."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个已就绪的项目频道和一个已发布的公司文件。共享简报将在后续提供；连接托管读取器前，来源会保持等待状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個已就緒的專案頻道和一個已發布的公司檔案。共享簡報將於後續提供；連接託管讀取器前，來源會維持等待狀態。"
          }
        }
      }
    },
    "shared.matrix-company-copy.copy.projectSourcesDisabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Company brain sources are turned off for now. Your last change is kept and can be retried when sources return."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会社ブレインのソースは一時的にオフです。最後の変更は保持され、ソースが戻ったら再試行できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn cho bộ não công ty đang tạm tắt. Thay đổi gần nhất vẫn được giữ và có thể thử lại khi nguồn hoạt động trở lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "公司大脑来源暂时关闭。你最近的更改已保留，可在来源恢复后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公司大腦來源暫時關閉。你最近的變更已保留，可在來源恢復後重試。"
          }
        }
      }
    },
