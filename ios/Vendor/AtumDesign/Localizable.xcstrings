        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng và trợ lý của bạn chỉ dùng ngữ cảnh riêng trong cuộc họp chỉ dành cho bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
