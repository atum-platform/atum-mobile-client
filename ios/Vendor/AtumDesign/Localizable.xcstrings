        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "正在从备份恢复…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在從備份還原…"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.decryption.reasons.sender_identity_changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sender has a new identity since you verified them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認後に送信者のIDが変わりました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người gửi có danh tính mới kể từ khi bạn xác minh họ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "发送方的身份在你验证后发生了变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送方的身分在你驗證後發生了變化。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.decryption.reasons.sender_unverified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent from a device that isn’t verified, so Atum didn’t read it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未確認の端末から送信されたため、Atumはこのメッセージを読みませんでした。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin được gửi từ thiết bị chưa xác minh nên Atum không đọc."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "消息来自未经验证的设备，因此 Atum 没有读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息來自未經驗證的裝置，因此 Atum 沒有讀取。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.decryption.reasons.this_device_unverified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sender’s device held this back until this Mac is verified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacが確認されるまで、送信者の端末がこのメッセージを保留しています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị của người gửi giữ lại tin này đến khi máy này được xác minh."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "发送方设备暂不分享此消息，直到这台 Mac 通过验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送方裝置暫不分享此訊息，直到這台 Mac 通過驗證。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.decryption.reasons.waiting_for_key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the key. This usually fixes itself when the sender’s device is online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵を待っています。送信者の端末がオンラインになると、通常は解消されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ khóa. Thường sẽ đọc được khi thiết bị của người gửi trực tuyến."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待密钥。发送方设备上线后通常会自行恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待金鑰。傳送方裝置上線後通常會自行恢復。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.decryption.reasons.withheld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sender chose not to share this message with this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信者はこのMacとメッセージを共有しないことを選びました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người gửi chọn không chia sẻ tin này với máy này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "发送方选择不与这台 Mac 分享此消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送方選擇不與這台 Mac 分享此訊息。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.deleteBotChatBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your messages with %1$@ are kept. Open %1$@ again any time to carry on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@とのメッセージは残ります。いつでも%1$@を開けば続きから話せます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn với %1$@ vẫn được giữ lại. Mở lại %1$@ bất cứ lúc nào để trò chuyện tiếp."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "与%1$@的消息会保留。随时再打开%1$@即可接着聊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與%1$@的訊息會保留。隨時再打開%1$@即可接著聊。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.deleteChat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete chat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットを削除"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa cuộc trò chuyện"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "删除对话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除對話"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.deleteChatBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It disappears from your chat list on all your devices. Others in the chat keep their copy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスのチャット一覧から消えます。ほかの参加者の手元には残ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện sẽ biến mất khỏi danh sách trên mọi thiết bị của bạn. Những người khác trong cuộc trò chuyện vẫn giữ bản của họ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从你所有设备的对话列表中消失。对话中的其他人仍会保留他们的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會從你所有裝置的對話清單中消失。對話中的其他人仍會保留他們的副本。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.deleteChatTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this chat?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットを削除しますか？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa cuộc trò chuyện này?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "删除这个对话？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除這個對話？"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.deleteMessageAssistantNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ may still remember what it saw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は読んだ内容をまだ覚えている場合があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ có thể vẫn nhớ nội dung đã đọc."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 可能仍会记得它读到的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 可能仍會記得它讀到的內容。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.deleteMessageBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It disappears for everyone in this chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットの全員の画面から消えます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn sẽ biến mất với mọi người trong cuộc trò chuyện."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这条消息会从对话中所有人那里消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這則訊息會從對話中所有人那裡消失。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.deleteMessageTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete for everyone?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員に対して削除しますか？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa với mọi người?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "为所有人删除？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為所有人刪除？"
          }
        }
