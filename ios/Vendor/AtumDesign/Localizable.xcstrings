        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local access is closed. Local key or server cleanup is still pending; check the connection and runtime, then retry Sign out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルアクセスは閉じました。ローカルキーまたはサーバーのクリーンアップが保留中です。接続と実行環境を確認してログアウトを再試行してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khóa truy cập cục bộ. Chưa xóa xong khóa cục bộ hoặc thu hồi trên máy chủ; kiểm tra kết nối và môi trường chạy rồi thử Đăng xuất lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "本地访问已关闭。本地密钥或服务器清理仍待完成；检查连接和运行环境后重试退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機存取已關閉。本機金鑰或伺服器清理仍待完成；檢查連線和執行環境後重試登出。"
          }
        }
      }
    },
