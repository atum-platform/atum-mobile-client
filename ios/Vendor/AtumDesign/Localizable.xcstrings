            "value": "ワークスペースにファイルを書き込む"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi tệp trong không gian làm việc"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在工作区中写入文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在工作區中寫入檔案"
          }
