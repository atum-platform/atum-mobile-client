    "src.matrix.drive-copy.matrixDriveCopy.about.skipped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum also skips files with “token” in the name, .env files, databases, and folders like .git and node_modules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前に「token」を含むファイル、.env ファイル、データベース、.git や node_modules などのフォルダーも同期されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum cũng bỏ qua tệp có chữ “token” trong tên, tệp .env, cơ sở dữ liệu và các thư mục như .git, node_modules."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 也会跳过名称含“token”的文件、.env 文件、数据库，以及 .git、node_modules 等文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 也會略過名稱含「token」的檔案、.env 檔案、資料庫，以及 .git、node_modules 等資料夾。"
          }
        }
      }
    },
