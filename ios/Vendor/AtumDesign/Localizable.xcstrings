        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "dpaste.com: yêu cầu hết hạn sau bảy ngày. Atum không thể xóa qua API."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "dpaste.com：请求七天后过期。Atum 无法通过其 API 删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "dpaste.com：要求七天後到期。Atum 無法透過其 API 刪除。"
          }
        }
      }
    },
    "shared.matrix-debug-share-copy.matrixDebugShareCopy.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not complete this request. If sharing had started, check status before sharing again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストを完了できません。共有を開始した場合は再共有前に状況を確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không hoàn tất yêu cầu. Nếu đã bắt đầu chia sẻ, hãy kiểm tra trạng thái trước khi chia sẻ lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成请求。如已开始共享，请先检查状态再重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成要求。如已開始分享，請先檢查狀態再重試。"
          }
        }
      }
    },
    "shared.matrix-debug-share-copy.matrixDebugShareCopy.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture a local preview from this agent. The report includes recent log tails; optional full logs are capped at their last 500 KB. Only selected, previewed text is uploaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアシスタントのローカルプレビューを作成します。レポートには最近のログを含み、任意の全ログは末尾 500 KB までです。選択してプレビューしたテキストのみを送信します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo bản xem trước cục bộ từ trợ lý này. Báo cáo có các dòng nhật ký gần đây; nhật ký đầy đủ tùy chọn giới hạn 500 KB cuối. Chỉ văn bản đã chọn và xem trước được tải lên."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "从此助手创建本地预览。报告包含最近日志；可选完整日志仅包含最后 500 KB。只上传已选择并预览的文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此智慧代理建立本機預覽。報告包含最近記錄；可選完整記錄僅包含最後 500 KB。只上傳已選擇並預覽的文字。"
          }
        }
      }
    },
    "shared.matrix-debug-share-copy.matrixDebugShareCopy.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中…"
