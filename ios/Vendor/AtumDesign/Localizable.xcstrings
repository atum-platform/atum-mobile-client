    "shared.matrix-debug-share-copy.matrixDebugShareCopy.uncertain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An upload response was lost or invalid. This file may already be public. Remaining files were not sent; no automatic retry or fallback occurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信応答が失われたか無効でした。このファイルは公開済みかもしれません。残りは送信せず、自動再試行や別サービスへの切替は行いません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phản hồi bị mất hoặc không hợp lệ. Tệp này có thể đã công khai. Chưa gửi các tệp còn lại; không tự thử lại hoặc đổi dịch vụ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "上传响应丢失或无效。此文件可能已公开。未发送剩余文件，也不会自动重试或切换服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳回應遺失或無效。此檔案可能已公開。未傳送剩餘檔案，也不會自動重試或切換服務。"
          }
        }
      }
    },
    "shared.matrix-debug-share-copy.matrixDebugShareCopy.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No upload receipt in this backend. A restart can lose the receipt; this does not prove that nothing was published."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックエンドに送信記録がありません。再起動で記録が失われても、非公開の証明にはなりません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ này không có biên nhận. Khởi động lại có thể mất biên nhận; điều này không chứng minh dữ liệu chưa được công bố."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此后端没有上传回执。重启可能丢失回执；这不代表未曾公开数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此後端沒有上傳收據。重新啟動可能遺失收據；這不代表未曾公開資料。"
          }
        }
      }
    },
    "shared.matrix-debug-share-copy.matrixDebugShareCopy.upload": {
