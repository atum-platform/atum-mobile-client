    "src.matrix.conversation-copy.copies.directMapping": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation was created, but its direct-message label could not be saved. Use the existing room; do not create it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話は作成されましたが、ダイレクトメッセージのラベルを保存できませんでした。再作成せず、既存のルームを使ってください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạo cuộc trò chuyện nhưng chưa lưu được nhãn tin nhắn riêng. Hãy dùng phòng đã tạo, không tạo lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "对话已创建，但私信标签未能保存。请使用现有房间，不要再次创建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話已建立，但私訊標籤未能儲存。請使用現有房間，不要再次建立。"
          }
        }
      }
    },
    "src.matrix.conversation-copy.copies.error": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not complete this action. Your input is kept; check the connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作を完了できませんでした。入力は保持されています。接続を確認して再試行してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thực hiện được. Nội dung nhập vẫn được giữ; kiểm tra kết nối rồi thử lại."
          }
        },
        "zh": {
