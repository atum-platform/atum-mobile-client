    "desktop.atum.managedModel.cancelFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum retried but could not stop this task. Check whether it is still running, then use Stop task again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum は再試行しましたが、このタスクを停止できませんでした。まだ実行中か確認してから、もう一度「タスクを停止」を選んでください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum đã thử lại nhưng chưa dừng được công việc này. Hãy kiểm tra xem nó còn chạy không rồi chọn Dừng công việc lần nữa."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 重试后仍无法停止此任务。请检查任务是否仍在运行，然后再次选择“停止任务”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 重試後仍無法停止此工作。請檢查工作是否仍在執行，然後再次選擇「停止工作」。"
          }
        }
      }
    },
