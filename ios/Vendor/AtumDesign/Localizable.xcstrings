    "shared.matrix-voice-settings-copy.matrixVoiceSettingsCopy.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings apply to your next recording or read-aloud. Audio starts only when you ask. Provider usage may have a cost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の録音や読み上げから適用されます。音声は操作した時だけ開始します。プロバイダーの利用には料金がかかる場合があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt áp dụng cho lần ghi âm hoặc đọc thành tiếng tiếp theo. Âm thanh chỉ bắt đầu khi bạn yêu cầu. Nhà cung cấp có thể tính phí sử dụng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "设置应用于下一次录音或朗读。只有你操作时才会开始音频。服务可能收取使用费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定套用於下一次錄音或朗讀。只有你操作時才會開始音訊。服務可能收取使用費用。"
          }
        }
      }
    },
