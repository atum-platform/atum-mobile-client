    "src.matrix.attention-copy.copies.deviceCompareHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue only if this device shows the same symbols as this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に、この Mac と同じ記号が表示されている場合にのみ続行してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tiếp tục nếu thiết bị này hiển thị các ký hiệu giống hệt trên Mac này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当这台设备显示的符号与这台 Mac 完全相同时才继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當這台裝置顯示的符號與這台 Mac 完全相同時才繼續。"
          }
        }
      }
    },
    "src.matrix.attention-copy.copies.deviceHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistants won’t answer messages sent from it until you verify it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証するまで、アシスタントはこの端末から送られたメッセージに応答しません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý sẽ chưa trả lời tin nhắn gửi từ thiết bị này cho đến khi bạn xác minh nó."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在你验证之前，助手不会回复从这台设备发送的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你驗證之前，助理不會回覆從這台裝置傳送的訊息。"
          }
        }
      }
    },
