    "src.matrix.chat-copy.copies.decryption.reasons.no_backup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent before this Mac joined, and there is no backup of it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacが参加する前に送信され、バックアップがありません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin được gửi trước khi máy này tham gia và không có bản sao lưu."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "消息在这台 Mac 加入前发送，且没有备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息在這台 Mac 加入前傳送，且沒有備份。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.decryption.reasons.restore_possible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent before this Mac joined. Restore your messages to read it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacが参加する前に送信されました。メッセージを復元すると読めます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin được gửi trước khi máy này tham gia. Khôi phục tin nhắn để đọc."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "消息在这台 Mac 加入前发送。恢复消息后即可读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息在這台 Mac 加入前傳送。還原訊息後即可讀取。"
          }
        }
      }
    },
    "src.matrix.chat-copy.copies.decryption.reasons.restoring": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring from your backup…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
