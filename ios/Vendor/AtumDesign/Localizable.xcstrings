    "src.matrix.security-copy.copies.keyShown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here is your recovery key. Save it now: it’s shown only once. Never send it in a chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これがあなたの復旧キーです。今すぐ保存してください。表示されるのは一度だけです。チャットで送らないでください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là khóa khôi phục của bạn. Hãy lưu ngay: khóa chỉ hiện một lần. Đừng bao giờ gửi khóa qua chat."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你的恢复密钥。请立即保存：它只显示这一次。切勿在聊天中发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是你的復原金鑰。請立即儲存：它只會顯示這一次。切勿在聊天中傳送。"
          }
        }
      }
    },
