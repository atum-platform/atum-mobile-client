    "desktop.atum.account.interactionPermissionsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions you answered “Always allow” for. Revoke one and Atum will ask again next time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「常に許可」と回答した操作です。取り消すと、次回から再度確認します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hành động bạn đã chọn “Luôn cho phép”. Thu hồi và Atum sẽ hỏi lại lần sau."
          }
        },
        "zh": {
          "stringUnit": {
