    "desktop.atum.agents.applyCloudHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud settings replace this assistant’s local settings and installed skills, then start a new chat. Current chats stay unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド設定はこのアシスタントのローカル設定とインストール済みスキルを置き換え、新しいチャットを開始します。現在のチャットは変更されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt đám mây sẽ thay cài đặt và kỹ năng đã cài của trợ lý này, rồi bắt đầu cuộc trò chuyện mới. Các cuộc trò chuyện hiện tại không đổi."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "云端设置会替换此助手的本地设置和已安装技能，并开始新对话。现有对话不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端設定會取代此助理的本機設定和已安裝技能，並開始新的對話。現有對話不會改變。"
          }
        }
      }
    },
