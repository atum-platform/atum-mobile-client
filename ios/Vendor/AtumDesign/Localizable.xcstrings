    "desktop.dm.group.create.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select people, apps, and agents. If this group already exists, it will open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人、アプリ、エージェントを選択してください。同じメンバーのグループがあれば開きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn mọi người, ứng dụng và trợ lý. Nếu nhóm này đã có, Atum sẽ mở nhóm đó."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "选择联系人、应用和智能体。如果已有相同成员的群组，将直接打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇聯絡人、應用程式和智慧體。如果已有相同成員的群組，將直接開啟。"
          }
        }
      }
    },
