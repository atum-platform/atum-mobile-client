    "shared.matrix-app-chat-copy.matrixAppChatCopy.pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reply is saved on this device but delivery is unconfirmed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信は端末に保存されていますが、配信は未確認です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phản hồi của ứng dụng đã được lưu trên máy này nhưng chưa gửi được vào cuộc trò chuyện. Bấm “Thử gửi lại phản hồi” để gửi."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "回复已保存在本设备上，但尚未确认送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆已儲存在本機，但尚未確認送達。"
          }
        }
      }
    },
    "shared.matrix-app-chat-copy.matrixAppChatCopy.plainReplyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ won't see the message you're replying to."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ には返信先のメッセージは表示されません。"
