    "desktop.atum.workspace.wordFullscreen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit full screen in Atum, then open the document again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum のフルスクリーンを終了してから再度開いてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thoát chế độ toàn màn hình của Atum rồi mở lại tài liệu."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请退出 Atum 的全屏模式后重新打开文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請退出 Atum 的全螢幕模式後重新開啟文件。"
          }
        }
      }
    },
    "desktop.atum.workspace.wordLiveContext": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat reads your current Word text, including unsaved edits. Requested text changes appear in Word; use Undo there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットは未保存の編集を含む現在の Word の本文を読み取ります。依頼した文章の変更は Word に反映され、Word で元に戻せます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trò chuyện đọc nội dung hiện tại, kể cả phần chưa lưu. Chỉnh sửa theo yêu cầu xuất hiện trong Word; bạn có thể hoàn tác tại đó."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天读取当前 Word 正文，包括未保存的编辑。按要求修改的文字会显示在 Word 中，可在 Word 中撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天讀取目前 Word 本文，包括未儲存的編輯。依要求修改的文字會顯示在 Word 中，可在 Word 中復原。"
          }
        }
      }
    },
    "desktop.atum.workspace.wordMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft Word is not installed. Install Word, then open the document again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft Word がインストールされていません。Word をインストールしてから再度開いてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cài Microsoft Word. Hãy cài Word rồi mở lại tài liệu."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安装 Microsoft Word。请安装 Word 后重新打开文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安裝 Microsoft Word。請安裝 Word 後重新開啟文件。"
          }
        }
      }
    },
    "desktop.atum.workspace.wordOpenError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not arrange this document beside Atum. Check Word for an open dialog, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum の横に文書を配置できませんでした。Word のダイアログを確認して再試行してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đặt tài liệu cạnh Atum. Kiểm tra hộp thoại đang mở trong Word rồi thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将文档排列在 Atum 旁边。请检查 Word 中打开的对话框后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將文件排列在 Atum 旁邊。請檢查 Word 中開啟的對話框後重試。"
          }
        }
      }
    },
