    "shared.matrix-pages-copy.scanCopy.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetch an isolated copy to inspect for %1$@ on this Mac. This does not install or run the skill. A scan is advisory, not a guarantee of safety.\n\n%2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の %1$@ のために隔離されたコピーを取得して検査します。スキルのインストールや実行は行いません。スキャン結果は参考情報であり、安全を保証するものではありません。\n\n%2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải một bản sao riêng để kiểm tra cho %1$@ trên máy Mac này. Thao tác này không cài đặt hoặc chạy kỹ năng. Kết quả chỉ mang tính tham khảo, không đảm bảo an toàn tuyệt đối.\n\n%2$@"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "为此 Mac 上的 %1$@ 获取隔离副本进行检查。这不会安装或运行技能。扫描结果仅供参考，不保证安全。\n\n%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為此 Mac 上的 %1$@ 取得隔離副本進行檢查。這不會安裝或執行技能。掃描結果僅供參考，不保證安全。\n\n%2$@"
          }
        }
      }
    },
