    "shared.matrix-auxiliary-copy.matrixAuxiliaryCopy.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a model for each supporting task. Automatic follows your main model. Changes apply to new supporting calls; current chats keep running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "補助タスクごとにモデルを選びます。自動はメインモデルを使います。変更は新しい補助呼び出しに適用され、現在の会話は継続します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn mô hình cho từng tác vụ hỗ trợ. Tự động dùng mô hình chính. Thay đổi áp dụng cho các lần gọi hỗ trợ mới; cuộc trò chuyện hiện tại vẫn tiếp tục."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "为每项辅助任务选择模型。自动会使用主模型。更改应用于新的辅助调用，当前对话继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每項輔助任務選擇模型。自動會使用主模型。變更套用於新的輔助呼叫，目前對話繼續執行。"
          }
        }
      }
    },
    "shared.matrix-auxiliary-copy.matrixAuxiliaryCopy.loadError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load supporting models. Try again."
