    "shared.matrix-alias-copy.copy.renameTextAgent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@’s bot handle becomes @%2$@. @%1$@ stays yours for 30 days, and the next change is possible in 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ のボットのハンドルは @%2$@ になります。@%1$@ は 30 日間あなたのために保持され、次の変更は 30 日後にできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên bot của %3$@ sẽ là @%2$@. @%1$@ vẫn được giữ cho bạn trong 30 ngày, và 30 ngày nữa mới đổi tiếp được."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@的机器人用户名将变为 @%2$@。@%1$@ 会为你保留 30 天，30 天后才能再次更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@的機器人使用者名稱將變為 @%2$@。@%1$@ 會為你保留 30 天，30 天後才能再次更改。"
          }
        }
      }
    },
    "shared.matrix-alias-copy.copy.renameTextSelf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your handle becomes @%2$@. @%1$@ stays yours for 30 days, and the next change is possible in 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのハンドルは @%2$@ になります。@%1$@ は 30 日間あなたのために保持され、次の変更は 30 日後にできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên công khai của bạn sẽ là @%2$@. @%1$@ vẫn được giữ cho bạn trong 30 ngày, và 30 ngày nữa mới đổi tiếp được."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的用户名将变为 @%2$@。@%1$@ 会为你保留 30 天，30 天后才能再次更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的使用者名稱將變為 @%2$@。@%1$@ 會為你保留 30 天，30 天後才能再次更改。"
          }
        }
      }
    },
