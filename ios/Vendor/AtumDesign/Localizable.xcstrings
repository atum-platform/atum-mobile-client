    "shared.matrix-approval-copy.copies.actionFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn’t go through. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいきませんでした。もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa làm được. Hãy thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有成功，请重试。"
          }
        },
        "zh-Hant": {
