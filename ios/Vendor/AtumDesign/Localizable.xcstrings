    "src.matrix.sign-in-copy.copies.vaultHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum couldn’t open the sign-in saved on this Mac. Try again, or sign out and sign in again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac に保存されたログイン情報を開けませんでした。もう一度お試しいただくか、ログアウトしてから再度ログインしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum chưa mở được thông tin đăng nhập đã lưu trên máy Mac này. Hãy thử lại, hoặc đăng xuất rồi đăng nhập lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 无法打开这台 Mac 上保存的登录信息。请重试，或退出后重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 無法開啟這台 Mac 上儲存的登入資訊。請再試一次，或登出後重新登入。"
          }
        }
      }
    },
