    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.intake.invalid.birth_time": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a birth time in 24-hour HH:MM format. An approximate time is okay."
          }
