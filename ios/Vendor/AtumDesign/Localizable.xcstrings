    "shared.matrix-alias-copy.copy.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How people find you on Atum. You can change it once every 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum でほかの人があなたを見つけるための名前です。30 日に 1 回変更できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cách mọi người tìm thấy bạn trên Atum. Bạn có thể đổi 30 ngày một lần."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "别人在 Atum 上找到你的方式。每 30 天可更改一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "別人在 Atum 上找到你的方式。每 30 天可更改一次。"
          }
        }
      }
    },
    "shared.matrix-alias-copy.copy.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 3–32 letters, numbers or underscores, starting with a letter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字で始まる 3–32 文字の英数字またはアンダースコアを使ってください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng 3–32 chữ cái, chữ số hoặc dấu gạch dưới, bắt đầu bằng chữ cái."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 3–32 个字母、数字或下划线，以字母开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 3–32 個字母、數字或底線，以字母開頭。"
          }
        }
      }
    },
