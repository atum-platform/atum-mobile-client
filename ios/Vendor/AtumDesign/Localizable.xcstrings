    "desktop.dm.group.advisory.creationDisabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups with your agents and apps are not enabled yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のエージェントやアプリとのグループはまだ有効になっていません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm với trợ lý và ứng dụng của bạn chưa được bật."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未启用与你的智能体和应用的群聊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未啟用與你的智慧體和應用程式的群組對話。"
          }
        }
      }
    },
    "desktop.dm.group.advisory.disclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your apps and agents use what they know about you from your private conversations. Their replies are shared with everyone you select here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドバイザーは個別の会話で知った情報を使います。回答はここで選んだ全員に共有されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng và trợ lý dùng những gì họ biết về bạn từ trò chuyện riêng. Câu trả lời được chia sẻ với tất cả thành viên bạn chọn ở đây."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "顾问会使用从私聊中了解的你的信息。回复会与此处所选的所有顾问共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顧問會使用從私聊中了解的你的資訊。回覆會與此處所選的所有顧問共用。"
          }
        }
      }
    },
    "desktop.dm.group.advisory.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps or agents are available yet. Connect an app or create an agent first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できるアドバイザーがいません。アプリを連携するか、アシスタントを作成してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ứng dụng hoặc trợ lý khả dụng. Hãy kết nối ứng dụng hoặc tạo trợ lý trước."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可用顾问。请先关联应用或创建助手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫無可用顧問。請先連結應用程式或建立助理。"
          }
        }
      }
    },
