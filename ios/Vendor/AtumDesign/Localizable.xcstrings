    "shared.matrix-action-copy.matrixActionCopy.listeningPausedStorage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answering stopped, but Atum couldn’t save that. Free up some disk space, then press Stop again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信は停止しましたが、設定を保存できませんでした。空き容量を確保して、もう一度「停止」を押してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dừng trả lời nhưng Atum chưa lưu được lựa chọn. Hãy giải phóng dung lượng rồi nhấn Dừng lần nữa."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止回复，但 Atum 无法保存此设置。请释放磁盘空间，然后再次点击停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止回覆，但 Atum 無法儲存此設定。請釋放磁碟空間，然後再次點選停止。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.listeningRoomFallback": {
      "localizations": {
