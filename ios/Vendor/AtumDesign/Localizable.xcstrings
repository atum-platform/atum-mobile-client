            "state": "translated",
            "value": "为群聊启用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為群組聊天啟用"
          }
        }
      }
    },
    "desktop.dm.group.persona.approved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have approved these instructions on this computer. Group access is confirmed when the connection completes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパソコンでこの指示を承認しました。接続が完了すると、グループへのアクセスが確定します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã phê duyệt hướng dẫn này trên máy tính. Quyền truy cập nhóm được xác nhận khi kết nối hoàn tất."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你已在此电脑上批准这些指令。连接完成后即可确认群组访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已在這台電腦上核准這些指示。連線完成後即會確認群組存取權。"
          }
        }
      }
    },
    "desktop.dm.group.persona.bound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This agent has a group connection on one of your computers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントは、あなたのパソコンのいずれかでグループに接続しています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý này đã có kết nối nhóm trên một trong các máy tính của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此智能体已在你的某台电脑上连接到群组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個代理已在你的其中一台電腦上連線到群組。"
          }
        }
      }
    },
    "desktop.dm.group.persona.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review exactly what this agent may share before enabling it on this computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパソコンで有効にする前に、このエージェントが共有できる内容を正確に確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem chính xác những gì trợ lý này có thể chia sẻ trước khi bật trên máy tính này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在此电脑上启用前，请确认此智能体可以分享的具体内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這台電腦上啟用前，請確認這個代理可以分享的確切內容。"
          }
        }
      }
    },
    "desktop.dm.group.persona.disclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People in the group can read this agent’s replies. This computer runs the agent using the approved shared identity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループの参加者はこのエージェントの返信を読めます。このパソコンは承認済みの共有アイデンティティでエージェントを実行します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi người trong nhóm có thể đọc phản hồi của trợ lý. Máy tính này chạy trợ lý bằng danh tính chia sẻ đã được phê duyệt."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "群组成员可以看到此智能体的回复。此电脑会使用已批准的共享身份运行智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組成員可以看到這個代理的回覆。這台電腦會以已核准的共用身分執行代理。"
          }
        }
      }
    },
