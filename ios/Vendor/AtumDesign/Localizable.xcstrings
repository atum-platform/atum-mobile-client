    "src.matrix.drive-copy.matrixDriveCopy.facts.issues.excluded.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive skipped these files, so they may not be up to date on every Mac. Open the folder to review them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive がこれらのファイルをスキップしたため、すべての Mac で最新ではない可能性があります。フォルダーを開いて確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive đã bỏ qua các tệp này nên chúng có thể chưa được cập nhật trên mọi máy Mac. Mở thư mục để kiểm tra."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive 跳过了这些文件，因此它们可能没有在每台 Mac 上保持最新。打开文件夹进行检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive 略過了這些檔案，因此它們可能沒有在每台 Mac 上保持最新。開啟資料夾進行檢查。"
          }
        }
      }
    },
