            "state": "translated",
            "value": "瀏覽和搜尋網頁"
          }
        }
      }
    },
    "desktop.atum.account.consent.computerControl": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control your apps"
