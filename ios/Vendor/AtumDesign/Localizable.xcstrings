    "src.matrix.agent-content-copy.agentContentCopy.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks saved instructions and portable skills. Local changes are kept; this does not pause your agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの指示と移動可能なスキルを確認します。ローカルの変更を保持し、エージェントを停止しません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra hướng dẫn đã lưu và kỹ năng có thể đồng bộ. Giữ nguyên thay đổi cục bộ; không tạm dừng trợ lý."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "检查已保存的指令和可同步技能。保留本地修改，不会暂停智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查已儲存的指示和可同步技能。保留本機修改，不會暫停智慧代理。"
          }
        }
      }
    },
    "src.matrix.agent-content-copy.agentContentCopy.lastCounts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the last completed check."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に完了した確認結果を表示しています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang hiển thị lần kiểm tra hoàn tất gần nhất."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "显示最近一次已完成的检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示最近一次已完成的檢查。"
          }
        }
      }
    },
    "src.matrix.agent-content-copy.agentContentCopy.missingSkills": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "1 skill isn’t on this Mac yet"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%1$lld skills aren’t on this Mac yet"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 個のスキルがまだこのMacにありません"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kỹ năng chưa có trên máy này"
          }
