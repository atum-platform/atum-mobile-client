    "src.matrix.launch-copy.copies.planSignInHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This assistant answers with your ChatGPT plan, and its sign-in on this Mac has ended. Its chats and memory are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアシスタントは ChatGPT プランで応答しますが、この Mac でのサインインが切れました。チャットと記憶はそのまま残ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý này trả lời bằng gói ChatGPT của bạn, và phiên đăng nhập trên Mac này đã hết. Các cuộc trò chuyện và trí nhớ vẫn được giữ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这个助理使用你的 ChatGPT 套餐回答，它在这台 Mac 上的登录已失效。聊天和记忆都会保留。"
          }
        },
        "zh-Hant": {
