        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアプリを開けませんでした。ログインに使っているアドレスから privacy@atumplatform.com にメールしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được ứng dụng email. Hãy gửi email tới privacy@atumplatform.com từ địa chỉ bạn dùng để đăng nhập."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
