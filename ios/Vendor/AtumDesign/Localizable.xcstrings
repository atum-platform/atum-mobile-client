    "shared.matrix-company-copy.copy.fundingDisabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared spending is turned off for now. Your last change is kept; contact support to finish it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有の支出は一時的にオフです。最後の変更は保持されています。完了するにはサポートに連絡してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi tiêu chung đang tạm tắt. Thay đổi gần nhất của bạn vẫn được giữ; hãy liên hệ hỗ trợ để hoàn tất."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "共享支出暂时关闭。你最近的更改已保留；请联系支持完成更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共用支出暫時關閉。你最近的變更已保留；請聯絡支援完成變更。"
          }
        }
      }
    },
