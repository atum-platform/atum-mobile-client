    "desktop.atum.usernameGate.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends find you on Atum by this name. Pick one you like, or keep the one we made."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちはこの名前で Atum 上のあなたを見つけます。好きな名前を選ぶか、こちらで用意した名前をそのまま使えます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn bè tìm bạn trên Atum bằng tên này. Chọn tên bạn thích, hoặc giữ tên Atum đã tạo."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友会通过这个名字在 Atum 上找到你。选一个你喜欢的，或保留我们为你生成的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友會用這個名稱在 Atum 上找到你。選一個你喜歡的，或保留我們幫你產生的名稱。"
          }
        }
      }
    },
    "desktop.atum.usernameGate.cooldownNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this, you can change it once every 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このあとは、30 日に 1 回まで変更できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau bước này, bạn có thể đổi tên một lần mỗi 30 ngày."
          }
        },
        "zh": {
          "stringUnit": {
