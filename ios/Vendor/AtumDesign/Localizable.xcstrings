            "state": "translated",
            "value": "等待時間過長，請再試一次。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.waiting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to %1$@ in the Atum sheet."
          }
        },
        "ja": {
