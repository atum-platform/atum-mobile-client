            "state": "translated",
            "value": "沒有成功，請再試一次。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approveAsk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device is asking to read your messages and use your assistants."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その端末があなたのメッセージを読み、アシスタントを使う許可を求めています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy đó đang xin quyền đọc tin nhắn và dùng trợ lý của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "那台设备正在请求读取你的消息并使用你的助手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那台裝置正在請求讀取你的訊息並使用你的助理。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approveBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the number code showing on that device. It will then be able to read your messages and use your assistants."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その端末に表示されている番号コードを選んでください。その端末であなたのメッセージを読み、アシスタントを使えるようになります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn mã số đang hiện trên máy đó. Sau đó máy đó sẽ đọc được tin nhắn và dùng được trợ lý của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "选择那台设备上显示的数字代码。之后它就能读取你的消息并使用你的助手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇那台裝置上顯示的數字代碼。之後它就能讀取你的訊息並使用你的助理。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approveDeclined": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Declined. If it wasn’t you, change your Google password and sign that device out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否しました。自分でない場合は、Google のパスワードを変更してから、その端末をログアウトさせてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã từ chối. Nếu không phải bạn, hãy đổi mật khẩu Google rồi đăng xuất máy đó."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝。如果不是你本人，请修改 Google 密码，然后让那台设备退出登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒絕。如果不是你本人，請修改 Google 密碼，然後讓那台裝置登出。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approveFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t approve %1$@. Try again in a few minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を承認できませんでした。数分後にもう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cho phép được %1$@. Hãy thử lại sau ít phút."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没能批准%1$@。请过几分钟再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒能核准%1$@。請過幾分鐘再試一次。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approveFailed.device=null": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t approve that device. Try again in a few minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その端末を承認できませんでした。数分後にもう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cho phép được máy đó. Hãy thử lại sau ít phút."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没能批准那台设备。请过几分钟再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒能核准那台裝置。請過幾分鐘再試一次。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approveMismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn’t match, so the device wasn’t approved. If it wasn’t you, change your Google password and sign that device out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致しなかったため、その端末は承認されていません。自分でない場合は、Google のパスワードを変更してから、その端末をログアウトさせてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không khớp, nên máy đó chưa được cho phép. Nếu không phải bạn, hãy đổi mật khẩu Google rồi đăng xuất máy đó."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "不一致，因此那台设备未获批准。如果不是你本人，请修改 Google 密码，然后让那台设备退出登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不一致，因此那台裝置未獲核准。如果不是你本人，請修改 Google 密碼，然後讓那台裝置登出。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approveTapThere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now tap “I picked this code” on %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@で「このコードを選びました」をタップしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ hãy bấm “Tôi đã chọn mã này” trên %1$@."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "现在请在%1$@上点按“我已选择此代码”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在請在%1$@上點按「我已選擇此代碼」。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approveTapThere.device=null": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now tap “I picked this code” on that device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その端末で「このコードを選びました」をタップしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ hãy bấm “Tôi đã chọn mã này” trên máy đó."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "现在请在那台设备上点按“我已选择此代码”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在請在那台裝置上點按「我已選擇此代碼」。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approveTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you just sign in on a new device?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい端末でログインしましたか？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vừa đăng nhập trên một máy mới?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你刚在一台新设备上登录了吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你剛在一台新裝置上登入了嗎？"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approveUnfinished": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved %1$@, but older messages may not open there yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を承認しましたが、そこでは以前のメッセージがまだ開けない場合があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cho phép %1$@, nhưng tin nhắn cũ có thể chưa mở được ở đó."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准%1$@，但那里可能还打不开以前的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已核准%1$@，但那裡可能還打不開以前的訊息。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approveUnfinished.device=null": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved that device, but older messages may not open there yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その端末を承認しましたが、そこでは以前のメッセージがまだ開けない場合があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cho phép máy đó, nhưng tin nhắn cũ có thể chưa mở được ở đó."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准那台设备，但那里可能还打不开以前的消息。"
          }
        },
        "zh-Hant": {
