    "shared.matrix-app-chat-copy.matrixAppChatCopy.noTurn": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hasn't answered this message. Make sure Atum is up to date, then try again in a few minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はこのメッセージにまだ返信していません。Atum を更新してから、しばらくしてもう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chưa trả lời tin này. Hãy kiểm tra Atum đã được cập nhật, rồi thử lại sau ít phút."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 尚未回复这条消息。请确认 Atum 已更新，然后稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 尚未回覆這則訊息。請確認 Atum 已更新，然後稍後再試。"
          }
        }
      }
    },
