        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin được gửi trước khi máy này tham gia. Khôi phục tin nhắn để đọc."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "消息在这台 Mac 加入前发送。恢复消息后即可读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
