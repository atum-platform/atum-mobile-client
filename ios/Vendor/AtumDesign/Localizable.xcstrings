    "desktop.dm.brandLine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum is an AI assistant that chats with you, helps you get things done, and connects what you already use."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum は、あなたと会話し、作業を手伝い、普段使っているアプリやサービスをつなぐ AI アシスタントです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum là trợ lý AI trò chuyện cùng bạn, giúp bạn hoàn thành công việc và kết nối những gì bạn đang dùng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 是你的 AI 助手：陪你聊天，帮你把事做完，并连接你常用的应用和服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 是你的 AI 助理：陪你聊天，幫你把事做完，並連接你常用的應用程式和服務。"
          }
        }
      }
    },
