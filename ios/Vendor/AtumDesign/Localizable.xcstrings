    "desktop.atum.account.handleClaimed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. You're @%1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了しました。あなたは @%1$@ です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xong. Bạn là @%1$@."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "完成。你现在是 @%1$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成。你現在是 @%1$@。"
          }
