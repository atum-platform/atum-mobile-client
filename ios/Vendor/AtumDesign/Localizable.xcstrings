    "desktop.atum.account.handleClaimedHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friends can find you with it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友だちはこの名前であなたを見つけられます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn bè có thể tìm bạn bằng tên này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友可以通过它找到你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "朋友可以用這個名稱找到你。"
          }
        }
      }
    },
    "desktop.atum.account.handleCooldown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can only change your name once every 30 days."
          }
        },
