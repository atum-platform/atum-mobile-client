    "shared.matrix-action-copy.matrixActionCopy.actionIgnored": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This message wasn’t for your assistant, so nothing was run."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージはアシスタント宛てではないため、何も実行していません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn này không dành cho trợ lý nên chưa chạy gì."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此消息不是发给助手的，因此未运行任何内容。"
