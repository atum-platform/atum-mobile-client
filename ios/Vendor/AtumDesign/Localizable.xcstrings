    "src.matrix.moderation-copy.copies.notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won’t see their messages or invites, and they aren’t told."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のメッセージや招待が表示されなくなります。相手には通知されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không thấy tin nhắn hay lời mời của họ, và họ không được thông báo."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你将看不到对方的消息和邀请，对方也不会收到通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你將看不到對方的訊息和邀請，對方也不會收到通知。"
          }
        }
      }
    },
    "src.matrix.moderation-copy.copies.report": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report message"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを報告"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo tin nhắn"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "举报消息"
          }
        },
        "zh-Hant": {
