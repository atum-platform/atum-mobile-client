    "shared.matrix-tool-settings-copy.matrixToolSettingsCopy.backendEffect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies the next time this agent’s runtime starts. Environment overrides can take precedence. This does not switch a running shell or container."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にアシスタントのランタイムが起動した時に適用されます。環境変数が優先される場合があります。実行中のシェルやコンテナは切り替わりません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng khi môi trường của trợ lý khởi động lại. Biến môi trường có thể được ưu tiên. Không chuyển shell hoặc container đang chạy."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "下次助手运行环境启动时生效。环境变量可能优先。不会切换正在运行的 shell 或容器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次助理執行環境啟動時生效。環境變數可能優先。不會切換正在執行的 shell 或容器。"
          }
        }
      }
    },
