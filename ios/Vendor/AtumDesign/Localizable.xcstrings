    "desktop.dm.group.persona.approve": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable for group chats"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループチャットで有効にする"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật cho nhóm trò chuyện"
          }
        },
        "zh": {
