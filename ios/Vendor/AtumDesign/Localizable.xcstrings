    "shared.matrix-approval-copy.copies.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.declined": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other device declined."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方の端末で拒否されました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy kia đã từ chối."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的另一台设备拒绝了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的另一台裝置拒絕了。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your messages and assistants are unlocked on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac でメッセージとアシスタントのロックが解除されました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã mở khóa tin nhắn và trợ lý trên Mac này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的消息和助手已解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 上的訊息和助理已解鎖。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key didn’t arrive from your other device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方の端末からキーが届きませんでした。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa nhận được khóa từ máy kia."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有收到另一台设备发来的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有收到另一台裝置傳來的金鑰。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum will never call or message you asking you to pick a number code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum が電話やメッセージで番号コードを選ぶよう頼むことはありません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum không bao giờ gọi điện hay nhắn tin bảo bạn chọn mã số."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 绝不会打电话或发消息让你选择数字代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 絕不會打電話或傳訊息要你選擇數字代碼。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.itsMe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, it’s me"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい、自分です"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đúng, là tôi"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "是的，是我"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是的，是我"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.keyStale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account’s security was changed from another device or sign-in. If that wasn’t you, change your Google password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントのセキュリティが、別の端末または別のログインから変更されました。自分でない場合は、Google のパスワードを変更してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảo mật tài khoản của bạn đã được thay đổi từ một máy khác hoặc một lần đăng nhập khác. Nếu không phải bạn, hãy đổi mật khẩu Google."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户安全设置已在另一台设备或另一次登录中被更改。如果不是你本人，请修改 Google 密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帳號安全設定已在另一台裝置或另一次登入中被變更。如果不是你本人，請修改 Google 密碼。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn’t match, so this Mac wasn’t approved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致しなかったため、この Mac は承認されていません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không khớp, nên Mac này chưa được cho phép."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "不一致，因此这台 Mac 未获批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不一致，因此這台 Mac 未獲核准。"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.newDevice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい端末"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một máy mới"
