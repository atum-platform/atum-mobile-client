    "shared.agent-conversation.copy.copies.migrationTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@"
          },
          "substitutions": {
            "count": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Atum keeps one conversation with %1$@. 1 earlier chat is kept."
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Atum keeps one conversation with %1$@. %2$lld earlier chats are kept."
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum は %1$@ との会話を 1 つに保ちます。%2$lld 件の以前の会話は保持されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum giữ một cuộc trò chuyện với %1$@. %2$lld cuộc trò chuyện trước được giữ lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 会保留与 %1$@ 的一个会话。将保留 %2$lld 个较早的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 會保留與 %1$@ 的一個對話。將保留 %2$lld 個較早的對話。"
          }
        }
      }
    },
