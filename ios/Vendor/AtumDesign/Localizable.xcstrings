    "desktop.atum.account.editUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email and phone are managed by your sign-in account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンの Atum では、まだこれらの情報を編集できません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email và số điện thoại được quản lý bởi tài khoản đăng nhập."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本的 Atum 暂不支持编辑这些信息。"
