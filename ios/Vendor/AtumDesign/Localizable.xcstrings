    "src.matrix.agent-content-copy.agentContentCopy.receiptReset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local skill-removal record was damaged, so an earlier removed skill may reappear. Remove it again if needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのスキル削除記録が破損したため、以前削除したスキルが再表示される場合があります。必要ならもう一度削除してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi xóa kỹ năng cục bộ đã bị hỏng nên kỹ năng từng xóa có thể xuất hiện lại. Hãy xóa lại nếu cần."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "本地技能删除记录已损坏，因此之前删除的技能可能会重新出现。如有需要，请再次删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機技能刪除記錄已損壞，因此先前刪除的技能可能會再次出現。如有需要，請再次刪除。"
          }
        }
      }
    },
