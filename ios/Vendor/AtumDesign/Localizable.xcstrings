    "shared.matrix-debug-share-copy.matrixDebugShareCopy.running": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload is running. Closing this view does not cancel it. Check status before sharing again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信中です。閉じても中止されません。再共有前に状況を確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tải lên. Đóng cửa sổ không hủy tác vụ. Kiểm tra trạng thái trước khi chia sẻ lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "正在上传。关闭视图不会取消。再次共享前请检查状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在上傳。關閉檢視不會取消。再次分享前請檢查狀態。"
          }
        }
      }
    },
