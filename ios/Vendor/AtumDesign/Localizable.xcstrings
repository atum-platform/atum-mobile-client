    "src.matrix.founder.founder-copy.FOUNDER_COPY.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions, ideas or problems? Message me here. I usually reply within a day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問、アイデア、問題があれば、ここでメッセージしてください。通常1日以内に返信します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có câu hỏi, ý tưởng hay gặp sự cố? Nhắn cho tôi ở đây. Tôi thường trả lời trong vòng một ngày."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "有问题、想法或遇到故障？在这里给我发消息。我通常会在一天内回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有問題、想法或遇到故障？在這裡傳訊息給我。我通常會在一天內回覆。"
          }
        }
      }
    },
