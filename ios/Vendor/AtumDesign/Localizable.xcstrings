    "desktop.atum.workspace.wordPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Atum to control Microsoft Word in System Settings → Privacy & Security → Automation, then open the document again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → オートメーションで Atum に Microsoft Word の操作を許可してから、再度開いてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Atum điều khiển Microsoft Word trong Cài đặt hệ thống → Quyền riêng tư & Bảo mật → Tự động hóa, rồi mở lại tài liệu."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 → 隐私与安全性 → 自动化中允许 Atum 控制 Microsoft Word，然后重新打开文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定 → 隱私權與安全性 → 自動化中允許 Atum 控制 Microsoft Word，然後重新開啟文件。"
          }
        }
      }
    },
    "desktop.atum.workspace.wordSmallScreen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This display is too small for the two windows. Move Atum to a larger display and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのウインドウを表示するには画面が小さすぎます。大きな画面に Atum を移動して再試行してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình này quá nhỏ cho hai cửa sổ. Hãy chuyển Atum sang màn hình lớn hơn rồi thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此屏幕太小，无法并排显示两个窗口。请将 Atum 移至更大的屏幕后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此螢幕太小，無法並排顯示兩個視窗。請將 Atum 移至更大的螢幕後重試。"
          }
        }
      }
