    "src.matrix.assistant-card.copy.assistantCardCopies.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In groups, %1$@ answers only you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループでは、%1$@はあなたにだけ返信します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong nhóm, %1$@ chỉ trả lời bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在群组中，%1$@ 只回复你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
