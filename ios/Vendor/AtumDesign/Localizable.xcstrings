    "shared.matrix-alias-copy.copy.claimTextAgent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ becomes %2$@’s bot handle. You can change it once every 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ が %2$@ のボットのハンドルになります。30 日に 1 回変更できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ sẽ là tên bot của %2$@. Bạn có thể đổi 30 ngày một lần."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ 将成为%2$@的机器人用户名。每 30 天可更改一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ 將成為%2$@的機器人使用者名稱。每 30 天可更改一次。"
          }
        }
      }
    },
    "shared.matrix-alias-copy.copy.claimTextSelf": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ becomes your handle. You can change it once every 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ があなたのハンドルになります。30 日に 1 回変更できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ sẽ là tên công khai của bạn. Bạn có thể đổi 30 ngày một lần."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ 将成为你的用户名。每 30 天可更改一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@%1$@ 將成為你的使用者名稱。每 30 天可更改一次。"
          }
        }
      }
    },
    "shared.matrix-alias-copy.copy.claimTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this handle?"
          }
        },
        "ja": {
