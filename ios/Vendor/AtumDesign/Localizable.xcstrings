    "src.matrix.mobile-device-copy.mobileDeviceCopy.cloudConsentBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try cloud hosting for seven days. The trial starts when your first task is admitted. Model funding and hosting are separate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドホスティングを7日間お試しください。トライアルは最初のタスクが受け付けられたときに開始します。モデル料金とホスティングは別です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng thử lưu trữ trên đám mây trong bảy ngày. Thời gian bắt đầu khi tác vụ đầu tiên được tiếp nhận. Chi phí mô hình và lưu trữ được tính riêng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "试用云端托管七天。试用自首个任务被受理时开始。模型费用与托管费用分开计算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用雲端託管七天。試用自首個工作被受理時開始。模型費用與託管費用分開計算。"
          }
        }
      }
    },
    "src.matrix.mobile-device-copy.mobileDeviceCopy.cloudConsentStatesTrialEndedText": {
