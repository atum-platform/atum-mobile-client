    "shared.matrix-action-copy.matrixActionCopy.consentHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant can use apps, files and the terminal on this Mac. Only allow requests you understand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントはこのMacのアプリ、ファイル、ターミナルを使えます。内容を理解した要求だけを許可してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý có thể dùng ứng dụng, tệp và terminal trên máy Mac này. Chỉ cho phép những yêu cầu bạn hiểu rõ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "助手可以使用这台 Mac 上的应用、文件和终端。只批准你理解的请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理可以使用這台 Mac 上的應用程式、檔案和終端機。只批准你理解的要求。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.consentTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run this on your Mac?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacで実行しますか？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy việc này trên máy Mac của bạn?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Mac 上运行此请求？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Mac 上執行此要求？"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.continuousListening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant answers from this Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントはこのMacで返信します"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý trả lời từ máy Mac này"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "助手会在这台 Mac 上回复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理會在這台 Mac 上回覆"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.continuousListeningPaused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answering is paused"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信を一時停止中"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tạm dừng trả lời"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停回复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停回覆"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.deviceUnverified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can’t answer messages from a device you haven’t verified yet. Compare the verification symbols on your phone and Mac, then send this again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ検証されていない端末からのメッセージには応答できません。スマートフォンと Mac の検証記号を照合してから、もう一度送ってください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình chưa trả lời được tin nhắn từ thiết bị bạn chưa xác minh. Hãy đối chiếu các ký hiệu xác minh trên điện thoại và Mac, rồi gửi lại tin này nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "我暂时无法回复来自未验证设备的消息。请核对手机和 Mac 上的验证符号，然后重新发送这条消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我暫時無法回覆來自未驗證裝置的訊息。請核對手機和 Mac 上的驗證符號，然後重新傳送這則訊息。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.dismissPromptNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.fileHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files you send (up to 20 MB) are copied to this Mac and may be shared with the AI model."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送ったファイル（最大20 MB）はこのMacにコピーされ、AIモデルに送られることがあります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp bạn gửi (tối đa 20 MB) được sao chép vào máy Mac này và có thể được gửi đến mô hình AI."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你发送的文件（最大 20 MB）会复制到这台 Mac，并可能发送给 AI 模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你傳送的檔案（最大 20 MB）會複製到這台 Mac，並可能傳送給 AI 模型。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.groupJoined": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here, I answer only the person who added me. I respond when they address me; in a group with just their assistants, I may also join when my work is relevant. Their message, our work descriptions, one message they quote, and recent messages in that private group may go to AI services to choose and prepare a reply."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは、私を追加した人にだけ応答します。メンションや私のメッセージへの返信に応答し、その人とその人のアシスタントだけのグループでは、役に立てるときに会話へ参加することもあります。その人のメッセージ、アシスタントの役割説明、引用した1件、その非公開グループの最近のメッセージは、応答するアシスタントの選択と回答作成のためにAIサービスへ送られることがあります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở đây, mình chỉ trả lời người đã thêm mình. Mình trả lời khi họ nhắc tên hoặc trả lời tin của mình; trong nhóm chỉ có họ và các trợ lý của họ, mình cũng có thể tham gia khi công việc phù hợp. Tin nhắn của họ, mô tả công việc của các trợ lý, một tin họ trích dẫn và các tin gần đây trong nhóm riêng đó có thể được gửi tới dịch vụ AI để chọn và soạn câu trả lời."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里，我只回复把我加入群组的人。对方提到我或回复我的消息时，我会回应；在只有对方及其助理的群组中，如果我的工作相关，我也可能参与。对方的消息、助理的工作说明、引用的一条消息以及该私人群组中的近期消息，可能会发送给 AI 服务，用于选择由谁回答并生成回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡，我只回覆把我加入群組的人。對方提及我或回覆我的訊息時，我會回應；在只有對方及其助理的群組中，如果我的工作相關，我也可能參與。對方的訊息、助理的工作說明、引用的一則訊息以及該私人群組中的近期訊息，可能會傳送給 AI 服務，用於選擇由誰回答並產生回覆。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.groupMissed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn’t answer this message. Send it again after opening Atum on your Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージには応答できませんでした。MacでAtumを開いてから、もう一度送ってください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình chưa trả lời được tin này. Bạn nhắn lại sau khi mở Atum trên máy Mac nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这条消息我还没能回复。请在 Mac 上打开 Atum 后再发一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這則訊息我還沒能回覆。請在 Mac 上開啟 Atum 後再傳一次。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.groupRoutingUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn’t choose an assistant for this message. Mention one of us directly, or try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージに適したアシスタントを選べませんでした。直接メンションするか、もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình chưa chọn được trợ lý phù hợp cho tin nhắn này. Bạn nhắc tên một trợ lý hoặc thử lại nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法为这条消息选择合适的助手。请直接提及其中一位，或重试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法為這則訊息選擇合適的助理。請直接提及其中一位，或再試一次。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.groupStale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I was busy, and your message waited too long. Could you ask me again?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手が離せない間に、メッセージの待ち時間が長くなりすぎました。もう一度送ってもらえますか？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình đang bận nên tin nhắn của bạn đã chờ quá lâu. Bạn nhắn lại giúp mình nhé?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "我刚才在忙，你的消息等得太久了。能再发一次吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我剛才在忙，你的訊息等得太久了。能再傳一次嗎？"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.guestKeepListening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other Mac usually answers this assistant with its own files. Keeping this on here makes this Mac answer instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアシスタントには通常、もう一台の Mac がそのファイルを使って返信します。ここで有効にすると、この Mac が代わりに返信します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac kia của bạn thường trả lời trợ lý này bằng tệp của nó. Bật ở đây sẽ để máy này trả lời thay."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的另一台 Mac 通常会用它的文件回复这位助手。在这里开启后，将改由这台 Mac 回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的另一台 Mac 通常會用它的檔案回覆這位助理。在這裡開啟後，將改由這台 Mac 回覆。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.hermesInvalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant couldn’t start on this Mac. Reinstall Atum to fix it; your chats are safe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでアシスタントを起動できませんでした。Atumを再インストールしてください。チャットは失われません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý chưa khởi động được trên máy Mac này. Hãy cài lại Atum để khắc phục; các cuộc trò chuyện vẫn an toàn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "助手无法在这台 Mac 上启动。请重新安装 Atum；你的聊天记录不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理無法在這台 Mac 上啟動。請重新安裝 Atum；你的聊天記錄不受影響。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.hermesNeedsInput": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant needs your answer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントが回答を待っています"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý cần bạn trả lời"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "助手需要你的回答"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理需要你的回答"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.hermesRunning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant is working. Stopping won’t undo what’s already done."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントが作業中です。停止しても完了した操作は元に戻りません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý đang làm việc. Dừng sẽ không hoàn tác những việc đã xong."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "助手正在工作。停止不会撤销已完成的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理正在工作。停止不會撤銷已完成的操作。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.hermesUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant isn’t ready yet. Try reconnecting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントの準備ができていません。再接続してみてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý chưa sẵn sàng. Hãy thử kết nối lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "助手尚未就绪。请尝试重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理尚未就緒。請嘗試重新連線。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.hermesUnconfigured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant isn’t set up on this Mac yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacではまだアシスタントが設定されていません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý chưa được thiết lập trên máy Mac này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "助手尚未在这台 Mac 上设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理尚未在這台 Mac 上設定。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.keepListeningHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While Atum is open on this Mac, your assistant answers what you send here from your other devices. Quit Atum to stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでAtumを開いている間、ほかのデバイスからここに送ったメッセージにアシスタントが応答します。止めるにはAtumを終了してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi Atum đang mở trên máy Mac này, trợ lý sẽ trả lời những gì bạn gửi tại đây từ các thiết bị khác. Thoát Atum để dừng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "只要 Atum 在这台 Mac 上打开，助手就会回复你从其他设备发到这里的消息。退出 Atum 即可停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要 Atum 在這台 Mac 上開啟，助理就會回覆你從其他裝置傳到這裡的訊息。結束 Atum 即可停止。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.keepListeningHermes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep answering from this Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacで返信を続ける"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục trả lời từ máy Mac này"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上持续回复"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這台 Mac 上持續回覆"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.listenHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the next 15 minutes, your assistant answers what you send here from your other devices, and it can use this Mac to do it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これから15分間、ほかのデバイスからここに送ったメッセージにアシスタントが応答します。そのためにこのMacを使うことがあります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong 15 phút tới, trợ lý sẽ trả lời những gì bạn gửi tại đây từ các thiết bị khác và có thể dùng máy Mac này để làm việc đó."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在接下来的 15 分钟内，助手会回复你从其他设备发到这里的消息，并可能使用这台 Mac 来完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在接下來的 15 分鐘內，助理會回覆你從其他裝置傳到這裡的訊息，並可能使用這台 Mac 來完成。"
          }
        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.listenHermes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer from this Mac for 15 minutes"
