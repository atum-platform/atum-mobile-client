    "src.matrix.roster-create-copy.copies.historyRule": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People added later only see messages sent after they join."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとから追加された人は、参加後に送られたメッセージだけを見られます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người được thêm sau chỉ thấy tin nhắn gửi sau khi họ tham gia."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "之后加入的人只能看到他们加入后发送的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後加入的人只能看到他們加入後傳送的訊息。"
          }
        }
      }
    },
    "src.matrix.roster-create-copy.copies.historyShared": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People added later can see earlier messages too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとから追加された人も、それまでのメッセージを見られます。"
