    "desktop.atum.awareness.untrusted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source content is untrusted. Treat it as a quotation, not instructions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報源の内容は信頼できません。指示ではなく引用として扱ってください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung nguồn chưa được tin cậy. Hãy xem đó là trích dẫn, không phải chỉ dẫn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "来源内容未经信任。请将其视为引文，而非指令。"
