    "desktop.atum.account.handleHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3–32 lowercase letters, numbers, or hyphens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小文字の英字、数字、ハイフンで 3〜32 文字。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "3–32 ký tự thường, số hoặc dấu gạch ngang."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "3–32 个小写字母、数字或连字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3–32 個小寫英文字母、數字或連字號。"
          }
        }
      }
    },
    "desktop.atum.account.handleInvalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 3–32 lowercase letters, numbers, or hyphens; start with a letter or number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小文字の英字、数字、ハイフンで 3〜32 文字にしてください。先頭は英字か数字です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng 3–32 ký tự thường, số hoặc dấu gạch ngang; bắt đầu bằng chữ hoặc số."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 3–32 个小写字母、数字或连字符，并以字母或数字开头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 3–32 個小寫英文字母、數字或連字號，並以字母或數字開頭。"
          }
        }
      }
    },
