    "desktop.atum.permissions.notifications.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum will let you know when a background task finishes — even while you're in another app. No ads, no spam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドの作業が終わると、ほかのアプリを使っている間でもお知らせします。広告やスパムはありません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum sẽ báo cho bạn khi một tác vụ chạy nền hoàn tất — kể cả khi bạn đang dùng ứng dụng khác. Không có quảng cáo, không có tin rác."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "后台任务完成时，Atum 会通知你，即使你正在使用其他应用。没有广告，也没有垃圾消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景工作完成時，Atum 會通知你，即使你正在使用其他應用程式。沒有廣告，也沒有垃圾訊息。"
          }
        }
      }
    },
    "desktop.atum.permissions.notifications.denied": {
      "localizations": {
