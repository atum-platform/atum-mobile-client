    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.moon.consent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon will receive your name and the content you share in this conversation so it can answer you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonは、あなたに回答するため、この会話で共有した名前と内容を受け取ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon sẽ nhận tên và nội dung bạn chia sẻ trong cuộc trò chuyện này để trả lời bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon 会接收你的姓名和你在此对话中分享的内容，以便回复你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon 會接收你的姓名和你在此對話中分享的內容，以便回覆你。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.moon.firstContact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I’m Moon — I read birth charts and astrology maps for you. Link your Moon account to get started."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは、Moonです。出生図や占星術チャートを読み解きます。Moonアカウントを連携して始めましょう。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào bạn, mình là Moon — mình đọc lá số và bản đồ sao cho bạn. Liên kết tài khoản Moon để bắt đầu nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，我是 Moon——我会为你解读命盘和星盘。关联 Moon 账户即可开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，我是 Moon——我會為你解讀命盤和星盤。連結 Moon 帳戶即可開始。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.moon.terms.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon runs on Atum’s servers and answers every message you send in this private chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MoonはAtumのサーバーで動作し、このプライベートチャットで送信したすべてのメッセージに回答します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon chạy trên máy chủ của Atum và trả lời mọi tin nhắn bạn gửi trong chat riêng này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon 在 Atum 的服务器上运行，并会回复你在这段私聊中发送的每条消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon 在 Atum 的伺服器上執行，並會回覆你在這段私人聊天中傳送的每則訊息。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.moon.terms.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a group, Moon answers only when you mention @moon_bot or reply to Moon. Atum passes Moon only the message you send it and one message you choose to quote."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループでは、@moon_botへのメンションまたはMoonへの返信にだけ回答します。AtumがMoonに渡すのは、あなたが送ったメッセージと、あなたが選んだ引用1件だけです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong nhóm, Moon chỉ trả lời khi bạn nhắc @moon_bot hoặc trả lời tin của Moon. Atum chỉ chuyển cho Moon tin bạn gửi và một tin bạn chọn trích dẫn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在群组中，Moon 只会在你提及 @moon_bot 或回复 Moon 时回答。Atum 只会把你发送的消息及你选择引用的一条消息传给 Moon。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在群組中，Moon 只會在你提及 @moon_bot 或回覆 Moon 時回答。Atum 只會把你傳送的訊息及你選擇引用的一則訊息傳給 Moon。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.moon.terms.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In this private chat, Moon remembers your conversation, including what you have told Moon elsewhere. In groups, Moon uses no one’s chart, memory, or profile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプライベートチャットでは、Moonは他の場所で伝えたことを含め、あなたとの会話を覚えています。グループでは誰のチャート、記憶、プロフィールも使いません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong chat riêng, Moon nhớ cuộc trò chuyện của bạn, kể cả những gì bạn đã nói với Moon ở nơi khác. Trong nhóm, Moon không dùng lá số, ký ức hay hồ sơ của ai."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在这段私聊中，Moon 会记住你的对话，包括你在其他地方告诉 Moon 的内容。在群组中，Moon 不使用任何人的星盘、记忆或个人资料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這段私人聊天中，Moon 會記住你的對話，包括你在其他地方告訴 Moon 的內容。在群組中，Moon 不使用任何人的星盤、記憶或個人資料。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.moon.terms.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum loads earlier private messages from your linked Moon account when you open this chat. They are not added to your Atum chat history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットを開くと、Atumは連携したMoonアカウントから以前のプライベートメッセージを読み込みます。Atumのチャット履歴には追加されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum tải các tin nhắn riêng trước đây từ tài khoản Moon đã liên kết khi bạn mở cuộc trò chuyện này. Những tin này không được thêm vào lịch sử trò chuyện Atum của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "打开此聊天时，Atum 会从已关联的 Moon 账户加载过去的私聊消息。这些消息不会添加到你的 Atum 聊天记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟此聊天時，Atum 會從已連結的 Moon 帳戶載入過去的私人訊息。這些訊息不會加入你的 Atum 聊天記錄。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.moon.terms.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each question uses messages from your own Moon account and is paid in Moon, not with Protons. No one pays for you, and you never pay for anyone else."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各質問はあなた自身のMoonアカウントのメッセージを使い、ProtonではなくMoonで支払われます。誰もあなたの代わりに支払わず、あなたも他の人の代わりに支払いません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi câu hỏi dùng lượt nhắn trong tài khoản Moon của chính bạn và thanh toán trong Moon, không dùng Proton. Không ai trả thay bạn, và bạn không trả thay ai."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每个问题都会使用你自己的 Moon 账户中的消息额度，并在 Moon 中付费，不使用 Proton。没有人替你付费，你也不会替其他人付费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個問題都會使用你自己的 Moon 帳戶中的訊息額度，並在 Moon 中付費，不使用 Proton。沒有人替你付費，你也不會替其他人付費。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.moon.terms.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon’s answers go to every device signed in to your account, including devices you have not verified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonの回答は、未確認の端末を含め、あなたのアカウントにサインインしているすべての端末に届きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời của Moon được gửi tới mọi thiết bị đăng nhập vào tài khoản của bạn, kể cả thiết bị bạn chưa xác minh."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon 的回答会发送到所有登录你账户的设备，包括你尚未验证的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon 的回答會傳送到所有登入你帳戶的裝置，包括你尚未驗證的裝置。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.moon.terms.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can stop using Moon at any time in Atum Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum設定からいつでもMoonの利用を停止できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể dừng dùng Moon bất cứ lúc nào trong Cài đặt Atum."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时在 Atum 设置中停止使用 Moon。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時在 Atum 設定中停止使用 Moon。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.moon.termsTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moon terms in Atum"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AtumでのMoon利用条件"
          }
        },
        "vi": {
