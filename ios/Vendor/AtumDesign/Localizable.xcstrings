    "shared.matrix-tool-settings-copy.matrixToolSettingsCopy.dimensionEffect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 disables the size cap. This editor accepts 0–4096 pixels. Applies to the next driver session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0でサイズ制限を解除します。0〜4096ピクセルを設定できます。次のドライバーセッションに適用されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "0 bỏ giới hạn kích thước. Trình chỉnh sửa chấp nhận 0–4096 pixel. Áp dụng cho phiên driver tiếp theo."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "0取消尺寸限制。此编辑器支持0–4096像素。下次驱动会话生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "0取消尺寸限制。此編輯器支援0–4096像素。下次驅動程式工作階段生效。"
          }
        }
      }
    },
    "shared.matrix-tool-settings-copy.matrixToolSettingsCopy.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify tool settings. Wait for active work to finish, refresh and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール設定を確認できませんでした。実行中の作業が終わってから更新して再試行してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh cài đặt công cụ. Đợi công việc hiện tại kết thúc, làm mới và thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证工具设置。请等当前任务结束后刷新并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證工具設定。請等目前工作結束後重新整理並重試。"
          }
        }
      }
    },
