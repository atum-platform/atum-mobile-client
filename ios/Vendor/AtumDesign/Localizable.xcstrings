    "src.matrix.pet-copy.petCopy.photoHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum copies your pet’s colours and markings from the photo. The photo goes only to Atum’s AI to draw the drafts. Atum doesn’t keep it, and it isn’t part of your pet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum は写真からペットの毛色と模様を写し取ります。写真は下書きを描くために Atum の AI に送られるだけです。Atum は写真を保存せず、ペットにも含まれません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum lấy màu lông và hoa văn của bé từ ảnh. Ảnh chỉ được gửi tới AI của Atum để vẽ bản nháp. Atum không giữ ảnh, và ảnh không nằm trong thú cưng của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 会照着照片里宠物的毛色和花纹来画。照片只会发送给 Atum 的 AI 用来画草稿。Atum 不会保存照片，照片也不会成为你宠物的一部分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 會照著照片裡寵物的毛色和花紋來畫。照片只會傳送給 Atum 的 AI 用來畫草稿。Atum 不會儲存照片，照片也不會成為你寵物的一部分。"
          }
        }
      }
    },
    "src.matrix.pet-copy.petCopy.priceChanged": {
