    "desktop.atum.protons.rewards.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify. Check your Google connection in Atum, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認できませんでした。Atum の Google 接続を確認して再試行してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác minh được. Kiểm tra kết nối Google trong Atum rồi thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证。请检查 Atum 中的 Google 连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證。請檢查 Atum 中的 Google 連接後重試。"
          }
        }
      }
    },
    "desktop.atum.protons.rewards.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Gmail or Google Calendar in Atum, then verify it here. For this one-time bonus, Atum uses a short-lived Google access token only to verify account metadata; it does not read messages or events."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum で Gmail または Google カレンダーを接続してから、ここで確認してください。この一回限りの特典では、Atum は短時間有効な Google アクセストークンをアカウント情報の確認にだけ使用します。メッセージや予定は読み取りません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối Gmail hoặc Google Calendar trong Atum rồi xác minh tại đây. Với phần thưởng một lần này, Atum chỉ dùng mã truy cập Google ngắn hạn để kiểm tra thông tin tài khoản; không đọc email hay sự kiện của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "先在 Atum 中连接 Gmail 或 Google 日历，然后在此验证。对于这项一次性奖励，Atum 仅使用短期有效的 Google 访问令牌来验证账户元数据，不会读取邮件或日历活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在 Atum 中連接 Gmail 或 Google 日曆，然後在此驗證。對於這項一次性獎勵，Atum 僅使用短期有效的 Google 存取權杖來驗證帳戶中繼資料，不會讀取郵件或日曆活動。"
          }
        }
      }
    },
    "desktop.atum.protons.rewards.paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reward claims are temporarily paused. Your earned balance is still available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特典の受け取りは一時停止中です。獲得済みの残高は利用できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng nhận thưởng. Bạn vẫn có thể dùng số dư đã nhận."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "奖励领取暂时暂停。已获得的余额仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獎勵領取暫時暫停。已獲得的餘額仍可使用。"
          }
        }
      }
    },
