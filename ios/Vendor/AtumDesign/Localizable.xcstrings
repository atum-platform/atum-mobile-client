    "src.matrix.chat-copy.copies.errorNotReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum isn’t ready yet, so nothing was sent. Try again in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
