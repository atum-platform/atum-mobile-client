    "src.matrix.mobile-copy.copy.localOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build uses a server on this computer only. A phone cannot connect to that address. Keep using the desktop until a reachable server is configured."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドはこのコンピューター内だけのサーバーを使用しています。スマートフォンからは接続できません。接続可能なサーバーが設定されるまでデスクトップをご利用ください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản này dùng máy chủ chỉ trên máy tính hiện tại. Điện thoại không thể kết nối đến địa chỉ đó. Hãy tiếp tục dùng máy tính đến khi có máy chủ truy cập được."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本使用仅在本机运行的服务器，手机无法连接该地址。配置可访问的服务器之前，请继续使用桌面端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本使用僅在本機執行的伺服器，手機無法連線到該位址。設定可存取的伺服器之前，請繼續使用桌面版。"
          }
        }
      }
    },
