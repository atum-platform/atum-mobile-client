    "shared.matrix-app-chat-copy.matrixAppChatCopy.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App chat is unavailable. Check the connection and app enrollment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリチャットを利用できません。接続と参加登録を確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể trò chuyện với ứng dụng. Hãy kiểm tra kết nối và quyền tham gia."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "应用聊天不可用。请检查连接及应用参与授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式聊天無法使用。請檢查連線及參與授權。"
          }
        }
      }
    },
    "shared.matrix-app-chat-copy.matrixAppChatCopy.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your message was sent, but the app outcome is unconfirmed. Do not resend it automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージは送信済みですが、アプリの結果は未確認です。自動再送しないでください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn đã đến ứng dụng nhưng Atum chưa nhận được kết quả, nên chưa biết ứng dụng đã trả lời hay đã tính lượt nhắn chưa. Atum không tự gửi lại để khỏi tính hai lần."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "消息已发送，但应用结果尚未确认。请勿自动重发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訊息已傳送，但應用程式結果尚未確認。請勿自動重送。"
          }
        }
      }
    },
    "shared.matrix-app-chat-copy.matrixAppChatCopy.withdraw": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove app from chats"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットからアプリを外す"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ ứng dụng khỏi trò chuyện"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "从聊天中移除应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從聊天中移除應用程式"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.andy.consent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy will receive your name and the content you share in this conversation so it can answer you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Andyは、あなたに回答するため、この会話で共有した名前と内容を受け取ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy sẽ nhận tên và nội dung bạn chia sẻ trong cuộc trò chuyện này để trả lời bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 会接收你的姓名和你在此对话中分享的内容，以便回复你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 會接收你的姓名和你在此對話中分享的內容，以便回覆你。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.andy.firstContact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, I’m Andy — I’m here to listen. Link your Andy account to get started."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは、Andyです。あなたの話を聞くためにここにいます。Andyアカウントを連携して始めましょう。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào bạn, mình là Andy — mình ở đây để lắng nghe. Liên kết tài khoản Andy để bắt đầu nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，我是 Andy——我会在这里倾听。关联 Andy 账户即可开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，我是 Andy——我會在這裡傾聽。連結 Andy 帳戶即可開始。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.andy.terms.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy runs on Atum’s servers and answers every message you send in this private chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AndyはAtumのサーバーで動作し、このプライベートチャットで送信したすべてのメッセージに回答します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy chạy trên máy chủ của Atum và trả lời mọi tin nhắn bạn gửi trong chat riêng này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 在 Atum 的服务器上运行，并会回复你在这段私聊中发送的每条消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 在 Atum 的伺服器上執行，並會回覆你在這段私人聊天中傳送的每則訊息。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.andy.terms.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy chats one-on-one only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Andyは1対1のチャットのみ対応しています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy chỉ trò chuyện riêng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 目前仅支持一对一聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 目前只支援一對一聊天。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.andy.terms.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy remembers your private chat to support you better."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Andyはより良く寄り添うため、あなたとのプライベートチャットを覚えています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy nhớ cuộc trò chuyện riêng với bạn để đồng hành tốt hơn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 会记住与你的私聊，以便更好地陪伴你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 會記住與你的私人聊天，以便更好地陪伴你。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.andy.terms.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum does not add messages from outside this conversation to your Atum chat history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atumは、この会話の外にあるメッセージをAtumのチャット履歴へ追加しません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum không thêm tin nhắn bên ngoài cuộc trò chuyện này vào lịch sử trò chuyện Atum của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 不会把此对话之外的消息添加到你的 Atum 聊天记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 不會把此對話之外的訊息加入你的 Atum 聊天記錄。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.andy.terms.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each question uses messages from your own Andy account and is paid in Andy, not with Protons. No one pays for you, and you never pay for anyone else."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各質問はあなた自身のAndyアカウントのメッセージを使い、ProtonではなくAndyで支払われます。誰もあなたの代わりに支払わず、あなたも他の人の代わりに支払いません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi câu hỏi dùng lượt nhắn trong tài khoản Andy của chính bạn và thanh toán trong Andy, không dùng Proton. Không ai trả thay bạn, và bạn không trả thay ai."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每个问题都会使用你自己的 Andy 账户中的消息额度，并在 Andy 中付费，不使用 Proton。没有人替你付费，你也不会替其他人付费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個問題都會使用你自己的 Andy 帳戶中的訊息額度，並在 Andy 中付費，不使用 Proton。沒有人替你付費，你也不會替其他人付費。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.andy.terms.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy’s answers go to every device signed in to your account, including devices you have not verified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Andyの回答は、未確認の端末を含め、あなたのアカウントにサインインしているすべての端末に届きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời của Andy được gửi tới mọi thiết bị đăng nhập vào tài khoản của bạn, kể cả thiết bị bạn chưa xác minh."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 的回答会发送到所有登录你账户的设备，包括你尚未验证的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 的回答會傳送到所有登入你帳戶的裝置，包括你尚未驗證的裝置。"
          }
        }
      }
    },
    "shared.matrix-app-onboarding-copy.matrixAppOnboardingCopy.andy.terms.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can stop using Andy at any time in Atum Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum設定からいつでもAndyの利用を停止できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể dừng dùng Andy bất cứ lúc nào trong Cài đặt Atum."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时在 Atum 设置中停止使用 Andy。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以隨時在 Atum 設定中停止使用 Andy。"
          }
        }
      }
    },
