    "src.matrix.moderation-copy.copies.ignoredHow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To ignore someone, choose Ignore beside them in a chat’s people list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無視するには、チャットのメンバー一覧で相手の横にある「無視」を選びます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để ẩn ai đó, chọn Ẩn người này bên cạnh họ trong danh sách thành viên."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "要忽略某人，请在对话的成员列表中选择其旁边的“忽略”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要忽略某人，請在對話的成員清單中選擇其旁邊的「忽略」。"
          }
        }
      }
    },
