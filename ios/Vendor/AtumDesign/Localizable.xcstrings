    "desktop.atum.pets.hatchBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A one-of-a-kind voxel pet — a dog, cat, fox, rabbit, pig or bear, a little bird, or a blob with a face — designed from your words or a photo, drawn in Atum’s style, in seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "犬・猫・キツネ・ウサギ・ブタ・クマ、小鳥、顔つきのスライムまで。あなたの言葉か写真でデザインする Atum 風のボクセルペット。数秒で、あなただけの一匹。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thú cưng voxel có một không hai — chó, mèo, cáo, thỏ, heo hay gấu, một chú chim nhỏ, hay một cục slime có mặt — thiết kế từ lời bạn tả hoặc một tấm ảnh, vẽ theo phong cách Atum, trong vài giây."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "独一无二的体素宠物——狗、猫、狐狸、兔子、猪或熊、一只小鸟，或一团有脸的史莱姆——按你的描述或照片设计，以 Atum 风格绘制，几秒钟完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獨一無二的體素寵物——狗、貓、狐狸、兔子、豬或熊、一隻小鳥，或一團有臉的史萊姆——依你的描述或照片設計，以 Atum 風格繪製，幾秒鐘完成。"
          }
        }
      }
    },
    "desktop.atum.pets.hatchLead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a pet and watch it hatch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペットを説明して、孵るのを見る"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô tả một thú cưng và xem bé nở"
