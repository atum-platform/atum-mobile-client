    },
    "src.matrix.check-ins-copy.matrixCheckInsCopy.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short brief each morning, and a nudge only when something needs you. Your assistant only reads; it never acts for you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎朝短いまとめを送り、対応が必要なときだけお知らせします。アシスタントは読むだけで、代わりに何かを実行することはありません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi sáng một bản tóm tắt ngắn, và chỉ nhắc khi có việc cần bạn. Trợ lý chỉ đọc, không bao giờ tự làm thay bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每天早上一份简短摘要，只在有事需要你时才提醒。助理只读取信息，绝不代你操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天早上一份簡短摘要，只在有事需要你時才提醒。助理只讀取資訊，絕不代你操作。"
          }
        }
      }
    },
    "src.matrix.check-ins-copy.matrixCheckInsCopy.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each morning at %1$@ I'll send a short brief, and I'll nudge you only when something needs you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎朝 %1$@ に短いまとめを送り、対応が必要なときだけお知らせします。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi sáng %1$@ mình gửi bản tóm tắt ngắn, và chỉ nhắc khi có việc cần bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每天早上 %1$@ 我会发一份简短摘要，只在有事需要你时才提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天早上 %1$@ 我會傳一份簡短摘要，只在有事需要你時才提醒。"
          }
        }
      }
    },
    "src.matrix.check-ins-copy.matrixCheckInsCopy.intro.time=null": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll nudge you only when something needs you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応が必要なときだけお知らせします。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mình chỉ nhắc khi có việc cần bạn."
          }
