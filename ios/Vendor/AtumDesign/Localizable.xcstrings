    "src.matrix.drive-copy.matrixDriveCopy.about.private": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords and private keys are never synced."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードや秘密鍵が同期されることはありません。"
