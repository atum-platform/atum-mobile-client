    "src.matrix.chat-copy.copies.decryption.reasons.before_joined": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent before you joined this chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットに参加する前に送信されました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin được gửi trước khi bạn tham gia cuộc trò chuyện."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
