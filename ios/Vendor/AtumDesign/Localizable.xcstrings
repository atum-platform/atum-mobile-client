    "src.matrix.legal-copy.copy.deleteAccountTip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send it from the address you sign in with. We check it’s you, then delete your account and its data within 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインに使っているアドレスから送ってください。ご本人であることを確認したうえで、30 日以内にアカウントとデータを削除します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi từ địa chỉ email bạn dùng để đăng nhập. Chúng tôi xác minh đó là bạn, rồi xóa tài khoản và dữ liệu trong vòng 30 ngày."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请从你登录所用的邮箱发送。我们确认是你本人后，会在 30 天内删除你的账户和数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請從你登入使用的電子郵件地址寄出。我們確認是你本人後，會在 30 天內刪除你的帳戶和資料。"
          }
        }
      }
    },
