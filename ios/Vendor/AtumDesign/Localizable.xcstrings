    "src.matrix.hermes-setup-copy.hermesSetupCopy.retention": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your key is kept on this Mac. Use one with a spending limit. Signing out removes it; your chats stay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはこのMacに保存されます。利用上限を設定したキーを使ってください。サインアウトするとキーは削除され、チャットは残ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa được lưu trên Mac này. Hãy dùng khóa có giới hạn chi tiêu. Đăng xuất sẽ xóa khóa; các cuộc trò chuyện vẫn được giữ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥保存在这台 Mac 上。请使用设有消费上限的密钥。退出登录会删除密钥；聊天记录会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰儲存在這台 Mac 上。請使用設有消費上限的金鑰。登出會刪除金鑰；聊天記錄會保留。"
          }
        }
      }
    },
