            "state": "translated",
            "value": "檢舉訊息"
          }
        }
      }
    },
    "src.matrix.moderation-copy.copies.reportNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report this message as abuse? Atum doesn’t send its text, and the person isn’t blocked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージを不正行為として報告しますか？Atumは本文を送信せず、相手をブロックしません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cáo tin nhắn này là lạm dụng? Atum không gửi nội dung tin nhắn và người này không bị chặn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将这条消息举报为滥用？Atum 不会发送消息内容，也不会屏蔽对方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將這則訊息檢舉為濫用？Atum 不會傳送訊息內容，也不會封鎖對方。"
          }
        }
      }
    },
    "src.matrix.moderation-copy.copies.reportSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report sent. No message text was sent and the person was not blocked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告を送信しました。本文は送信されず、相手はブロックされていません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi báo cáo. Không có nội dung tin nhắn nào được gửi và người đó không bị chặn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "举报已发送。未发送消息文本，也未屏蔽对方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢舉已送出。未傳送訊息文字，也未封鎖對方。"
          }
        }
      }
    },
