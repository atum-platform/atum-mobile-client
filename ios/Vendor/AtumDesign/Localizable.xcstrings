    "desktop.dm.mention.contextDisclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "this message only. Other chats, apps, files, and memory are excluded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージのみ。ほかのチャット、アプリ、ファイル、記憶は含まれません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "chỉ tin nhắn này. Không gồm cuộc trò chuyện khác, ứng dụng, tệp hay bộ nhớ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限这条消息。其他聊天、应用、文件和记忆都不包括在内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅限這則訊息。其他聊天、應用程式、檔案和記憶都不包含在內。"
          }
        }
      }
    },
