    "shared.matrix-runtime-copy.words.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the provider does not delete existing memories or restart a running conversation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更しても既存の記憶は削除されず、実行中の会話は再起動されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi nhà cung cấp không xóa bộ nhớ hiện có và không khởi động lại cuộc trò chuyện đang chạy."
          }
        },
        "zh": {
