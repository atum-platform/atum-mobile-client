    "src.matrix.mobile-copy.copy.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Atum chats on your phone, with the free Element X app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料アプリ Element X で、Atum のチャットをスマートフォンでも。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc trò chuyện Atum trên điện thoại, với ứng dụng miễn phí Element X."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "用免费的 Element X 应用，在手机上继续 Atum 聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用免費的 Element X 應用程式，在手機上繼續 Atum 聊天。"
