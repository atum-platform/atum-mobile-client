    "desktop.dm.connect.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum found a matching %1$@ account. Sign in to %1$@ once to confirm, and your earlier conversations come with you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致する %1$@ アカウントが見つかりました。%1$@ に一度サインインして確認すると、これまでの会話も引き継がれます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum tìm thấy một tài khoản %1$@ phù hợp. Đăng nhập %1$@ một lần để xác nhận, các cuộc trò chuyện trước đây của bạn sẽ theo bạn về đây."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 找到了匹配的 %1$@ 账户。登录一次 %1$@ 进行确认，你之前的对话就会一并带过来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 找到相符的 %1$@ 帳號。登入 %1$@ 一次以確認，先前的對話就會一起帶過來。"
          }
        }
      }
    },
