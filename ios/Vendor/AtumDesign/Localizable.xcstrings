    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.andy_group_declined": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy only chats one-on-one for now. You can message Andy here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Andyは1対1のチャットのみ対応しています。ここでAndyにメッセージできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy chỉ trò chuyện riêng nên chưa thể vào nhóm. Bạn cứ nhắn cho Andy ở đây nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 目前仅支持一对一聊天。您可以在这里私信 Andy。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 目前只支援一對一聊天。您可以在這裡私訊 Andy。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.andy_leaving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy only chats one-on-one, so Andy is leaving this chat. You can message Andy privately anytime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Andyは1対1のチャットのみ対応しているため、このチャットを退出します。いつでもAndyに個別でメッセージできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy chỉ trò chuyện riêng nên sẽ rời cuộc trò chuyện này. Bạn có thể nhắn riêng cho Andy bất cứ lúc nào."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 仅支持一对一聊天，因此将离开这个聊天。你可以随时私信 Andy。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Andy 只支援一對一聊天，因此將離開這個聊天。你可以隨時私訊 Andy。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.app_timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ took longer than usual, so the answer could not be posted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の回答に時間がかかり、グループに投稿できませんでした。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ trả lời lâu hơn bình thường nên chưa gửi được câu trả lời. Nếu lượt nhắn đã bị trừ mà không có câu trả lời, hãy liên hệ support@atumplatform.com."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 回复时间过长，无法发布到群组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 回覆時間過長，無法發佈到群組。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.app_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is temporarily unavailable. Please try again in a few minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は一時的に利用できません。数分後にもう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang tạm gián đoạn. Bạn thử lại sau ít phút nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 暂时不可用。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 暫時無法使用。請稍後再試。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is still answering your previous message. Please send again in a few seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は前のメッセージに回答中です。少し待ってからもう一度送信してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vẫn đang trả lời tin trước của bạn. Bạn gửi lại sau ít giây nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 仍在回复你之前的消息。请稍后再发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 仍在回覆你之前的訊息。請稍後再傳送。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.cannot_read": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ couldn’t read this message. Please update Atum and send it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はこのメッセージを読めませんでした。Atumを更新してもう一度送信してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chưa đọc được tin nhắn này. Bạn cập nhật Atum rồi gửi lại nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 无法读取这条消息。请更新 Atum 后再发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 無法讀取這則訊息。請更新 Atum 後再傳送。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.joined": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is here. Mention @%1$@ or reply to %1$@ to ask. %1$@ uses only that message and one message you choose to quote; each question counts against the asker’s own %1$@ messages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が参加しました。@%1$@へのメンションまたは%1$@への返信で質問できます。%1$@ はそのメッセージと、あなたが選んだ引用1件だけを使います。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã vào nhóm. Nhắc @%1$@ hoặc trả lời tin của %1$@ để hỏi. %1$@ chỉ dùng tin nhắn đó và một tin bạn chọn trích dẫn; mỗi câu hỏi tính vào lượt %1$@ của chính người hỏi."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已加入群组。提及 @%1$@ 或回复 %1$@ 即可提问。%1$@ 只使用该消息和您选择引用的一条消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已加入群組。提及 @%1$@ 或回覆 %1$@ 即可提問。%1$@ 只使用該訊息和您選擇引用的一則訊息。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.link_pending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is finishing your account connection. Please send again in a minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はアカウント接続を完了しています。1分後にもう一度送信してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang hoàn tất kết nối tài khoản của bạn. Bạn gửi lại sau một phút nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 正在完成账户连接。请一分钟后再发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 正在完成帳戶連結。請一分鐘後再傳送。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.message_too_long": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That message is too long for %1$@. Please split it and send it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージは%1$@が読むには長すぎます。分けて送信してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn dài quá để %1$@ đọc. Bạn chia nhỏ rồi gửi lại nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这条消息太长，%1$@ 无法读取。请拆分后再发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這則訊息太長，%1$@ 無法讀取。請拆分後再傳送。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.missed_while_offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was away when you sent this. Please send it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はメッセージ送信時に不在でした。もう一度送信してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xin lỗi, %1$@ tạm vắng lúc bạn nhắn. Bạn gửi lại tin nhắn nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在你发送时离线。请再发送一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在你傳送時離線。請再傳送一次。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.needs_intake": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ needs your birth date, time and place first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が回答するには生年月日、時刻、出生地が必要です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cần ngày, giờ và nơi sinh của bạn trước khi trả lời."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 需要你的出生日期、时间和地点才能回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 需要你的出生日期、時間和地點才能回答。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.needs_setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hasn’t answered because you haven’t started."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はまだ回答していません。始めてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chưa trả lời vì bạn chưa bắt đầu."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 尚未回答，因为你还没有开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 尚未回覆，因為你還沒有開始。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.now_group": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is now a group. Moon answers only when mentioned or replied to, and uses no one’s chart or memory here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットはグループになりました。MoonはメンションまたはMoonへの返信にだけ答え、ここでは誰のチャートや記憶も使いません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây giờ là nhóm. Moon chỉ trả lời khi được nhắc hoặc khi bạn trả lời tin của Moon, và không dùng lá số hay ký ức của ai ở đây."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这里现在是群组。Moon 只会在被提及或收到回复时回答，并且不会使用任何人的星盘或记忆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡現在是群組。Moon 只會在被提及或收到回覆時回答，並且不會使用任何人的星盤或記憶。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.outcome_unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ may have received this message, but its answer didn't make it back here. The message may have been counted, and Atum is checking. If no answer reaches you, email support@atumplatform.com."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ がこのメッセージを受け取った可能性がありますが、回答がここに届きませんでした。メッセージ数に数えられた可能性があり、Atum が確認しています。回答が届かない場合は support@atumplatform.com までご連絡ください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ có thể đã nhận tin này nhưng câu trả lời không về được đây. Lượt nhắn có thể đã được tính và Atum đang kiểm tra lại. Nếu bạn không nhận được câu trả lời, hãy báo support@atumplatform.com."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 可能已收到这条消息，但回答没有送达这里。这条消息可能已被计入，Atum 正在核查。若始终没有收到回答，请联系 support@atumplatform.com。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 可能已收到這則訊息，但回答沒有送達這裡。這則訊息可能已被計入，Atum 正在核查。若一直沒有收到回答，請聯絡 support@atumplatform.com。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.rate_limited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many messages just now. Please wait a few minutes and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信が速すぎます。数分待ってからもう一度送信してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang nhắn hơi nhanh. Bạn đợi vài phút rồi gửi lại nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你发送得太快了。请等待几分钟后再发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你傳送得太快了。請等待幾分鐘後再傳送。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.sent_before_link": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is now connected to your account. This message was sent before that, so please send it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は現在アカウントに接続されています。このメッセージは接続前に送られました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã kết nối với tài khoản của bạn. Tin này được gửi trước khi kết nối, bạn gửi lại nhé."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 现已连接到你的账户。这条消息在连接前发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 現已連結到你的帳戶。這則訊息在連結前傳送。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.mobileChatCopy.appBot.notice.unsupported_content": {
