            "value": "その端末に接続しています…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kết nối với máy đó…"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接那台设备…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在連線那台裝置…"
          }
        }
      }
    },
    "shared.matrix-approval-copy.copies.approved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is approved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を承認しました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
