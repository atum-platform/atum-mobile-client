        }
      }
    },
    "shared.matrix-action-copy.matrixActionCopy.actionPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reply is saved but not posted yet. Choose “Ask your assistant” to post it without running anything again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信は保存済みですが、まだ投稿されていません。「アシスタントに頼む」を選ぶと、再実行せずに投稿できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời đã được lưu nhưng chưa gửi. Chọn “Hỏi trợ lý” để gửi mà không chạy lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "回复已保存但尚未发布。选择“询问助手”即可发布，不会重复运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆已儲存但尚未發布。選擇「詢問助理」即可發布，不會重複執行。"
          }
        }
      }
    },
