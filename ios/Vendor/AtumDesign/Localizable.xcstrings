    "src.matrix.decryption-copy.copies.reasons.no_backup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent before this Mac joined, and there is no backup of it."
          }
        },
        "ja": {
