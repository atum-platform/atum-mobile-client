    "shared.matrix-pages-copy.updateCopy.allDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check and update installed skills for %1$@ on this Mac. Each previous version will be kept for rollback, and any incomplete updates will be reported. Changes apply to a new conversation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の %1$@ のインストール済みスキルを確認して更新します。各旧バージョンは復元用に保持され、完了しなかった更新は報告されます。変更は新しい会話から適用されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra và cập nhật các kỹ năng đã cài cho %1$@ trên máy Mac này. Mỗi phiên bản cũ được giữ để khôi phục; những cập nhật chưa hoàn tất sẽ được báo rõ. Thay đổi áp dụng cho cuộc trò chuyện mới."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "检查并更新此 Mac 上 %1$@ 已安装的技能。每个旧版本都将保留以便恢复，未完成的更新会明确报告。更改将在新对话中生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查並更新此 Mac 上 %1$@ 已安裝的技能。每個舊版本都會保留以便還原，未完成的更新會明確回報。變更會在新對話中生效。"
          }
        }
      }
    },
