    "desktop.atum.settings.advancedPage.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The main model applies to new chats with the current assistant. Other Atum features may still use Protons."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインモデルは現在のアシスタントとの新しいチャットに適用されます。他の Atum 機能は引き続き Proton を使う場合があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình chính áp dụng cho cuộc trò chuyện mới với trợ lý hiện tại. Các tính năng Atum khác vẫn có thể dùng Proton."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "主模型适用于与当前助手的新对话。其他 Atum 功能仍可能使用 Proton。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主要模型適用於與目前助手的新對話。其他 Atum 功能仍可能使用 Proton。"
          }
        }
      }
    },
