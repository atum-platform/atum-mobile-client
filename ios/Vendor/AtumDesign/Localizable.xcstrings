        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung sẽ xóa"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除的內容"
          }
        }
      }
    },
    "src.matrix.mobile-device-copy.mobileDeviceCopy.deletionRows1Detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required billing records: up to 10 years. Backups: up to 30 days. Error reports where user deletion is unavailable: up to 90 days. Copies others received, local Mac memory and credentials may remain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な請求記録：最大10年。バックアップ：最大30日。ユーザー単位の削除ができないエラー報告：最大90日。他者が受信したコピー、Mac上のメモリーや認証情報は残る場合があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ thanh toán bắt buộc: tối đa 10 năm. Bản sao lưu: tối đa 30 ngày. Báo cáo lỗi chưa thể xóa theo người dùng: tối đa 90 ngày. Bản sao người khác đã nhận, bộ nhớ và thông tin xác thực trên máy Mac có thể còn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "必需的账单记录：最长 10 年。备份：最长 30 天。无法按用户删除的错误报告：最长 90 天。他人已收到的副本、Mac 上的记忆和凭证可能保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "必需的帳單記錄：最長 10 年。備份：最長 30 天。無法按使用者刪除的錯誤報告：最長 90 天。他人已收到的副本、Mac 上的記憶和憑證可能保留。"
          }
        }
      }
    },
    "src.matrix.mobile-device-copy.mobileDeviceCopy.deletionRows1Label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retained"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持される項目"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung được giữ"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的內容"
          }
        }
      }
    },
    "src.matrix.mobile-device-copy.mobileDeviceCopy.deletionRows2Detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unused balance is removed. The server shows whether the fourteen-day refund conditions apply and links to the refund request before deletion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未使用の残高は削除されます。14日間の返金条件が適用されるかはサーバーに表示され、削除前に返金要求へのリンクがあります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư chưa dùng sẽ bị xóa. Máy chủ cho biết điều kiện hoàn tiền trong mười bốn ngày có áp dụng không và cung cấp liên kết yêu cầu hoàn tiền trước khi xóa."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "未使用的余额将被移除。服务器会显示十四天退款条件是否适用，并在删除前提供退款请求链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未使用的餘額將被移除。伺服器會顯示十四天退款條件是否適用，並在刪除前提供退款要求連結。"
          }
        }
      }
    },
    "src.matrix.mobile-device-copy.mobileDeviceCopy.deletionRows2Label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protons and purchases"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Protonと購入"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Proton và giao dịch mua"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Proton 与购买"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Proton 與購買"
          }
        }
      }
    },
    "src.matrix.mobile-device-copy.mobileDeviceCopy.deletionStatesBlockedOwnerText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer company ownership before deleting your account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを削除する前に会社の所有権を移転してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển quyền sở hữu công ty trước khi xóa tài khoản."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "删除帐户前，请先移交公司所有权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除帳戶前，請先移交公司擁有權。"
          }
        }
      }
    },
    "src.matrix.mobile-device-copy.mobileDeviceCopy.deletionStatesBlockedPayoutText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A payout must finish before deletion can proceed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を進める前に支払いを完了させる必要があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoản chi trả cần hoàn tất trước khi tiếp tục xóa."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "需等待支出完成后才能继续删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需等待款項完成後才能繼續刪除。"
          }
        }
      }
    },
    "src.matrix.mobile-device-copy.mobileDeviceCopy.deletionStatesReconciliationText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A purchase is still being reconciled. Try again after it completes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を照合中です。完了後に再試行してください。"
