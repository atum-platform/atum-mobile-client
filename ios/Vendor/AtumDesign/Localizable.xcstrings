    "shared.matrix-curator-copy.matrixCuratorCopy.resumeDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume automatic skill maintenance for this agent, subject to its configuration. It may archive skills and use the auxiliary model when consolidation is enabled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定に従ってこのアシスタントの自動保守を再開します。スキルのアーカイブや、統合が有効な場合の補助モデル利用が発生する可能性があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục bảo trì kỹ năng tự động cho trợ lý này theo cấu hình. Có thể lưu trữ kỹ năng và dùng mô hình phụ nếu bật hợp nhất."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "按配置恢复此助理的自动技能维护。可能归档技能；启用合并时可能使用辅助模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依設定恢復此助理的自動技能維護。可能封存技能；啟用合併時可能使用輔助模型。"
          }
        }
      }
    },
