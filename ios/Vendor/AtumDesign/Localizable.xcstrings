    "src.matrix.security-copy.copies.showKeyLead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum keeps your key on this Mac, so signing in again here unlocks by itself. Show it to set up another device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum はこの Mac にキーを保管しているので、ここで再度ログインすると自動でロックが解除されます。別の端末を設定するときに表示してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum giữ khóa của bạn trên Mac này, nên đăng nhập lại ở đây sẽ tự mở khóa. Hiện khóa khi bạn cần thiết lập thiết bị khác."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 把你的密钥保存在这台 Mac 上，所以在这里重新登录会自动解锁。设置其他设备时可以显示它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 把你的金鑰保存在這台 Mac 上，所以在這裡重新登入會自動解鎖。設定其他裝置時可以顯示它。"
          }
        }
      }
    },
