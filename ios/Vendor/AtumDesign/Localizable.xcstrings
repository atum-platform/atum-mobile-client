    "src.matrix.security-copy.copies.manageHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing a device out stops it reading new messages. You confirm on a page that opens in your browser; if you can’t get in, contact support@atumplatform.com."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末をログアウトすると、その端末は新しいメッセージを読めなくなります。確認はブラウザで開くページで行います。ページに入れない場合は、support@atumplatform.com までご連絡ください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng xuất một thiết bị sẽ ngăn thiết bị đó đọc tin nhắn mới. Bạn xác nhận trên một trang mở trong trình duyệt; nếu không vào được, hãy liên hệ support@atumplatform.com."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "退出某台设备后，它将无法读取新消息。你需要在浏览器中打开的页面上确认；如果进不去，请联系 support@atumplatform.com。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出某台裝置後，它將無法讀取新訊息。你需要在瀏覽器中開啟的頁面上確認；如果進不去，請聯絡 support@atumplatform.com。"
          }
        }
      }
    },
