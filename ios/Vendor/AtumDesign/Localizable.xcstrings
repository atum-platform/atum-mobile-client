        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存が完了しませんでした。保存済みの内容は残ります。内容を確認して、もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa lưu xong. Những gì đã lưu vẫn được giữ. Kiểm tra thông tin rồi thử lại."
          }
        },
        "zh": {
