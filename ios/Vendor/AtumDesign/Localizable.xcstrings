    "desktop.dm.group.advisory.ownerBoundary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This private conversation stays with you. Retire it to end the meeting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この非公開の会話はあなた専用です。終了するにはルームを閉じてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện riêng này luôn thuộc về bạn. Đóng nhóm để kết thúc."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此私人对话始终属于你。关闭群组即可结束会议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此私人對話始終屬於你。關閉群組即可結束會議。"
          }
        }
      }
    },
    "desktop.dm.group.advisory.roundDisclosure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each app or agent replies once, in order. Mention one to speak only to them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各アドバイザーが順番に1回回答します。1人だけに話すにはメンションしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi ứng dụng hoặc trợ lý trả lời một lượt theo thứ tự. Nhắc tên để chỉ trò chuyện với một thành viên."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每位顾问按顺序回复一次。提及一位顾问可只与其交谈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每位顧問按順序回覆一次。提及一位顧問可只與其交談。"
          }
        }
      }
    },
