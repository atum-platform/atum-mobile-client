    "src.matrix.account-step-copy.copies.setUpHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll need it to read your messages on another Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の Mac でメッセージを読むときに必要です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ cần khóa này để đọc tin nhắn trên một máy Mac khác."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一台 Mac 上阅读消息时需要它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一台 Mac 上閱讀訊息時需要它。"
          }
        }
      }
    },
    "src.matrix.account-step-copy.copies.setUpTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your recovery key"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧キーを保存"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu khóa khôi phục"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "保存恢复密钥"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存復原金鑰"
          }
        }
      }
    },
    "src.matrix.account-step-copy.copies.unlockHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve this Mac from your other device, or enter your recovery key. On a Mac that has it: Settings › Privacy & Security."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの端末からこの Mac を承認するか、復旧キーを入力してください。キーのある Mac では「設定 › プライバシーとセキュリティ」にあります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép Mac này từ máy khác của bạn, hoặc nhập khóa khôi phục. Trên máy Mac đang có khóa: Cài đặt › Quyền riêng tư & Bảo mật."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的另一台设备批准这台 Mac，或输入恢复密钥。在有密钥的 Mac 上：设置 › 隐私与安全性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從你的另一台裝置核准這台 Mac，或輸入復原金鑰。在有金鑰的 Mac 上：設定 › 隱私權與安全性。"
          }
        }
      }
    },
    "src.matrix.account-step-copy.copies.unlockTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your messages on this Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac でメッセージのロックを解除"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
