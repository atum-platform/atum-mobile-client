    "shared.matrix-command-center-ops-copy.matrixMaintenanceCopy.backupHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save only this agent’s profile on this Mac, including conversations and credentials. Other profiles and external provider storage are excluded. The archive stays local; nothing is uploaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話と認証情報を含む、このアシスタントのプロファイルだけをこのMacに保存します。他のプロファイルや外部プロバイダーのストレージは含みません。ローカル保存のみで、アップロードしません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lưu hồ sơ của trợ lý này trên máy Mac, gồm hội thoại và thông tin đăng nhập. Không gồm hồ sơ khác hay dữ liệu bên ngoài của nhà cung cấp. Bản sao lưu ở cục bộ; không tải lên."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在此 Mac 上保存此助手的配置目录，包括对话和凭据。不包含其他配置目录或外部服务商存储。备份保留在本地，不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在此 Mac 上儲存此助理的設定目錄，包括對話和憑證。不包含其他設定目錄或外部服務商儲存。備份保留在本機，不會上傳。"
          }
        }
      }
    },
