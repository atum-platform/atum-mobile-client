    "src.matrix.security-copy.copies.writeDownLead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum keeps your key on this Mac, even after you sign out. Write it down or save it in a password manager: you’ll need it on another device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum はログアウト後もこの Mac にキーを保管します。書き留めるか、パスワード管理アプリに保存してください。別の端末で必要になります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum giữ khóa của bạn trên Mac này, kể cả sau khi bạn đăng xuất. Hãy ghi lại hoặc lưu vào trình quản lý mật khẩu: bạn sẽ cần khóa trên thiết bị khác."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 会把你的密钥保存在这台 Mac 上，即使退出登录也一样。请把它记下来或存入密码管理器：在其他设备上需要它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 會把你的金鑰保存在這台 Mac 上，即使登出也一樣。請把它記下來或存入密碼管理工具：在其他裝置上需要它。"
          }
        }
      }
    },
