    "src.matrix.launch-copy.copies.diskFullHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac’s disk is full. Free up some space and Atum reconnects on its own."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac のディスクがいっぱいです。空き容量を増やすと、Atum が自動で再接続します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ổ đĩa của máy Mac này đã đầy. Hãy giải phóng bớt dung lượng, Atum sẽ tự kết nối lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 的磁盘已满。请释放一些空间，Atum 会自动重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 的磁碟已滿。請釋出一些空間，Atum 會自動重新連線。"
          }
        }
