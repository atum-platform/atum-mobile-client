    "src.matrix.launch-copy.copies.engineHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re still signed in on this Mac. Try again — if it keeps happening, send us feedback."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac ではログインしたままです。もう一度お試しください。繰り返し起きる場合はフィードバックをお送りください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản vẫn đăng nhập trên máy Mac này. Bấm Thử lại; nếu vẫn chưa được, hãy gửi phản hồi cho Atum."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你在这台 Mac 上仍处于登录状态。请重试；如果反复出现，请向我们发送反馈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在這台 Mac 上仍處於登入狀態。請再試一次；如果反覆發生，請傳送意見回饋給我們。"
          }
        }
      }
    },
