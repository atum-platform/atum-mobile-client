          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa hỗ trợ tạo tài khoản bằng email. Tạm thời bạn hãy tiếp tục với Google để tạo tài khoản."
          }
        },
        "zh": {
          "stringUnit": {
