    "src.matrix.copy.copies.deviceHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare fingerprints with the other device before verifying. This grants encrypted key sharing, not permission to run tools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証前に他の端末とフィンガープリントを照合してください。暗号鍵の共有を許可しますが、ツール実行権限は付与しません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "So sánh dấu vân tay với thiết bị kia trước khi xác minh. Thao tác này cho phép chia sẻ khóa mã hóa, không cấp quyền chạy công cụ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "验证前请与另一台设备比对指纹。这会允许共享加密密钥，但不授权执行工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證前請與另一台裝置比對指紋。這會允許共用加密金鑰，但不授權執行工具。"
          }
        }
      }
    },
