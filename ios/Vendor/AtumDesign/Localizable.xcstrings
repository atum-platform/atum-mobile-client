    "desktop.atum.permissions.files.denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to the %1$@ folder. You can grant it in System Settings → Privacy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ フォルダにアクセスできません。システム設定 → プライバシーで許可できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có quyền mở thư mục %1$@. Bạn có thể cấp quyền trong Cài đặt hệ thống → Quyền riêng tư."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无权打开“%1$@”文件夹。你可以在系统设置 → 隐私中授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取「%1$@」資料夾。你可以在系統設定 → 隱私權中授權。"
          }
        }
      }
    },
