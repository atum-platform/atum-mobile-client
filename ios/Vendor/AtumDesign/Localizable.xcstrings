    "src.matrix.execution-policy-editor-copy.words.allDisabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This assistant will pause until you turn a location back on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いずれかの場所をオンに戻すまで、このアシスタントは一時停止します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý này sẽ tạm dừng cho đến khi bạn bật lại một nơi."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此助手会暂停，直到你重新开启一个位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此助理會暫停，直到你重新開啟一個位置。"
          }
        }
      }
    },
    "src.matrix.execution-policy-editor-copy.words.cacheUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not refresh these choices. Reload to try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この選択を更新できませんでした。再読み込みしてもう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cập nhật được lựa chọn này. Hãy tải lại để thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法刷新这些选择。请重新加载后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重新整理這些選擇。請重新載入後再試一次。"
          }
        }
      }
    },
    "src.matrix.execution-policy-editor-copy.words.failure.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum could not save these choices. Check them and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この選択を保存できませんでした。内容を確認して、もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum chưa lưu được lựa chọn này. Hãy kiểm tra rồi thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 无法保存这些选择。请检查后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 無法儲存這些選擇。請檢查後再試一次。"
          }
        }
      }
    },
    "src.matrix.execution-policy-editor-copy.words.failure.invalid_response": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum returned an invalid policy. Your choices are still here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum から無効なポリシーが返されました。選択内容は保持されています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum trả về chính sách không hợp lệ. Lựa chọn vẫn còn ở đây."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 返回了无效策略。你的选择仍保留在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 傳回了無效政策。你的選擇仍保留在這裡。"
          }
        }
      }
    },
    "src.matrix.execution-policy-editor-copy.words.failure.inventory_changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The available locations changed. Reload before editing again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用できる場所が変わりました。編集を続ける前に再読み込みしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách nơi chạy đã thay đổi. Hãy tải lại trước khi sửa tiếp."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "可用位置已发生变化。请重新加载后再编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用位置已變更。請重新載入後再編輯。"
          }
        }
      }
    },
    "src.matrix.execution-policy-editor-copy.words.failure.request_conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This save could not be replayed safely. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保存を安全に再実行できませんでした。もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lặp lại lần lưu này một cách an toàn. Hãy thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全地重放此次保存。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全地重播此次儲存。請再試一次。"
          }
