        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "描述一只宠物，看它孵化"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "描述一隻寵物，看牠孵化"
          }
        }
      }
    },
