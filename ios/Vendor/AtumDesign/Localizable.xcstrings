        }
      }
    },
    "src.matrix.decryption-copy.copies.reasons.restore_possible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent before this Mac joined. Restore your messages to read it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacが参加する前に送信されました。メッセージを復元すると読めます。"
