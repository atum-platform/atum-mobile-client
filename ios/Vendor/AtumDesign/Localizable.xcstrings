          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trợ lý đã ngừng chờ câu trả lời này. Hãy xem câu trả lời của trợ lý trước khi hỏi lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "助手已停止等待此回答。再次提问前请先查看它的回复。"
