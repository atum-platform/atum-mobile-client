    "shared.matrix-curator-copy.matrixCuratorCopy.pauseDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause future automatic skill maintenance for this agent. A run already in progress continues."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアシスタントの今後の自動保守を一時停止します。実行中の処理は続きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng các lần bảo trì kỹ năng tự động tiếp theo của trợ lý này. Lần chạy đang diễn ra vẫn tiếp tục."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停此助理今后的自动技能维护。正在运行的任务将继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停此助理今後的自動技能維護。正在執行的工作將繼續。"
          }
        }
      }
    },
    "shared.matrix-curator-copy.matrixCuratorCopy.paused": {
