    "src.matrix.security-copy.copies.agentRecoveryHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up a recovery key if this is your first Mac, or use yours to unlock this one. This Mac keeps it in protected storage, even after you sign out, until you choose Forget the key on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の Mac なら復旧キーを設定し、そうでなければお持ちのキーでこの Mac のロックを解除してください。キーはログアウト後も、「この Mac のキーを削除する」を選ぶまで、この Mac の保護されたストレージに保管されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo khóa khôi phục nếu đây là máy Mac đầu tiên của bạn, hoặc dùng khóa của bạn để mở khóa máy này. Mac này giữ khóa trong vùng lưu trữ được bảo vệ, kể cả sau khi bạn đăng xuất, cho đến khi bạn chọn Quên khóa trên Mac này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "如果这是你的第一台 Mac，请设置恢复密钥；否则请用你的密钥解锁这台 Mac。即使退出登录，这台 Mac 也会把它保存在受保护的存储中，直到你选择“在这台 Mac 上删除密钥”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果這是你的第一台 Mac，請設定復原金鑰；否則請用你的金鑰解鎖這台 Mac。即使登出，這台 Mac 也會把它保存在受保護的儲存空間中，直到你選擇「在這台 Mac 上刪除金鑰」。"
          }
        }
      }
    },
    "src.matrix.security-copy.copies.agentRecoveryTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your assistant on this Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac でアシスタントのロックを解除"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
