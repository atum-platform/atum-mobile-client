    "desktop.atum.workspace.wordDocumentUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum can’t access this document. Choose it again from Files."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書にアクセスできません。「ファイル」からもう一度選択してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum không thể truy cập tài liệu này. Hãy chọn lại tài liệu trong Tệp."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 无法访问此文档。请在“文件”中重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 無法存取此文件。請在「檔案」中重新選取。"
          }
        }
      }
    },
    "desktop.atum.workspace.wordExit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exit side by side"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並列表示を終了"
          }
        },
        "vi": {
          "stringUnit": {
