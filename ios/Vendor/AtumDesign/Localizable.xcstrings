    "shared.matrix-debug-share-copy.matrixDebugShareCopy.privacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with the link can read what you share, so check it for personal details first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを知っている人は誰でも共有内容を読めます。先に個人情報が含まれていないか確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai có liên kết cũng đọc được nội dung bạn chia sẻ, vì vậy hãy kiểm tra thông tin cá nhân trước."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拿到链接的人都能看到你分享的内容，请先检查其中是否有个人信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拿到連結的人都能看到你分享的內容，請先檢查其中是否有個人資訊。"
          }
        }
      }
    },
    "shared.matrix-debug-share-copy.matrixDebugShareCopy.report": {
