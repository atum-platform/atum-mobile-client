    "shared.matrix-management-copy.copy.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools you connect can run commands and use the internet. Changes apply to new chats with this agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続したツールはコマンドを実行したりインターネットを使ったりできます。変更はこのエージェントとの新しいチャットに適用されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ bạn kết nối có thể chạy lệnh và dùng Internet. Thay đổi áp dụng cho các cuộc trò chuyện mới với trợ lý này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你连接的工具可以运行命令并访问互联网。更改会应用于与此智能体的新聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你連接的工具可以執行命令並存取網際網路。變更會套用至與此智慧代理的新聊天。"
          }
        }
      }
    },
    "shared.matrix-management-copy.copy.planRisk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI has not approved this Atum plan sign-in. Your account may be limited. Continue only if you accept that risk. Policy: %1$@. Account acknowledgment: %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI は Atum でのこのプラン認証を承認していません。アカウントが制限される可能性があります。このリスクに同意する場合のみ続行してください。ポリシー: %1$@。アカウントの同意日: %2$@。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI chưa phê duyệt cách đăng nhập gói này trong Atum. Tài khoản của bạn có thể bị giới hạn. Chỉ tiếp tục nếu bạn chấp nhận rủi ro đó. Chính sách: %1$@. Ngày tài khoản xác nhận: %2$@."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 尚未批准 Atum 的此订阅登录方式。你的账户可能受限。仅在接受此风险时继续。政策：%1$@。账户确认日期：%2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 尚未核准 Atum 的此訂閱登入方式。你的帳戶可能受限。僅在接受此風險時繼續。政策：%1$@。帳戶確認日期：%2$@。"
          }
        }
      }
    },
    "shared.matrix-management-copy.copy.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change this agent on this Mac?"
          }
        },
