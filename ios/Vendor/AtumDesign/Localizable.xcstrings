    },
    "src.matrix.mobile-copy.copy.qrHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The QR only downloads the app. It never signs you in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この QR はアプリのダウンロード専用です。ログインは行いません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "QR chỉ để tải ứng dụng. QR không bao giờ đăng nhập giúp bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "二维码只用于下载应用，绝不会替你登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 碼只用於下載應用程式，絕不會替你登入。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.copy.secureHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify the phone with this Mac or your recovery key. Don’t reset your recovery key to fix missing messages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac または復旧キーでスマートフォンを検証してください。メッセージが足りなくても、復旧キーはリセットしないでください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác minh điện thoại bằng máy Mac này hoặc bằng khóa khôi phục. Đừng đặt lại khóa khôi phục để sửa lỗi thiếu tin nhắn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "用这台 Mac 或恢复密钥验证手机。不要为了找回缺失的消息而重置恢复密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用這台 Mac 或復原金鑰驗證手機。不要為了找回缺失的訊息而重設復原金鑰。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.copy.serverMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build has not provided its account server. Update Atum before connecting your phone; do not guess it from your account name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドからサーバー情報が提供されていません。スマートフォンを接続する前に Atum を更新してください。アカウント名から推測しないでください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản này chưa cung cấp địa chỉ máy chủ tài khoản. Hãy cập nhật Atum trước khi kết nối điện thoại; đừng đoán địa chỉ từ tên tài khoản."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未提供账号服务器地址。连接手机前请更新 Atum，不要从账号名称猜测地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未提供帳號伺服器位址。連接手機前請更新 Atum，不要從帳號名稱猜測位址。"
          }
        }
      }
    },
    "src.matrix.mobile-copy.copy.signInHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then sign in with the same Google account or email you use for Atum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのあと、Atum と同じ Google アカウントまたはメールでログインします。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau đó đăng nhập bằng đúng tài khoản Google hoặc email bạn dùng cho Atum."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "然后用你在 Atum 使用的同一个 Google 账号或邮箱登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "然後用你在 Atum 使用的同一個 Google 帳號或電子郵件登入。"
          }
        }
      }
    },
