    "desktop.atum.permissions.files.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will ask you once for the %1$@ folder. Atum only reads and writes the files you ask for, right here on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS が %1$@ フォルダへのアクセスを一度だけ確認します。Atum はあなたが頼んだファイルだけを、この Mac 上で読み書きします。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sẽ hỏi bạn một lần cho thư mục %1$@. Atum chỉ đọc và ghi những tệp bạn yêu cầu, ngay trên máy này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会就“%1$@”文件夹询问一次。Atum 只在这台 Mac 上读写你要求的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 會就「%1$@」資料夾詢問你一次。Atum 只會在這台 Mac 上讀寫你要求的檔案。"
          }
        }
      }
    },
