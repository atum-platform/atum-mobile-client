    "src.matrix.chat-copy.copies.companyFilePreparing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Company files are getting ready. Try again in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会社のファイルを準備しています。少し待ってからもう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp của công ty đang được chuẩn bị. Hãy thử lại sau giây lát."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "公司文件正在准备中。请稍后重试。"
          }
        },
