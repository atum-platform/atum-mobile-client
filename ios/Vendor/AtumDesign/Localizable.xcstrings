    "src.matrix.copy.copies.undecryptable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to decrypt. Verify this device or recover its keys."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復号できません。端末を検証するか鍵を復元してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không giải mã được. Hãy xác minh thiết bị hoặc khôi phục khóa."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解密。请验证此设备或恢复密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法解密。請驗證此裝置或還原金鑰。"
          }
        }
      }
    },
    "src.matrix.copy.copies.unencrypted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum only sends messages in encrypted chats. Start a new chat to keep talking."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atumは暗号化されたチャットでのみメッセージを送信します。続けるには新しいチャットを始めてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum chỉ gửi tin nhắn trong cuộc trò chuyện được mã hóa. Hãy bắt đầu cuộc trò chuyện mới để tiếp tục."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 只在加密对话中发送消息。请开始新的对话继续聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 只在加密對話中傳送訊息。請開始新的對話繼續聊天。"
          }
        }
      }
    },
