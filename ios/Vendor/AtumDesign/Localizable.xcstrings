    "src.matrix.security-copy.copies.compare": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare all seven emoji or all three numbers, in order, on both devices. Only confirm if the complete set matches exactly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "7 つの絵文字すべて、または 3 つの数字すべてを、両方の端末で順番どおりに比較してください。すべてが完全に一致する場合のみ確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "So sánh đủ bảy biểu tượng hoặc cả ba số, theo đúng thứ tự, trên hai thiết bị. Chỉ xác nhận khi toàn bộ khớp chính xác."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请在两台设备上按顺序比对全部七个表情或全部三个数字。只有完全一致时才确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在兩台裝置上依序比對全部七個表情符號或全部三個數字。只有完全一致時才確認。"
          }
        }
      }
    },
