    "src.matrix.roster-create-copy.copies.handleFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is ready, but its @name isn’t set yet. Try again, or choose one later on %1$@’s card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ の準備はできましたが、@名前 はまだ設定されていません。もう一度試すか、あとで %1$@ のカードで選んでください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đã sẵn sàng, nhưng chưa đặt được @tên. Hãy thử lại, hoặc chọn sau trên thẻ của %1$@."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已就绪，但还没有设置 @名称。请重试，或稍后在 %1$@ 的卡片上选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已就緒，但還沒有設定 @名稱。請再試一次，或稍後在 %1$@ 的卡片上選擇。"
          }
        }
      }
    },
