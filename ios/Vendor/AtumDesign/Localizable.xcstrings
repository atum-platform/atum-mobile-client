          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已經有一個叫 %1$@ 的助理。"
          }
        }
      }
    },
    "src.matrix.assistant-card.copy.assistantCardCopies.problems.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を付けてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đặt một cái tên."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请起个名字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請取個名字。"
          }
        }
      }
    },
    "src.matrix.assistant-card.copy.assistantCardCopies.problems.invalidChars": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” is from another alphabet. Names use Latin or Vietnamese letters, Chinese, Japanese, Korean, numbers, emoji and ' - . & ,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%2$@」は別の文字体系の文字です。名前に使えるのはラテン文字（ベトナム語を含む）、漢字、かな、ハングル、数字、絵文字と ' - . & , です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” thuộc bảng chữ khác. Tên dùng chữ Latinh hoặc tiếng Việt, chữ Trung, Nhật, Hàn, chữ số, emoji và ' - . & ,"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@”来自其他字母体系。名字可以用拉丁字母（含越南语）、汉字、日文假名、韩文、数字、表情符号和 ' - . & ,"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%2$@」來自其他字母系統。名字可以用拉丁字母（含越南語）、漢字、日文假名、韓文、數字、表情符號和 ' - . & ,"
          }
        }
      }
    },
    "src.matrix.assistant-card.copy.assistantCardCopies.problems.invalidChars.char=null": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This name has a hidden character, or one that can’t be used. Type it again."
          }
