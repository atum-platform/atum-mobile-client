    "shared.matrix-action-copy.matrixActionCopy.listening": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your assistant is ready for new messages"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
