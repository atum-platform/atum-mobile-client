    "src.matrix.mobile-copy.mobilePhoneCopy.notificationHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get notified when a reply arrives. Notifications show no sender or message content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信が届くと通知します。送信者やメッセージの内容は表示しません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận thông báo khi có câu trả lời. Thông báo không hiện người gửi hay nội dung tin nhắn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "收到回复时通知你。通知不显示发送者或消息内容。"
