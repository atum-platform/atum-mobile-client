    "src.matrix.hermes-setup-copy.hermesSetupCopy.paidItems": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills and assistants you bought from the Store work only with Atum’s AI. They stop working while your assistant uses your own model."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアで購入したスキルとアシスタントは Atum の AI でのみ動作します。アシスタントが自分のモデルを使っている間は動作しません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kỹ năng và trợ lý bạn mua ở Cửa hàng chỉ hoạt động với AI của Atum. Chúng sẽ ngừng hoạt động khi trợ lý dùng mô hình riêng của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你在商店购买的技能和助手只能配合 Atum 的 AI 使用。你的助手使用自己的模型时，它们将停止工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在商店購買的技能和助理只能搭配 Atum 的 AI 使用。你的助理使用自己的模型時，它們將停止運作。"
          }
        }
      }
    },
