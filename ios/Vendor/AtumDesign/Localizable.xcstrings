    "src.matrix.mobile-copy.mobileChatCopy.appBot.continueOnMac.setupBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start in your %1$@ chat on the computer; then chat here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンピューターの %1$@ チャットで始めてください。完了後はここで%1$@とチャットできます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở chat với %1$@ trên Atum cho máy tính để bắt đầu. Xong một lần, bạn nhắn với %1$@ ngay trên iPhone."
          }
        },
        "zh": {
