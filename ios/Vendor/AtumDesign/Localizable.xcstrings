          "stringUnit": {
            "state": "translated",
            "value": "無法連線至 Atum。你的選擇仍保留在這裡。"
          }
        }
      }
    },
    "src.matrix.execution-policy-editor-copy.words.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the preferred location first. Atum skips locations that are offline or cannot run this assistant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先する場所を先頭にします。オフライン、またはこのアシスタントを実行できない場所はスキップされます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt nơi ưu tiên lên đầu. Atum sẽ bỏ qua nơi ngoại tuyến hoặc không chạy được trợ lý này."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "将首选位置放在最前。Atum 会跳过离线或无法运行此助手的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將偏好位置放在最前。Atum 會略過離線或無法執行此助理的位置。"
          }
        }
      }
    },
