    "src.matrix.drive-copy.matrixDriveCopy.problem.engine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive couldn’t start on this Mac. Try again; if it keeps happening, update Atum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac で Drive を起動できませんでした。もう一度お試しください。続く場合は Atum をアップデートしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive chưa khởi động được trên máy Mac này. Hãy thử lại; nếu vẫn vậy, hãy cập nhật Atum."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive 无法在这台 Mac 上启动。请重试；如果仍然如此，请更新 Atum。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive 無法在這台 Mac 上啟動。請重試；如果仍然如此，請更新 Atum。"
          }
        }
      }
    },
    "src.matrix.drive-copy.matrixDriveCopy.problem.folder_home": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive can’t use that folder. Choose one inside your home folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダーは Drive に使えません。ホームフォルダー内のフォルダーを選んでください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
