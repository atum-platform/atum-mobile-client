    "src.matrix.launch-copy.copies.deviceDamagedHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again with this same account. Your assistants and other devices stay as they are."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今使っているアカウントで再度ログインしてください。アシスタントとほかのデバイスはそのままです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập lại bằng chính tài khoản này. Các trợ lý và thiết bị khác giữ nguyên."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用当前账号重新登录。你的助手和其他设备保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用目前的帳號重新登入。你的助理和其他裝置維持不變。"
          }
        }
      }
    },
