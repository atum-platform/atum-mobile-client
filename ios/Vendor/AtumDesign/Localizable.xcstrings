        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更換相片"
          }
        }
      }
    },
    "desktop.atum.account.consent.browser": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse and search the web"
          }
