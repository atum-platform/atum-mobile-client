    "src.matrix.mobile-copy.mobileChatCopy.appBot.onboarding.consent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will receive your name and the content you share in this conversation so it can answer you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は、あなたに回答するため、この会話で共有した名前と内容を受け取ります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sẽ nhận tên và nội dung bạn chia sẻ trong cuộc trò chuyện này để trả lời bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 会接收你的姓名和你在此对话中分享的内容，以便回复你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 會接收你的姓名和你在此對話中分享的內容，以便回覆你。"
          }
        }
      }
    },
