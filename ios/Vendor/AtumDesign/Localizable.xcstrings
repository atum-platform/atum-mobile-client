    "shared.matrix-action-copy.matrixActionCopy.promptDeadline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{seconds}s left to answer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答まで残り{seconds}秒です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn {seconds} giây để trả lời."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "还剩 {seconds} 秒可回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還剩 {seconds} 秒可回答。"
          }
