    "src.matrix.copy.copies.domainError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check your account. Check your connection and use the same account in your browser. If it still fails, sign out and sign in again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントを確認できませんでした。接続を確認し、ブラウザでも同じアカウントを使ってください。解決しない場合は、サインアウトしてからもう一度サインインしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa kiểm tra được tài khoản. Kiểm tra kết nối và dùng cùng tài khoản trong trình duyệt. Nếu vẫn lỗi, hãy đăng xuất rồi đăng nhập lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查你的账户。请检查连接，并在浏览器中使用同一账户。如果仍然失败，请退出登录后重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查你的帳號。請檢查連線，並在瀏覽器中使用同一帳號。如果仍然失敗，請登出後重新登入。"
          }
        }
      }
    },
    "src.matrix.copy.copies.domainHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your assistant stops answering, these checks can help. Your browser may open to confirm it’s you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントが応答しなくなったときは、これらの確認が役立ちます。本人確認のためにブラウザが開くことがあります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu trợ lý ngừng trả lời, các bước kiểm tra này có thể giúp. Trình duyệt có thể mở để xác nhận đó là bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "如果助手不再回答，这些检查可能有帮助。浏览器可能会打开以确认是你本人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果助理不再回答，這些檢查可能有幫助。瀏覽器可能會開啟以確認是你本人。"
          }
        }
      }
    },
    "src.matrix.copy.copies.domainPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking… continue in your browser if asked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認しています… 求められたらブラウザで続けてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kiểm tra… tiếp tục trong trình duyệt nếu được hỏi."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查… 如有提示，请在浏览器中继续。"
          }
        },
