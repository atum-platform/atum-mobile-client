      }
    },
    "src.matrix.execution-policy-editor-copy.words.failure.revision_conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These choices changed elsewhere. Reload before editing again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の場所で選択が変更されました。編集を続ける前に再読み込みしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn đã thay đổi ở nơi khác. Hãy tải lại trước khi sửa tiếp."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这些选择已在其他位置更改。请重新加载后再编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些選擇已在其他位置變更。請重新載入後再編輯。"
          }
        }
      }
    },
    "src.matrix.execution-policy-editor-copy.words.failure.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach Atum. Your choices are still here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum に接続できませんでした。選択内容は保持されています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa kết nối được với Atum. Lựa chọn vẫn còn ở đây."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Atum。你的选择仍保留在这里。"
          }
