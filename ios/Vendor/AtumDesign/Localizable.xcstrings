    "src.matrix.mobile-device-copy.mobileDeviceCopy.deletionRows0Detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account, encrypted server history, cloud workspace and enrolment. Deletion completes within 30 days."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント、サーバー上の暗号化履歴、クラウドワークスペース、登録。削除は30日以内に完了します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản, lịch sử mã hóa trên máy chủ, không gian đám mây và đăng ký. Hoàn tất xóa trong 30 ngày."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "帐户、服务器上的加密历史、云端工作区和注册。删除将在 30 天内完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帳戶、伺服器上的加密歷史、雲端工作區和註冊。刪除將在 30 天內完成。"
          }
        }
      }
    },
