{
  "sourceLanguage": "vi",
  "strings": {
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum uses Face ID so only you can approve what your assistants ask to do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントが求める操作をあなただけが許可できるよう、Atum は Face ID を使用します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum dùng Face ID để chỉ bạn mới có thể cho phép những việc trợ lý xin làm."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 使用面容 ID，确保只有你能批准助手请求执行的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 使用 Face ID，確保只有你能核准助理請求執行的操作。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum uses the microphone to turn your speech into text when you tap the mic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum は、マイクボタンをタップしたときに、音声をテキストに変換するためにマイクを使用します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum dùng micrô để chuyển giọng nói của bạn thành chữ khi bạn bấm nút micrô."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "当你点按麦克风按钮时，Atum 会使用麦克风将你的语音转换为文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你點按麥克風按鈕時，Atum 會使用麥克風將你的語音轉換為文字。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum saves the photos you choose to your library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum は選択した写真を写真ライブラリに保存します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum lưu ảnh bạn chọn vào Thư viện ảnh."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 会将你选择的照片保存到照片图库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 會將你選擇的照片儲存到照片圖庫。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum uses speech recognition to turn what you say into text in the message box."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum は、話した内容をメッセージ欄のテキストに変換するために音声認識を使用します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum dùng nhận dạng giọng nói để chuyển lời bạn nói thành chữ trong khung soạn tin."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 会使用语音识别将你说的话转换为消息框中的文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Atum 會使用語音辨識將你說的話轉換為訊息框中的文字。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
