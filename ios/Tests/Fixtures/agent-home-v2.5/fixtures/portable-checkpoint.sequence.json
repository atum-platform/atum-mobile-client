{
  "steps": [
    {
      "from": "dirty",
      "to": "quiescing",
      "event": "capture"
    },
    {
      "from": "quiescing",
      "to": "staging",
      "event": "writers_quiesced"
    },
    {
      "from": "staging",
      "to": "uploading",
      "event": "stable_files_staged"
    },
    {
      "from": "uploading",
      "to": "verifying",
      "event": "upload_finished"
    },
    {
      "from": "verifying",
      "to": "committing",
      "event": "upload_verified"
    },
    {
      "from": "committing",
      "to": "committed",
      "event": "epoch_cas"
    }
  ]
}
