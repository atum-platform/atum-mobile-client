{
  "steps": [
    {
      "from": "idle",
      "to": "requested",
      "event": "sleep_request"
    },
    {
      "from": "requested",
      "to": "draining",
      "event": "best_effort_drain"
    },
    {
      "from": "draining",
      "to": "ready_to_commit",
      "event": "source_unreachable"
    }
  ]
}
