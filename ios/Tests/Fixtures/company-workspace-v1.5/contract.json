  "types": {
    "uuid": {
      "type": "string",
      "min": 36,
      "max": 36,
      "pattern": "[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}"
    },
    "member_ref": {
      "type": "string",
      "min": 43,
      "max": 43,
      "pattern": "[A-Za-z0-9_-]{43}"
    },
    "handle": {
      "type": "string",
      "min": 3,
      "max": 32,
      "pattern": "[a-z][a-z0-9_]{2,31}"
    },
    "text120": {
      "type": "string",
      "min": 1,
      "max": 120
    },
    "generation": {
      "type": "integer",
      "min": 1,
      "max": 9007199254740991
    },
    "digest": {
      "type": "string",
      "min": 64,
      "max": 64,
      "pattern": "[0-9a-f]{64}"
    },
    "kind": {
      "enum": [
        "dm",
        "group_dm"
      ]
    },
    "state": {
