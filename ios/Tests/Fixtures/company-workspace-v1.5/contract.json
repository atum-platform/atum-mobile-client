    "response_marker": {
      "field": "schemaVersion",
      "v1_5": 6,
      "scope": "new C3 messages only"
    },
    "old_clients": "no conversations; new room metadata must be quarantined, never Personal"
  },
  "identity": {
    "key": "company plus canonical sorted (memberRef, admissionEpoch) participant set",
    "dm": "exactly 2 humans",
    "group_dm": "3 to 9 humans",
    "cross_scope": "another company and Personal are always distinct",
    "expand": "opens another immutable participant-set conversation with no copied history or files",
    "digest": {
      "prefix": "atum.company-conversation-participant-set/1",
      "sort": "ascending UTF-8 bytes of memberRef",
      "encoding": "UTF-8, LF line endings, no BOM; prefix, companyId, kind and one member=<memberRef>:<base-10 admissionEpoch> line each, including final LF",
      "hash": "SHA-256 lowercase hexadecimal"
    }
  },
  "authority": {
    "effective": "active company membership at recorded epoch AND current conversation participation",
    "admin": "rank grants nothing",
    "manager": "hosted manager provisions every room",
    "classification": "company conversation target; never Personal or fake channel"
  },
  "replay": {
    "scope": "(actor, requestId)",
    "open": "atomic get-or-create by canonical participant epoch set",
    "changed_input": "409 no effect",
    "cross_actor": "409 no receipt disclosure"
  },
  "removal": {
    "commit": "platform authority ends immediately",
    "matrix": "joined, invited and uncertain effects require witnessed exclusion",
    "continuation": "at least 2 current participants may continue; otherwise read_only; read_only is terminal for that immutable participant set",
    "readmission": "new epoch restores no old conversation; there is no read_only to active transition"
  },
  "hidden": {
    "scope": "per user presentation only",
    "authority": "unchanged",
    "operations": [
      "hide",
      "unhide"
    ]
  },
  "compatibility": {
    "activation": "minimum safe desktop and phone classifier required",
    "rollback": "disable opens first; retain ACLs, bindings, effects, preferences and files; never recast Personal",
    "errors": "old wires receive plain matrix_404/409 only"
  },
  "errors": [
    "conversation_unavailable",
    "participant_unavailable",
    "participant_limit",
    "participant_set_conflict",
    "admission_epoch_conflict",
    "conversation_read_only"
  ],
  "invariants": [
    {
      "id": "conversation_open.dm_size",
      "message": "conversation-open.response",
      "op": "array_length",
      "left": "conversation.participants",
