  "row": "C3 company DMs and group DMs",
  "providers": [
    "Atum platform conversation authority"
  ],
  "consumers": [
    "hosted room manager",
    "desktop",
    "phone",
    "search and file providers"
  ],
  "base": {
    "contract": "atum.company-workspace/1.4",
    "path": "spec/company-workspace/v1.4",
    "kind": "pack",
    "sha256": "f6a0a2b912871a9acea15016d3d341d55350008e8e3d5dfd3a92dacb9a295f96",
    "rule": "additive minor; only C3 messages use schemaVersion 6"
  },
  "selection": {
    "header": "Atum-Company-Wire",
    "value": "1.5",
    "previous": [
      "1",
      "1.1",
      "1.2",
      "1.3",
      "1.4"
    ],
    "unchanged_schema_versions": {
      "1.1": 2,
