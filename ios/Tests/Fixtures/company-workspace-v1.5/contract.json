            },
            "roomId": {
              "const": null
            }
          }
        },
        {
          "type": "object",
          "required": {
            "state": {
              "const": "ready"
            },
            "roomId": {
              "type": "string",
              "min": 4,
              "max": 512,
              "pattern": "![!-9;-~]{1,255}:[!-~]{1,255}"
